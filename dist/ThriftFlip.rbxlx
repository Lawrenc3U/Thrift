        <Item class="ModuleScript" referent="RBX27">
          <Properties>
            <string name="Name">Audio</string>
            <ProtectedString name="Source">local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Assets = require(Shared.AssetConfig)
local Audio = {}
Audio.__index = Audio
function Audio.new()
    local self = setmetatable({Music = true, Effects = true, Tracks = {}, Last = {}, Zone = "shop"}, Audio)
    self.Group = Instance.new("SoundGroup"); self.Group.Name = "ThriftAudio"; self.Group.Parent = SoundService
    self.MusicGroup = Instance.new("SoundGroup"); self.MusicGroup.Name = "ThriftMusic"; self.MusicGroup.Parent = self.Group
    self.EffectsGroup = Instance.new("SoundGroup"); self.EffectsGroup.Name = "ThriftEffects"; self.EffectsGroup.Parent = self.Group
    for name, id in pairs(Assets.Audio) do
        if type(id) == "number" and id &gt; 0 then
            local music = name == "shop" or name == "town" or name == "auction_music"
            local sound = Instance.new("Sound"); sound.Name = name; sound.SoundId = "rbxassetid://" .. id
            sound.Looped = music; sound.Volume = if music then Assets.MusicVolume else Assets.EffectsVolume
            sound.SoundGroup = if music then self.MusicGroup else self.EffectsGroup
            sound.Parent = SoundService; self.Tracks[name] = sound
        end
    end
    self:setZone("shop")
    return self
end
function Audio:setEnabled(music, effects)
    self.Music = music ~= false; self.Effects = effects ~= false
    self.MusicGroup.Volume = if self.Music then 1 else 0
    self.EffectsGroup.Volume = if self.Effects then 1 else 0
end
function Audio:setZone(zone)
    if self.Zone == zone and self.Current then return end
    self.Zone = zone
    local nextTrack = self.Tracks[zone]
    if self.Current == nextTrack then return end
    local previous = self.Current
    if previous then
        TweenService:Create(previous, TweenInfo.new(1), {Volume = 0}):Play()
        task.delay(1.1, function() if self.Current ~= previous and previous.Parent then previous:Stop() end end)
    end
    self.Current = nextTrack
    if nextTrack then
        nextTrack.Volume = 0; nextTrack:Play()
        TweenService:Create(nextTrack, TweenInfo.new(1.2), {Volume = Assets.MusicVolume}):Play()
    end
end
function Audio:play(name)
    if not self.Effects then return end
    local sound = self.Tracks[name]
    if not sound then return end
    local now = os.clock()
    if now - (self.Last[name] or -10) &lt; 0.07 then return end
    self.Last[name] = now; sound:Play()
end
function Audio:destroy()
    for _, sound in pairs(self.Tracks) do sound:Destroy() end
    self.Group:Destroy()
end
return Audio
</ProtectedString>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="RBX28">
          <Properties>
            <string name="Name">Main</string>
            <ProtectedString name="Source">local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Catalog = require(Shared.Catalog)
local UI = require(script.Parent.UI)
local Pages = require(script.Parent.Pages)
local Audio = require(script.Parent.Audio)
local Minigames = require(script.Parent.Minigames)
local event = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Game")
local player = Players.LocalPlayer
local ui = UI.new()
local audio = Audio.new()
ui.playSound = function(_, name) audio:play(name) end
UI.OnClick = function() audio:play("click") end

local state, page, context, session
local pages
local marker = Instance.new("Part")
marker.Name = "LocalGuide"; marker.Size = Vector3.one; marker.Anchored = true
marker.CanCollide = false; marker.CanTouch = false; marker.CanQuery = false; marker.Transparency = 1; marker.Parent = workspace
local billboard = Instance.new("BillboardGui")
billboard.Name = "Guide"; billboard.Size = UDim2.fromOffset(230, 62); billboard.AlwaysOnTop = true; billboard.Parent = marker
local guideText = UI.label(billboard, "▼ YOUR NEXT STEP", 20, UI.Colors.Gold)
guideText.Size = UDim2.fromScale(1, 1); guideText.AutomaticSize = Enum.AutomaticSize.None; guideText.TextXAlignment = Enum.TextXAlignment.Center
local locations = {Source=Vector3.new(-82,8,-60),Estate=Vector3.new(68,8,-80),Delivery=Vector3.new(68,8,-35),
    Auction=Vector3.new(0,12,137),Market=Vector3.new(0,9,-90),Quests=Vector3.new(-26,8,-30),Workbench=Vector3.new(-40,8,-90)}
local guideExpires = 0
local function guide(location)
    local target = locations[location]
    if location == "Shop" then
        for _, shop in ipairs(state and state.Shops or {}) do
            if shop.UserId == player.UserId and shop.Plot then
                local left = shop.Plot &lt;= 4
                local row = if left then shop.Plot - 1 else shop.Plot - 5
                target = Vector3.new(if left then -37 else 37, 12, row * 34)
                break
            end
        end
    end
    if target then
        marker.Position = target; guideText.Text = "▼ " .. string.upper(location); billboard.Enabled = true
        guideExpires = if state and state.Tutorial &lt; 5 then math.huge else os.clock() + 30
    end
end

local function send(action, payload) event:FireServer(action, payload or {}) end
local function render()
    if not state or session then return end
    pages:setState(state); pages:render(page or "Town", context or {})
    ui:selectNav(page or "Town")
end
local function open(name, data)
    if session then ui:notice("Finish or cancel your restoration first."); return end
    page, context = name, data or {}; render()
end
pages = Pages.new(ui, send, open, guide)
for _, entry in ipairs({{"Town","⌂"},{"Bag","▣"},{"Shop","✦"},{"Find","⌕"},{"Quests","✓"}}) do
    ui:addNav(entry[1], entry[2], function() open(if entry[1] == "Find" then "Source" else entry[1]) end)
end
ui:addQuickAction("ϟ\nTravel", UI.Colors.Teal, function() open("Town") end)
ui:addQuickAction("▣\nRewards", UI.Colors.Rose, function() open("Quests") end)
ui:addQuickAction("◇\nStore", Color3.fromRGB(122, 92, 224), function() open("Boutique") end)

local tutorialHints = {
    [0]="Find your first treasure in Dumpster Alley", [1]="Open your bag and inspect the mystery find",
    [2]="Restore it at your shop workbench", [3]="Place it on one of your displays",
    [4]="Open Shop and welcome your first customer",
}
local function nextObjective()
    if tutorialHints[state.Tutorial] then return tutorialHints[state.Tutorial] end
    if state.Held then return "Show off your find, then return it to your bag" end
    local daily = state.Daily
    if daily and ((daily.Found or 0) &gt;= 3 and not daily.Claimed.Find
        or (daily.Restored or 0) &gt;= 3 and not daily.Claimed.Restore
        or (daily.Sold or 0) &gt;= 3 and not daily.Claimed.Sell) then
        return "A daily quest reward is ready to collect"
    end
    local nextTier = Config.Tiers[state.Tier + 1]
    if nextTier then
        if state.Level &lt; nextTier.Level then return "Reach LV " .. nextTier.Level .. " to unlock " .. nextTier.Name end
        if state.AvailableCash &lt; nextTier.Cost then return "Earn $" .. (nextTier.Cost - state.AvailableCash) .. " more for " .. nextTier.Name end
        return "Your " .. nextTier.Name .. " upgrade is ready"
    end
    local discoveries = 0; for _ in pairs(state.Collection or {}) do discoveries += 1 end
    return discoveries .. "/400 discoveries • hunt for a new " .. state.Demand .. " find"
end
local lastOffer, lastTutorial, adminButton
local function updateHud()
    ui.Balance.Text = tostring(math.floor(state.Cash))
    ui.Level.Text = "LV " .. state.Level
    local levelStart, levelEnd = 30 * (state.Level - 1) ^ 2, 30 * state.Level ^ 2
    ui.LevelProgress.Size = UDim2.fromScale(math.clamp((state.XP - levelStart) / math.max(1, levelEnd - levelStart), 0, 1), 1)
    ui.Hint.Text = nextObjective()
    ui:setSubtitle(if state.Ephemeral then "STUDIO PRACTICE • PROGRESS DOES NOT SAVE" else "YOUR COZY CORNER OF THRIFT STREET")
    ui.Effects = state.Settings.Effects
    audio:setEnabled(state.Settings.Music, state.Settings.Effects)
    audio:setZone(page == "Auction" and "auction_music" or page == "Town" and "town" or "shop")
end

event.OnClientEvent:Connect(function(kind, payload)
    if kind == "State" then
        local wasVisible = ui.Panel.Visible; local oldCash = state and state.Cash or payload.Cash
        state = payload; updateHud()
        if state.IsAdmin and not adminButton then
            adminButton = ui:addQuickAction("⚙\nAdmin", UI.Colors.Gold, function() open("Admin") end)
            ui.QuickActions.Size = UDim2.fromOffset(74, 288)
        end
        if state.Cash &gt; oldCash then ui:cashFeedback(state.Cash - oldCash); audio:play("sale") end
        if state.Tutorial ~= lastTutorial then
            lastTutorial = state.Tutorial
            if state.Tutorial == 0 then guide("Source")
            elseif state.Tutorial == 1 then billboard.Enabled = false; open("Bag")
            elseif state.Tutorial &gt;= 2 and state.Tutorial &lt;= 4 then guide("Shop")
            else billboard.Enabled = false end
        end
        if state.Offer and state.Offer.Uid ~= lastOffer then ui:notice(state.Offer.Customer .. " is browsing your shop!"); audio:play("reveal") end
        lastOffer = state.Offer and state.Offer.Uid or nil
        if wasVisible and not session then render() end
    elseif kind == "Notice" then ui:notice(payload)
    elseif kind == "Announcement" then ui:notice("📣  " .. tostring(payload)); audio:play("reward")
    elseif kind == "Reveal" then
        local item = payload and payload.Item
        local definition = item and Catalog.ById[item.DefId]
        if definition then
            audio:play(if item.Rarity &gt;= 4 then "reward" else "reveal")
            ui:rarityReveal(definition, item, function() open("Item", {Uid = item.Uid}) end)
        end
    elseif kind == "Open" then
        if payload.Page == "Visit" then open("Visit", {Owner=payload.Owner})
        elseif payload.Page == "Display" then open("Display", {Slot=payload.Slot})
        elseif payload.Page == "Market" then open("Market") else open(payload.Page) end
    elseif kind == "Minigame" then
        Minigames.stop(session); session = Minigames.start(ui, UI, payload, send, Config); audio:play("restore")
    elseif kind == "MinigameProgress" then Minigames.progress(session, payload, UI)
    elseif kind == "MinigameDone" then
        Minigames.stop(session); session = nil
        if payload.Cancelled then ui:notice("Restoration paused. Your find is safe.")
        else ui:notice(payload.Quality .. " restoration • now " .. payload.Condition); audio:play("reward") end
        page = "Bag"; render()
    end
end)
task.spawn(function() while not state do send("Sync", {}); task.wait(2) end end)
RunService.Heartbeat:Connect(function() if billboard.Enabled and os.clock() &gt; guideExpires then billboard.Enabled = false end end)
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX29">
          <Properties>
            <string name="Name">Minigames</string>
            <ProtectedString name="Source">local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local GuiService = game:GetService("GuiService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Minigames = {}
local descriptions = {
    Scrub = {Title = "A fresh start", Instruction = "Hold and sweep across the grime. Let the original finish shine through.", Tool = "SOFT BRUSH"},
    Polish = {Title = "Find the shine", Instruction = "Trace the numbered shine trail, starting at 1. Slow, smooth strokes work best.", Tool = "POLISHING CLOTH"},
    Rewire = {Title = "Bring it back to life", Instruction = "Join matching wire symbols. Drag between a pair, or tap each end.", Tool = "PRECISION PLIERS"},
    Repaint = {Title = "A new coat of character", Instruction = "Choose the requested paint, then brush across every section.", Tool = "DETAIL BRUSH"},
    Assemble = {Title = "Piece by lovely piece", Instruction = "Drag a piece to its matching outline, or select it and tap the outline.", Tool = "WORKSHOP KIT"},
}
local paintColors = {
    Color3.fromRGB(210, 141, 103), Color3.fromRGB(127, 174, 145), Color3.fromRGB(121, 158, 199),
    Color3.fromRGB(190, 157, 91), Color3.fromRGB(214, 151, 166),
}
local wireColors = {
    Color3.fromRGB(230, 141, 115), Color3.fromRGB(112, 186, 170), Color3.fromRGB(232, 190, 102),
    Color3.fromRGB(147, 164, 221), Color3.fromRGB(200, 153, 198), Color3.fromRGB(133, 191, 126),
    Color3.fromRGB(114, 183, 210), Color3.fromRGB(231, 169, 112),
}
local wireSymbols = {"●", "▲", "■", "◆", "★", "✚", "○", "☀"}
local pieceSymbols = {"◒", "▰", "◈", "◕"}

local function corner(object, amount)
    local value = Instance.new("UICorner")
    value.CornerRadius = UDim.new(0, amount)
    value.Parent = object
end
local function stroke(object, color, thickness, transparency)
    local value = Instance.new("UIStroke")
    value.Color = color
    value.Thickness = thickness or 1
    value.Transparency = transparency or 0
    value.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    value.Parent = object
    return value
end
local function text(parent, value, size, color)
    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Text = value
    label.Font = Enum.Font.GothamMedium
    label.TextSize = size
    label.TextColor3 = color
    label.TextWrapped = true
    label.Size = UDim2.fromScale(1, 1)
    label.Parent = parent
    return label
end
local function frame(parent, color, position, size, radius)
    local value = Instance.new("Frame")
    value.BackgroundColor3 = color
    value.BorderSizePixel = 0
    value.Position = position or UDim2.new()
    value.Size = size or UDim2.fromScale(1, 1)
    value.Parent = parent
    if radius then corner(value, radius) end
    return value
end
local function ease(object, duration, properties)
    if object and object.Parent then
        TweenService:Create(object, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), properties):Play()
    end
end
local function listen(session, signal, callback)
    local connection = signal:Connect(callback)
    table.insert(session.Connections, connection)
    return connection
end
local function isPointer(input)
    return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
end
local function isActivation(input)
    return not input or (input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch)
end
local function localPoint(session, screenPosition)
    local point = Vector2.new(screenPosition.X, screenPosition.Y)
    if not session.Ui.Gui.IgnoreGuiInset then
        local inset = GuiService:GetGuiInset()
        point -= inset
    end
    return point
end
local function inside(point, object)
    local p, s = object.AbsolutePosition, object.AbsoluteSize
    return point.X &gt;= p.X and point.X &lt;= p.X + s.X and point.Y &gt;= p.Y and point.Y &lt;= p.Y + s.Y
end
local function atCell(session, point)
    for index, button in ipairs(session.Buttons) do
        if button.Visible and inside(point, button) then return index end
    end
    return nil
end
local function sound(session, name)
    if session.Ui.playSound then session.Ui:playSound(name) end
end

local function preview(parent, challenge, config)
    local shared = ReplicatedStorage:FindFirstChild("Shared")
    local modelModule = shared and shared:FindFirstChild("ItemModels")
    local catalogModule = shared and shared:FindFirstChild("Catalog")
    local item = challenge.Item
    if not modelModule or not catalogModule or not item then return nil end
    local viewport = Instance.new("ViewportFrame")
    viewport.Name = "RestorationPreview"
    viewport.BackgroundTransparency = 1
    viewport.Size = UDim2.fromScale(1, 1)
    viewport.Ambient = Color3.fromRGB(197, 190, 170)
    viewport.LightColor = Color3.fromRGB(255, 244, 217)
    viewport.LightDirection = Vector3.new(-1, -1.5, -0.6)
    viewport.Parent = parent
    local world = Instance.new("WorldModel")
    world.Parent = viewport
    local camera = Instance.new("Camera")
    camera.FieldOfView = 34
    camera.Parent = viewport
    viewport.CurrentCamera = camera
    local ok = pcall(function()
        local catalog = require(catalogModule)
        local definition = catalog.ById[challenge.DefId or item.DefId]
        if not definition then error("Missing item definition") end
        local model = require(modelModule).create(world, definition, item, CFrame.new(), config)
        local cf, size = model:GetBoundingBox()
        local extent = math.max(size.X, size.Y, size.Z, 1)
        local center = cf.Position
        -- Authored item fronts face -Z, so restoration should show the controls,
        -- clock faces and camera lenses rather than their backs.
        camera.CFrame = CFrame.lookAt(center + Vector3.new(extent * 0.85, extent * 0.45, -extent * 1.7), center)
    end)
    if not ok then viewport:Destroy(); return nil end
    return viewport
end

local function line(parent, from, to, color, thickness, zindex)
    local delta = to - from
    local result = frame(parent, color, UDim2.fromScale((from.X + to.X) / 2, (from.Y + to.Y) / 2), UDim2.new(0, 1, 0, thickness or 3), 3)
    result.AnchorPoint = Vector2.new(0.5, 0.5)
    result.ZIndex = zindex or 4
    local function layout()
        local size = parent.AbsoluteSize
        local dx, dy = delta.X * size.X, delta.Y * size.Y
        result.Size = UDim2.fromOffset(math.sqrt(dx * dx + dy * dy), thickness or 3)
        result.Rotation = math.deg(math.atan2(dy, dx))
    end
    layout()
    return result, layout
end

local function setPiece(session, piece)
    if session.Done[session.Challenge.Targets[piece]] then return end
    session.Piece = piece
    if session.PieceLabel then session.PieceLabel.Text = "PIECE " .. piece .. " SELECTED  ·  FIND ITS OUTLINE" end
    for index, button in pairs(session.PieceButtons) do
        local selected = index == piece
        button.BackgroundColor3 = if selected then session.Colors.Teal else session.Colors.Panel
        button.TextColor3 = if selected then session.Colors.Panel else session.Colors.Ink
    end
end

local function updatePieces(session)
    local remaining = {}
    for piece = 1, 16 do
        if not session.Done[session.Challenge.Targets[piece]] then table.insert(remaining, piece) end
    end
    local selectedStillExists = table.find(remaining, session.Piece)
    if #remaining &gt; 0 and not selectedStillExists then session.Piece = remaining[1] end
    for piece, button in pairs(session.PieceButtons) do
        local index = table.find(remaining, piece)
        button.Visible = index ~= nil and index &lt;= 4
        if button.Visible then
            button.Position = UDim2.new((index - 1) / 4, 3, 0, 2)
        end
    end
    if #remaining &gt; 0 then setPiece(session, session.Piece)
    elseif session.PieceLabel then session.PieceLabel.Text = "ALL PIECES FIT · BEAUTIFULLY DONE" end
end

local function updateWireStage(session)
    if session.Kind ~= "Rewire" then return end
    local stage = if session.Progress &gt;= 8 then 2 else 1
    session.WireStage = stage
    for cell, button in ipairs(session.Buttons) do
        local pair = math.ceil(session.Ranks[cell] / 2)
        button.Visible = math.ceil(pair / 4) == stage
    end
    for _, wire in ipairs(session.Wires) do wire.Line.Visible = wire.Stage == stage end
    session.StageLabel.Text = if session.Progress &gt;= 16 then "ALL CIRCUITS CONNECTED" else "CIRCUIT " .. stage .. " / 2 · MATCH THE SYMBOLS"
end

local function enqueue(session, cell)
    if not session.Active or session.Finishing or not cell or session.Done[cell] or session.PendingCells[cell] then return end
    if session.Kind == "Assemble" and not session.Piece then return end
    if session.Kind == "Repaint" and not session.SelectedPalette then
        session.Status.Text = "Choose a paint color first."
        return
    end
    if session.Kind == "Rewire" and session.LocalWireStart == cell then return end
    session.PendingCells[cell] = true
    table.insert(session.Queue, {Cell = cell, Piece = session.Piece})
    if session.Kind == "Rewire" then
        session.LocalWireStart = if session.LocalWireStart then nil else cell
    end
end

local function selectPalette(session, index)
    session.SelectedPalette = index
    -- Palette selection uses the same outgoing queue as tile strokes, so a quick
    -- brush gesture cannot arrive at the server before the palette message.
    table.insert(session.Queue, {Palette = index})
    for i, button in ipairs(session.PaletteButtons) do
        local selected = i == index
        button.Text = (if selected then "✓ " else "") .. session.Config.Styles[i]
        session.PaletteStrokes[i].Thickness = if selected then 3 else 1
        session.PaletteStrokes[i].Color = if selected then session.Colors.Ink else Color3.fromRGB(255, 249, 234)
    end
    session.Status.Text = if index == session.Challenge.RequiredPalette then "Perfect palette. Brush each section." else "Requested finish: " .. session.Config.Styles[session.Challenge.RequiredPalette]
end

function Minigames.start(ui, UI, challenge, send, config)
    ui.Locked = true
    ui:clear(challenge.Kind .. " · restoration")
    local info = descriptions[challenge.Kind] or descriptions.Scrub
    local session = {
        Ui = ui, Challenge = challenge, Config = config, Token = challenge.Token,
        Kind = challenge.Kind, Colors = UI.Colors, Send = send, Active = true,
        Connections = {}, Queue = {}, PendingCells = {}, PendingAt = {}, Done = {},
        Buttons = {}, Ranks = {}, CellStyles = {}, PieceButtons = {}, PaletteButtons = {}, PaletteStrokes = {},
        Wires = {}, LineLayouts = {}, Progress = 0, Mistakes = 0, LastSend = -1,
        Started = os.clock(), WireStage = 1, ScrollEnabled = ui.Content.ScrollingEnabled,
    }
    for rank, cell in ipairs(challenge.Targets) do session.Ranks[cell] = rank end
    local card = UI.card(ui.Content)
    session.Card = card
    local heading = UI.label(card, info.Title, 20, UI.Colors.Ink)
    heading.Font = Enum.Font.GothamBold
    local instruction = UI.label(card, info.Instruction, 15, UI.Colors.Muted)
    instruction.Size = UDim2.new(1, 0, 0, 36)
    local tool = UI.label(card, info.Tool .. "  ·  TOOL LEVEL " .. (challenge.Tool or 0), 12, UI.Colors.Teal)
    tool.Font = Enum.Font.GothamBold
    tool.Size = UDim2.new(1, 0, 0, 20)

    local meterRow = frame(card, UI.Colors.Panel, nil, UDim2.new(1, 0, 0, 28))
    meterRow.BackgroundTransparency = 1
    session.Meter = text(meterRow, "0% RESTORED", 14, UI.Colors.Teal)
    session.Meter.Font = Enum.Font.GothamBold
    session.Meter.Size = UDim2.new(0.65, 0, 1, 0)
    session.Meter.TextXAlignment = Enum.TextXAlignment.Left
    session.Clock = text(meterRow, "20s", 18, UI.Colors.Ink)
    session.Clock.Size = UDim2.new(0.35, 0, 1, 0)
    session.Clock.Position = UDim2.fromScale(0.65, 0)
    session.Clock.TextXAlignment = Enum.TextXAlignment.Right
    local progressTrack = frame(card, Color3.fromRGB(223, 225, 209), nil, UDim2.new(1, 0, 0, 7), 4)
    session.ProgressBar = frame(progressTrack, UI.Colors.Teal, nil, UDim2.fromScale(0, 1), 4)

    local board = frame(card, Color3.fromRGB(222, 209, 184), nil, UDim2.new(1, 0, 0, 260), 14)
    board.Name = "RestorationBoard"
    board.ClipsDescendants = true
    board.Active = true
    session.Board = board
    stroke(board, Color3.fromRGB(194, 174, 144), 1)
    -- Warm workbench grain is intentionally subtle so targets stay readable.
    for index = 1, 7 do
        local grain = frame(board, Color3.fromRGB(183, 159, 125), UDim2.new(0, 0, index / 8, 0), UDim2.new(1, 0, 0, 1))
        grain.BackgroundTransparency = 0.77
    end
    local previewArea = frame(board, UI.Colors.Panel, UDim2.fromScale(0.08, 0.04), UDim2.fromScale(0.84, 0.92), 30)
    previewArea.BackgroundTransparency = 0.83
    local viewport = preview(previewArea, challenge, config)
    if not viewport then
        local fallback = text(previewArea, "✦", 150, Color3.fromRGB(177, 150, 104))
        fallback.TextTransparency = 0.45
    end
    if challenge.Kind == "Rewire" then
        local circuit = frame(board, Color3.fromRGB(50, 77, 68), UDim2.fromScale(0.04, 0.035), UDim2.fromScale(0.92, 0.93), 12)
        circuit.BackgroundTransparency = 0.08
        for row = 1, 6 do
            local etched = frame(circuit, Color3.fromRGB(117, 150, 115), UDim2.fromScale(0.18, row / 7), UDim2.new(0.64, 0, 0, 1))
            etched.BackgroundTransparency = 0.72
        end
    end
    local targets = frame(board, UI.Colors.Panel, UDim2.fromScale(0.035, 0.025), UDim2.fromScale(0.93, 0.95))
    targets.BackgroundTransparency = 1
    session.Targets = targets

    local ranks = session.Ranks
    local centers = {}
    for cell = 1, 16 do
        if challenge.Kind == "Rewire" then
            local rank = ranks[cell]
            local pair = math.ceil(rank / 2)
            local localPair = (pair - 1) % 4
            local left = rank % 2 == 1
            local row = if left then localPair else (localPair * 3 + 1) % 4
            centers[cell] = Vector2.new(if left then 0.12 else 0.88, 0.125 + row * 0.25)
        else
            local column, row = (cell - 1) % 4, math.floor((cell - 1) / 4)
            centers[cell] = Vector2.new((column + 0.5) / 4, (row + 0.5) / 4)
        end
    end
    session.Centers = centers
    if challenge.Kind == "Polish" then
        for index = 1, #challenge.Targets - 1 do
            local route, layout = line(targets, centers[challenge.Targets[index]], centers[challenge.Targets[index + 1]], Color3.fromRGB(255, 242, 189), 5, 2)
            route.BackgroundTransparency = 0.28
            table.insert(session.LineLayouts, layout)
        end
    end

    local function beginPointer(cell, input)
        if not isPointer(input) or not session.Active then return end
        session.Pointer = input
        session.PointerKind = input.UserInputType
        session.PointerStartCell = cell
        session.LastPointer = localPoint(session, input.Position)
        session.Ui.Content.ScrollingEnabled = false
        if challenge.Kind ~= "Assemble" then enqueue(session, cell) end
    end
    for cell = 1, 16 do
        local button = Instance.new("TextButton")
        button.Name = "RestorationTarget" .. cell
        button.AnchorPoint = Vector2.new(0.5, 0.5)
        button.Position = UDim2.fromScale(centers[cell].X, centers[cell].Y)
        button.Size = if challenge.Kind == "Rewire" then UDim2.new(0.2, 0, 0.22, 0) else UDim2.new(0.25, -4, 0.25, -4)
        button.BackgroundColor3 = Color3.fromRGB(239, 232, 212)
        button.BackgroundTransparency = 0.15
        button.BorderSizePixel = 0
        button.Text = ""
        button.AutoButtonColor = false
        button.Selectable = true
        button.ZIndex = 5
        button.Parent = targets
        corner(button, if challenge.Kind == "Rewire" then 14 else 10)
        local outline = stroke(button, Color3.fromRGB(255, 247, 228), 1.5, 0.25)
        session.Buttons[cell] = button
        session.CellStyles[cell] = {Stroke = outline}
        if challenge.Kind == "Scrub" then
            button.BackgroundColor3 = Color3.fromRGB(143, 126, 91)
            button.BackgroundTransparency = 0.18
            for stain = 1, 5 do
                local speck = frame(button, Color3.fromRGB(103 + stain * 5, 95 + stain * 4, 67 + stain * 3),
                    UDim2.fromScale(((cell * 7 + stain * 3) % 9 + 1) / 12, ((cell * 3 + stain * 7) % 9 + 1) / 12),
                    UDim2.fromScale(0.1 + (stain % 3) * 0.08, 0.12 + ((cell + stain) % 3) * 0.08), 20)
                speck.BackgroundTransparency = 0.15
                speck.ZIndex = 6
            end
        elseif challenge.Kind == "Polish" then
            button.BackgroundTransparency = 0.63
            button.Text = tostring(ranks[cell])
            button.TextSize = 19
            button.Font = Enum.Font.GothamBold
            button.TextColor3 = UI.Colors.Ink
            outline.Transparency = 0.65
        elseif challenge.Kind == "Rewire" then
            local pair = math.ceil(ranks[cell] / 2)
            button.BackgroundColor3 = wireColors[pair]
            button.BackgroundTransparency = 0
            button.Text = wireSymbols[pair]
            button.Font = Enum.Font.GothamBold
            button.TextSize = 27
            button.TextColor3 = Color3.fromRGB(37, 58, 52)
            outline.Color = Color3.fromRGB(239, 241, 217)
            local socket = frame(button, Color3.fromRGB(30, 52, 45), UDim2.fromScale(0.43, 0.81), UDim2.fromScale(0.14, 0.08), 4)
            socket.ZIndex = 6
        elseif challenge.Kind == "Repaint" then
            button.BackgroundColor3 = Color3.fromRGB(230, 221, 202)
            button.BackgroundTransparency = 0.38
            local patch = text(button, "◌", 24, Color3.fromRGB(168, 153, 125))
            patch.ZIndex = 6
            session.CellStyles[cell].Label = patch
        else
            button.BackgroundColor3 = Color3.fromRGB(118, 116, 101)
            button.BackgroundTransparency = 0.48
            button.Text = pieceSymbols[(ranks[cell] - 1) % #pieceSymbols + 1] .. " " .. ranks[cell]
            button.TextSize = 18
            button.Font = Enum.Font.GothamBold
            button.TextColor3 = Color3.fromRGB(255, 246, 216)
            outline.Transparency = 0.1
        end
        listen(session, button.InputBegan, function(input) beginPointer(cell, input) end)
        listen(session, button.Activated, function(input)
            -- Mouse/touch are handled on pointer down/up, so releasing after a
            -- long press never submits a duplicate stroke or mismatching wire.
            if isActivation(input) then enqueue(session, cell) end
        end)
        listen(session, button.SelectionGained, function() outline.Thickness = 3 end)
        listen(session, button.SelectionLost, function() outline.Thickness = 1.5 end)
    end

    if challenge.Kind == "Rewire" then
        session.StageLabel = UI.label(card, "CIRCUIT 1 / 2 · MATCH THE SYMBOLS", 12, UI.Colors.Teal)
        session.StageLabel.Font = Enum.Font.GothamBold
        session.StageLabel.Size = UDim2.new(1, 0, 0, 22)
        updateWireStage(session)
    elseif challenge.Kind == "Repaint" then
        local paintLabel = UI.label(card, "REQUESTED FINISH: " .. string.upper(config.Styles[challenge.RequiredPalette]), 12, UI.Colors.Teal)
        paintLabel.Font = Enum.Font.GothamBold
        paintLabel.Size = UDim2.new(1, 0, 0, 24)
        local palette = frame(card, UI.Colors.Panel, nil, UDim2.new(1, 0, 0, 48))
        palette.BackgroundTransparency = 1
        for index, style in ipairs(config.Styles) do
            local button = Instance.new("TextButton")
            button.Position = UDim2.new((index - 1) / #config.Styles, 2, 0, 0)
            button.Size = UDim2.new(1 / #config.Styles, -4, 1, 0)
            button.BackgroundColor3 = paintColors[index]
            button.BorderSizePixel = 0
            button.Text = style
            button.TextSize = 11
            button.TextWrapped = true
            button.TextColor3 = Color3.fromRGB(39, 52, 47)
            button.Font = Enum.Font.GothamBold
            button.Parent = palette
            corner(button, 10)
            session.PaletteButtons[index] = button
            session.PaletteStrokes[index] = stroke(button, Color3.fromRGB(255, 249, 234), 1)
            listen(session, button.Activated, function() if session.Active then selectPalette(session, index) end end)
        end
    elseif challenge.Kind == "Assemble" then
        session.PieceLabel = UI.label(card, "SELECT A PIECE, THEN ITS OUTLINE", 12, UI.Colors.Teal)
        session.PieceLabel.Size = UDim2.new(1, 0, 0, 22)
        session.PieceLabel.Font = Enum.Font.GothamBold
        local tray = frame(card, Color3.fromRGB(218, 206, 182), nil, UDim2.new(1, 0, 0, 54), 10)
        for piece = 1, 16 do
            local button = Instance.new("TextButton")
            button.Size = UDim2.new(0.25, -6, 1, -4)
            button.BackgroundColor3 = UI.Colors.Panel
            button.TextColor3 = UI.Colors.Ink
            button.Text = pieceSymbols[(piece - 1) % #pieceSymbols + 1] .. " " .. piece
            button.Font = Enum.Font.GothamBold
            button.TextSize = 21
            button.Parent = tray
            corner(button, 9)
            session.PieceButtons[piece] = button
            listen(session, button.Activated, function() if session.Active then setPiece(session, piece) end end)
            listen(session, button.InputBegan, function(input)
                if not isPointer(input) or not session.Active then return end
                setPiece(session, piece)
                session.DragPiece = piece
                session.Pointer = input
                session.PointerKind = input.UserInputType
                session.LastPointer = localPoint(session, input.Position)
                session.Ui.Content.ScrollingEnabled = false
                session.Ghost.Text = button.Text
                session.Ghost.Visible = true
                session.Ghost.Position = UDim2.fromOffset(session.LastPointer.X, session.LastPointer.Y - 28)
            end)
        end
        updatePieces(session)
    end
    local ghost = Instance.new("TextLabel")
    ghost.Name = "RestorationPieceGhost"
    ghost.AnchorPoint = Vector2.new(0.5, 0.5)
    ghost.Size = UDim2.fromOffset(68, 48)
    ghost.BackgroundColor3 = UI.Colors.Teal
    ghost.TextColor3 = UI.Colors.Panel
    ghost.BackgroundTransparency = 0.08
    ghost.Font = Enum.Font.GothamBold
    ghost.TextSize = 22
    ghost.Visible = false
    ghost.ZIndex = 100
    ghost.Parent = ui.Gui
    corner(ghost, 10)
    session.Ghost = ghost
    session.Status = UI.label(card, if challenge.Kind == "Assemble" then "The next piece is selected for you. Tap its outline to fit it." else "Small improvements still count. There is no hard failure.", 13, UI.Colors.Muted)
    session.Status.Size = UDim2.new(1, 0, 0, 32)
    local actions = frame(card, UI.Colors.Panel, nil, UDim2.new(1, 0, 0, 48))
    actions.BackgroundTransparency = 1
    local finish = UI.button(actions, "Ready in 8s", function()
        if session.Active and not session.Finishing and os.clock() - session.Started &gt;= (challenge.Minimum or 8) then
            session.Finishing = true
            send("FinishRestore", {Token = challenge.Token})
        end
    end)
    finish.Size = UDim2.new(0.72, -4, 1, 0)
    local cancel = UI.button(actions, "Cancel", function()
        if session.Active then send("CancelRestore", {}) end
    end, true)
    cancel.Position = UDim2.new(0.72, 4, 0, 0)
    cancel.Size = UDim2.new(0.28, -4, 1, 0)
    session.Finish = finish

    local function sizeBoard()
        local available = math.max(210, ui.Content.AbsoluteSize.Y - 215)
        local width = math.max(220, board.AbsoluteSize.X)
        local height = math.clamp(math.min(width * 0.74, available), 220, 380)
        board.Size = UDim2.new(1, 0, 0, height)
        for _, layout in ipairs(session.LineLayouts) do layout() end
    end
    sizeBoard()
    listen(session, ui.Content:GetPropertyChangedSignal("AbsoluteSize"), sizeBoard)
    listen(session, board:GetPropertyChangedSignal("AbsoluteSize"), function()
        for _, layout in ipairs(session.LineLayouts) do layout() end
    end)
    local function moved(input)
        if not session.Pointer or not session.Active then return end
        if session.PointerKind == Enum.UserInputType.Touch and input ~= session.Pointer then return end
        if session.PointerKind == Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
        local point = localPoint(session, input.Position)
        if session.DragPiece then
            ghost.Position = UDim2.fromOffset(point.X, point.Y - 28)
        elseif challenge.Kind == "Scrub" or challenge.Kind == "Polish" or challenge.Kind == "Repaint" then
            local before = session.LastPointer or point
            local steps = math.clamp(math.ceil((point - before).Magnitude / 12), 1, 24)
            for step = 1, steps do enqueue(session, atCell(session, before:Lerp(point, step / steps))) end
        end
        session.LastPointer = point
    end
    listen(session, UserInputService.InputChanged, moved)
    listen(session, UserInputService.InputEnded, function(input)
        if not session.Pointer or not isPointer(input) then return end
        if session.PointerKind == Enum.UserInputType.Touch and input ~= session.Pointer then return end
        local point = localPoint(session, input.Position)
        local cell = atCell(session, point)
        if challenge.Kind == "Assemble" then
            if cell then enqueue(session, cell) end
        elseif challenge.Kind == "Rewire" and cell ~= session.PointerStartCell then
            enqueue(session, cell)
        end
        session.Pointer = nil
        session.DragPiece = nil
        session.PointerStartCell = nil
        session.Ui.Content.ScrollingEnabled = session.ScrollEnabled
        ghost.Visible = false
    end)
    listen(session, UserInputService.WindowFocusReleased, function()
        session.Pointer = nil; session.DragPiece = nil; ghost.Visible = false
        session.Ui.Content.ScrollingEnabled = session.ScrollEnabled
    end)
    listen(session, RunService.Heartbeat, function()
        if not session.Active then return end
        local now = os.clock()
        local elapsed = now - session.Started
        local left = math.max(0, (challenge.Duration or 20) - elapsed)
        session.Clock.Text = math.ceil(left) .. "s"
        session.Clock.TextColor3 = if left &lt;= 5 then UI.Colors.Rose else UI.Colors.Ink
        if session.Finishing then
            finish.Text = "Finishing…"
        elseif elapsed &lt; (challenge.Minimum or 8) then
            finish.Text = "Ready in " .. math.ceil((challenge.Minimum or 8) - elapsed) .. "s"
            finish.BackgroundTransparency = 0.35
        else
            finish.Text = if session.Progress &gt;= 16 then "Finish · beautiful work!" else "Finish restoration"
            finish.BackgroundTransparency = 0
        end
        -- One ordered queue prevents quick swipe samples being dropped by the
        -- server's per-session input interval. Palette changes share the queue.
        if not session.Finishing and #session.Queue &gt; 0 and now - session.LastSend &gt;= 0.085 then
            local request = table.remove(session.Queue, 1)
            request.Token = challenge.Token
            session.LastSend = now
            if request.Cell then session.PendingAt[request.Cell] = now end
            send("RestoreInput", request)
        end
        for cell, when in pairs(session.PendingAt) do
            if now - when &gt; 1.5 then
                -- A rejected/late packet may not produce an acknowledgement.
                -- Permit a deliberate retry, without submitting it automatically.
                session.PendingAt[cell] = nil; session.PendingCells[cell] = nil
            end
        end
        if challenge.Kind == "Polish" and session.Progress &lt; 16 then
            local nextCell = challenge.Targets[session.Progress + 1]
            for cell, style in ipairs(session.CellStyles) do
                if not session.Done[cell] then
                    style.Stroke.Color = if cell == nextCell then UI.Colors.Gold else Color3.fromRGB(255, 247, 228)
                    style.Stroke.Thickness = if cell == nextCell then 2.5 + math.sin(elapsed * 5) * 0.5 else 1
                end
            end
        end
    end)
    return session
end

local function completeCell(session, cell)
    local button = session.Buttons[cell]
    if not button then return end
    session.Done[cell] = true
    session.PendingCells[cell] = nil
    session.PendingAt[cell] = nil
    local style = session.CellStyles[cell]
    if session.Kind == "Scrub" then
        ease(button, 0.28, {BackgroundTransparency = 1})
        ease(style.Stroke, 0.28, {Transparency = 1})
        for _, child in ipairs(button:GetChildren()) do
            if child:IsA("Frame") then ease(child, 0.28, {BackgroundTransparency = 1}) end
        end
    elseif session.Kind == "Repaint" then
        ease(button, 0.2, {BackgroundColor3 = paintColors[session.Challenge.RequiredPalette], BackgroundTransparency = 0.18})
        if style.Label then style.Label.Text = "✓"; style.Label.TextColor3 = Color3.fromRGB(255, 252, 234) end
        style.Stroke.Transparency = 0.6
    elseif session.Kind == "Polish" then
        button.Text = "✦"
        button.TextColor3 = Color3.fromRGB(255, 247, 205)
        ease(button, 0.3, {BackgroundTransparency = 1})
        style.Stroke.Transparency = 1
    elseif session.Kind == "Assemble" then
        ease(button, 0.18, {BackgroundColor3 = session.Colors.Teal, BackgroundTransparency = 0.1})
        button.Text = "✓ " .. session.Ranks[cell]
        style.Stroke.Color = Color3.fromRGB(217, 234, 205)
    else
        ease(button, 0.18, {BackgroundTransparency = 0.15})
        style.Stroke.Color = Color3.fromRGB(255, 242, 184)
        style.Stroke.Thickness = 2.5
    end
end

function Minigames.progress(session, data, UI)
    if not session or not session.Active then return end
    session.Progress = data.Progress or session.Progress
    session.Mistakes = data.Mistakes or session.Mistakes
    if data.Cell then session.PendingCells[data.Cell] = nil; session.PendingAt[data.Cell] = nil end
    session.Meter.Text = math.floor(session.Progress / 16 * 100) .. "% RESTORED"
    ease(session.ProgressBar, 0.16, {Size = UDim2.fromScale(session.Progress / 16, 1)})
    if data.Selected then
        session.LocalWireStart = data.Cell
        session.CellStyles[data.Cell].Stroke.Color = UI.Colors.Gold
        session.CellStyles[data.Cell].Stroke.Thickness = 3
        session.Status.Text = "One end connected. Find its matching symbol."
        return
    end
    if data.Valid then
        completeCell(session, data.Cell)
        if data.Other then
            completeCell(session, data.Other)
            local pair = math.ceil(session.Ranks[data.Cell] / 2)
            local wire, layout = line(session.Targets, session.Centers[data.Cell], session.Centers[data.Other], wireColors[pair], 5, 3)
            table.insert(session.Wires, {Line = wire, Stage = session.WireStage})
            table.insert(session.LineLayouts, layout)
            session.LocalWireStart = nil
        end
        sound(session, "restore")
        if session.Kind == "Assemble" then updatePieces(session) end
        session.Status.Text = if session.Progress &gt;= 16 then "Beautiful work. Finish when you are ready." else (if session.Mistakes == 0 then "Lovely progress. Keep that steady hand." else "Keep going. Every bit of care makes a difference.")
        if session.Kind == "Rewire" then updateWireStage(session) end
    else
        if data.Other then
            local outline = session.CellStyles[data.Other].Stroke
            outline.Color = Color3.fromRGB(239, 241, 217); outline.Thickness = 1.5
            session.LocalWireStart = nil
        end
        local style = session.CellStyles[data.Cell]
        if style then
            local old = style.Stroke.Color
            style.Stroke.Color = UI.Colors.Rose
            task.delay(0.22, function()
                if session.Active and style.Stroke.Parent then style.Stroke.Color = old end
            end)
        end
        session.Status.Text = if session.Kind == "Repaint" then "Try the requested paint: " .. session.Config.Styles[session.Challenge.RequiredPalette]
            elseif session.Kind == "Polish" then "Follow the highlighted number. You can still improve this find."
            elseif session.Kind == "Rewire" then "Those symbols differ. Pick a matching pair."
            elseif session.Kind == "Assemble" then "That piece belongs in another outline. Match its number."
            else "Sweep across a patch you have not cleaned yet."
    end
end

function Minigames.stop(session)
    if not session then return end
    session.Active = false
    session.Ui.Locked = false
    session.Ui.Content.ScrollingEnabled = session.ScrollEnabled
    for _, connection in ipairs(session.Connections) do connection:Disconnect() end
    table.clear(session.Connections)
    table.clear(session.Queue)
    if session.Ghost then session.Ghost:Destroy() end
end
return Minigames
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX30">
          <Properties>
            <string name="Name">Pages</string>
            <ProtectedString name="Source">-- The journal pages share one visual vocabulary and preserve drafts between updates.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local UI = require(script.Parent.UI)
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Catalog = require(Shared.Catalog)
local Pages = {}
Pages.__index = Pages
local player = Players.LocalPlayer
local function money(value)
    local amount = math.floor(value or 0)
    local str = tostring(math.abs(amount)); local out = str
    while true do local count; out, count = string.gsub(out, "^(%d+)(%d%d%d)", "%1,%2"); if count == 0 then break end end
    return (if amount &lt; 0 then "−$" else "$") .. out
end
local function remaining(seconds)
    seconds = math.max(0, math.floor(seconds))
    if seconds &gt;= 86400 then return math.floor(seconds / 86400) .. "d " .. math.floor(seconds % 86400 / 3600) .. "h" end
    if seconds &gt;= 3600 then return math.floor(seconds / 3600) .. "h " .. math.floor(seconds % 3600 / 60) .. "m" end
    return string.format("%d:%02d", math.floor(seconds / 60), seconds % 60)
end
local function inspectable(item)
    return item.Inspected and not item.Slot and not item.ListingId and not item.TradeId and not item.Locked and not item.Held
end
local function findItem(state, uid)
    for _, item in ipairs(state.Inventory) do if item.Uid == uid then return item end end
    return nil
end
function Pages.new(ui, send, open, guide)
    return setmetatable({UI = ui, Send = send, Open = open, Guide = guide, State = nil,
        BagCategory = "All", BagSort = "Newest", BagSearch = "", BagPage = 1,
        CollectionCategory = Catalog.Categories[1], Drafts = {}, ClockOffset = 0}, Pages)
end
function Pages:setState(state)
    self.State = state; self.ClockOffset = (state.ServerTime or os.time()) - os.time()
end
function Pages:now() return os.time() + self.ClockOffset end
function Pages:card(title, parent)
    local frame = UI.card(parent or self.UI.Content)
    if title then local label = UI.label(frame, title, 20); label.Font = Enum.Font.GothamBold end
    return frame
end
function Pages:button(parent, text, action, payload, secondary)
    return UI.button(parent, text, function() self.Send(action, payload or {}) end, secondary)
end
function Pages:nav(parent, text, page, context, secondary)
    return UI.button(parent, text, function() self.Open(page, context) end, secondary ~= false)
end
function Pages:timer(parent, prefix, deadline, onFinish)
    local label = UI.label(parent, prefix .. remaining(deadline - self:now()), 17, UI.Colors.Teal)
    label.Font = Enum.Font.GothamBold
    local last, completed = 0, false
    table.insert(self.UI.PageConnections, RunService.Heartbeat:Connect(function()
        if os.clock() - last &lt; 0.25 then return end; last = os.clock()
        local left = deadline - self:now(); label.Text = prefix .. remaining(left)
        if left &lt;= 0 and not completed then completed = true; if onFinish then onFinish() end end
    end))
    return label
end
function Pages:itemTile(parent, item, actionText, callback)
    local definition = Catalog.ById[item.DefId]
    if not definition then return end
    local tile = Instance.new("Frame"); tile.Name = "FindCard"; tile.BackgroundColor3 = UI.Colors.Panel
    tile.Size = UDim2.new(1, 0, 0, 258); tile.Parent = parent; UI.corner(tile, 14)
    local rarityColor = if item.Inspected then Color3.fromHex(Config.RarityColors[item.Rarity]) else UI.Colors.Line
    UI.stroke(tile, rarityColor, if item.Inspected and item.Rarity &gt;= 4 then 2 else 1, if item.Inspected then 0.18 else 0.25)
    local preview = UI.preview(tile, definition, item, 132, not item.Inspected)
    preview.Size = UDim2.new(1, -16, 0, 132); preview.Position = UDim2.fromOffset(8, 8)
    local title = UI.label(tile, if item.Inspected then definition.Name else "Mystery " .. definition.Category, 16)
    title.Font = Enum.Font.GothamBold; title.Position = UDim2.fromOffset(12, 147)
    title.Size = UDim2.new(1, -24, 0, 39); title.AutomaticSize = Enum.AutomaticSize.None
    title.TextYAlignment = Enum.TextYAlignment.Top
    local subtitle = if item.Inspected then Config.RarityIcons[item.Rarity] .. " " .. Config.Rarities[item.Rarity] .. " · " .. money(item.Value) else "A hidden treasure awaits"
    local color = if item.Inspected then Color3.fromHex(Config.RarityColors[item.Rarity]):Lerp(UI.Colors.Ink, 0.3) else UI.Colors.Muted
    local detail = UI.label(tile, subtitle, 13, color); detail.Position = UDim2.fromOffset(12, 185)
    detail.Size = UDim2.new(1, -24, 0, 20); detail.AutomaticSize = Enum.AutomaticSize.None; detail.TextTruncate = Enum.TextTruncate.AtEnd; detail.TextWrapped = false
    local button = UI.button(tile, actionText or "Take a closer look", callback, true)
    button.Size = UDim2.new(1, -16, 0, 44); button.Position = UDim2.new(0, 8, 1, -52); button.TextSize = 14
    if item.Slot or item.ListingId or item.TradeId or item.Locked or item.Held then
        local statusText = if item.Held then "IN YOUR HANDS" elseif item.Slot then "ON DISPLAY" elseif item.ListingId then "LISTED" else "RESERVED"
        local status = UI.label(preview, statusText, 10, UI.Colors.Panel)
        status.Font = Enum.Font.GothamBold; status.AutomaticSize = Enum.AutomaticSize.None
        status.Size = UDim2.new(1, 0, 0, 25); status.Position = UDim2.new(0, 0, 1, -25)
        status.BackgroundColor3 = UI.Colors.Teal; status.BackgroundTransparency = 0.1; status.TextXAlignment = Enum.TextXAlignment.Center
    end
    return tile
end
function Pages:itemSummary(parent, item, height)
    local definition = Catalog.ById[item.DefId]
    if not definition then return end
    UI.preview(parent, definition, item, height or 215, not item.Inspected)
    if item.Inspected then
        local tags = UI.row(parent, 29, 6)
        UI.pill(tags, Config.RarityIcons[item.Rarity] .. " " .. Config.Rarities[item.Rarity], Color3.fromHex(Config.RarityColors[item.Rarity]):Lerp(UI.Colors.Ink, 0.25))
        UI.pill(tags, Config.Conditions[item.Condition], UI.Colors.Teal)
        UI.label(parent, definition.Name, 24).Font = Enum.Font.GothamBold
        UI.label(parent, (item.Style or definition.Style) .. " • " .. definition.Category, 15, UI.Colors.Muted)
    else UI.label(parent, "Your mystery " .. definition.Category, 23).Font = Enum.Font.GothamBold end
end
function Pages:guideButton(parent, location, label)
    return UI.button(parent, "⚡  " .. (label or "Teleport there"), function()
        self.Send("Teleport", {Destination = location})
        self.Guide(location)
        self.UI:hide()
    end, false)
end
function Pages:inventory(context, mode)
    local state = self.State
    local header = self:card()
    local categories = {"All"}; for _, category in ipairs(Catalog.Categories) do table.insert(categories, category) end
    local row = UI.row(header)
    UI.rowButton(row, "Category: " .. self.BagCategory, function()
        local current = table.find(categories, self.BagCategory) or 1
        self.BagCategory = categories[current % #categories + 1]; self.BagPage = 1; self.Open(mode or "Bag", context)
    end, 2, true)
    UI.rowButton(row, "Sort: " .. self.BagSort, function()
        local sorts = {"Newest", "Value", "Rarity", "Condition"}
        self.BagSort = sorts[(table.find(sorts, self.BagSort) or 1) % #sorts + 1]; self.BagPage = 1; self.Open(mode or "Bag", context)
    end, 2, true)
    local search = UI.input(header, "Search your finds…", self.BagSearch)
    search.FocusLost:Connect(function()
        if self.BagSearch ~= search.Text then self.BagSearch = search.Text; self.BagPage = 1; self.Open(mode or "Bag", context) end
    end)
    local items = {}
    for index = #state.Inventory, 1, -1 do
        local item = state.Inventory[index]
        local definition = Catalog.ById[item.DefId]
        local name = if item.Inspected then definition.Name else "Mystery " .. definition.Category
        local allowed = (self.BagCategory == "All" or self.BagCategory == definition.Category)
            and string.find(string.lower(name), string.lower(self.BagSearch), 1, true) ~= nil
        if mode == "Workbench" then allowed = allowed and inspectable(item) and item.Condition &lt; 5 end
        if mode == "Display" then allowed = allowed and inspectable(item) end
        if mode == "List" then allowed = allowed and inspectable(item) end
        if allowed then table.insert(items, item) end
    end
    if self.BagSort ~= "Newest" then
        local field = self.BagSort
        table.sort(items, function(a, b)
            local av, bv = a[field] or 0, b[field] or 0
            if av == bv then return a.Uid &lt; b.Uid end
            return av &gt; bv
        end)
    end
    UI.eyebrow(header, #items .. " finds • " .. #state.Inventory .. "/" .. Config.InventoryLimit .. " in your bag")
    if #items == 0 then
        local empty = UI.hero(self.UI.Content, "Your next story", "Something wonderful is waiting.", if mode == "Workbench" then "Inspect a find and take it off display before restoring it." else "Try a different filter, or explore Dumpster Alley for a new find.")
        self:guideButton(empty, "Source", "Head to Dumpster Alley"); return
    end
    local perPage = 8
    local pageCount = math.ceil(#items / perPage); self.BagPage = math.clamp(self.BagPage, 1, pageCount)
    local grid = UI.grid(self.UI.Content, 258, 183)
    for index = (self.BagPage - 1) * perPage + 1, math.min(#items, self.BagPage * perPage) do
        local item = items[index]
        local action = if mode == "Display" then "Place in slot " .. (context.Slot or "?") elseif mode == "Workbench" then "Restore this find" elseif mode == "List" then "Set a price" else "Take a closer look"
        self:itemTile(grid, item, action, function()
            if mode == "Display" then self.Send("Display", {Uid = item.Uid, Slot = context.Slot})
            elseif mode == "Workbench" then self.Open("Restore", {Uid = item.Uid})
            elseif mode == "List" then self.Open("ListingEditor", {Uid = item.Uid})
            else self.Open("Item", {Uid = item.Uid}) end
        end)
    end
    if pageCount &gt; 1 then
        local pageRow = UI.row(self.UI.Content)
        UI.rowButton(pageRow, "‹ Previous", function() self.BagPage = math.max(1, self.BagPage - 1); self.Open(mode or "Bag", context) end, 3, true)
        UI.rowButton(pageRow, self.BagPage .. " / " .. pageCount, function() end, 3, true)
        UI.rowButton(pageRow, "Next ›", function() self.BagPage = math.min(pageCount, self.BagPage + 1); self.Open(mode or "Bag", context) end, 3, true)
    end
end
function Pages:itemPage(context)
    local item = findItem(self.State, context.Uid)
    if not item then UI.label(self:card(), "This find has moved on to a new home.", 18); self:nav(self.UI.Content, "Back to your bag", "Bag"); return end
    local frame = self:card(); self:itemSummary(frame, item, 245)
    if not item.Inspected then
        UI.label(frame, "There is a story under all that dust. Inspect to reveal its rarity, style, and value.", 17, UI.Colors.Muted)
        self:button(frame, "✦ Reveal your find", "Inspect", {Uid = item.Uid}); return
    end
    local value = UI.label(frame, money(item.Value), 30, UI.Colors.Teal); value.Font = Enum.Font.GothamBold
    UI.eyebrow(frame, "Estimated value • includes today's demand and shop style")
    UI.progress(frame, item.Condition / 5, UI.Colors.Teal)
    if item.ListingId or item.TradeId or item.Locked then
        UI.disabled(frame, "This item is reserved in the market or a trade."); self:nav(frame, "Open market", "Market")
    elseif item.Slot then
        UI.label(frame, "On display in slot " .. item.Slot .. ". Your customers can make an offer.", 17)
        self:button(frame, "Return to your bag", "Display", {Uid = item.Uid, Remove = true}, true)
    elseif item.Held then
        UI.label(frame, "You are carrying this find. Other players can see its rarity effects while you explore town.", 17)
        self:button(frame, "Put it back in my bag", "Hold", {Uid = item.Uid}, false)
    else
        self:button(frame, "Hold and show off this find", "Hold", {Uid = item.Uid}, true)
        if item.Condition &lt; 5 then self:nav(frame, "Restore at your workbench", "Restore", {Uid = item.Uid}, false)
        else UI.disabled(frame, "✓ Mint condition — beautifully restored") end
        self:nav(frame, "Display in your shop", "Slots", {Uid = item.Uid})
        if self.State.Market then self:nav(frame, "List in the player market", "ListingEditor", {Uid = item.Uid}) end
    end
    self:nav(frame, "Back to your finds", "Bag")
end
function Pages:sourcePage(source)
    local state, tuning = self.State, Config.Sources[source]
    local copy = {
        Dumpster = {"Everyday treasure", "Someone's junk. Your next great find.", "Free finds, fresh possibilities. There is always another story in the alley."},
        Estate = {"Wholesale Source", "Restock with better mystery lots.", "Browse wholesale finds with improved rare-item odds. Weekend sourcing brings an extra surprise."},
        Delivery = {"A daily little delight", "A parcel with your name on it.", "Your free daily find is ready to unwrap. Come back tomorrow for another."},
    }
    local words = copy[source]
    local frame = UI.hero(self.UI.Content, words[1], words[2], words[3], if source == "Estate" then UI.Colors.Rose else UI.Colors.Teal)
    local info = self:card()
    UI.eyebrow(info, "Level " .. tuning.Level .. "+ • " .. (if tuning.Cost == 0 then "Always free" else money(tuning.Cost) .. " per lot"))
    if source == "Delivery" and state.LastDelivery == state.Day then
        UI.disabled(info, "✓ Today's parcel is yours")
        self:timer(info, "Next delivery in ", (state.Day + 1) * 86400)
    elseif state.Level &lt; tuning.Level then
        UI.disabled(info, "Unlock at level " .. tuning.Level)
    elseif state.AvailableCash &lt; tuning.Cost then
        UI.disabled(info, "You need " .. money(tuning.Cost) .. " available cash")
    else
        UI.button(info, if source == "Delivery" then "Open today's parcel" elseif source == "Dumpster" then "Search for a treasure" else "Choose a mystery lot · " .. money(tuning.Cost), function()
            self.UI:searchTreasure(source, function() self.Send("Source", {Source = source}) end)
        end)
    end
    self:guideButton(info, if source == "Dumpster" then "Source" else source, "Find this spot in town")
    local odds = self:card("A little surprise, with clear odds")
    for index, chance in ipairs(tuning.Weights) do
        local line = UI.label(odds, Config.RarityIcons[index] .. " " .. Config.Rarities[index] .. "  ·  " .. chance .. "%", 16)
        line.TextColor3 = Color3.fromHex(Config.RarityColors[index]):Lerp(UI.Colors.Ink, 0.35)
        UI.progress(odds, chance / 100, Color3.fromHex(Config.RarityColors[index]))
    end
    if source == "Estate" then UI.label(odds, "Weekend bonus: 8% of finds move up one rarity, up to Legendary. In-game cash only.", 14, UI.Colors.Muted) end
    self:nav(frame, "Look in your bag", "Bag")
end
function Pages:restorePage(context)
    local item = findItem(self.State, context.Uid)
    if not item then return self:inventory({}, "Workbench") end
    local frame = self:card(); self:itemSummary(frame, item, 190)
    UI.label(frame, "A little care goes a long way.", 22).Font = Enum.Font.GothamBold
    UI.label(frame, "Work at your own shop bench. Every attempt improves the item, and careful work gives a bigger condition boost.", 16, UI.Colors.Muted)
    self:guideButton(frame, "Workbench", "Guide me to my workbench")
    local techniques = {
        {"Scrub", "✦", "Swipe away the grime", "Relaxing, generous and satisfying."},
        {"Polish", "◇", "Trace a clean shine", "Follow the path with a steady hand."},
        {"Rewire", "↔", "Bring it back to life", "Match wire colors and symbols."},
        {"Repaint", "▧", "Make it your own", "Choose paint, fill the surface, change its style."},
        {"Assemble", "▦", "Put the story together", "Fit the missing pieces into their outlines."},
    }
    for _, technique in ipairs(techniques) do
        local choice = self:card(technique[2] .. " " .. technique[1])
        UI.label(choice, technique[3], 17); UI.label(choice, technique[4], 14, UI.Colors.Muted)
        self:button(choice, "Start " .. string.lower(technique[1]) .. " · 8–20 sec", "BeginRestore", {Uid = item.Uid, Kind = technique[1]})
    end
end
function Pages:slotsPage(context)
    local occupied = {}; for _, item in ipairs(self.State.Inventory) do if item.Slot then occupied[item.Slot] = item end end
    UI.label(self:card(), "Choose a free display in your shop. Customers browse displayed finds; matching your shop theme adds 10% value.", 17)
    local grid = UI.grid(self.UI.Content, 88, 160)
    for slot = 1, Config.Tiers[self.State.Tier].Slots do
        if occupied[slot] then
            local button = UI.button(grid, "Display " .. slot .. "\n" .. Catalog.ById[occupied[slot].DefId].Name, function() self.Open("Item", {Uid = occupied[slot].Uid}) end, true)
            button.TextSize = 14
        else self:button(grid, "＋ Display " .. slot, "Display", {Uid = context.Uid, Slot = slot}) end
    end
    self:guideButton(self.UI.Content, "Shop", "Guide me to my shop")
end
function Pages:shopPage()
    local state = self.State
    local offer = state.Offer
    if offer then
        local welcome = UI.hero(self.UI.Content, "A customer found something they love", offer.Customer, "A good find deserves a good home.")
        local item = findItem(state, offer.Uid)
        if item then UI.preview(welcome, Catalog.ById[item.DefId], item, 175, false) end
        UI.label(welcome, money(offer.Amount), 34, UI.Colors.Panel).Font = Enum.Font.GothamBold
        self:timer(welcome, "They can stay for ", offer.Ends)
        self:button(welcome, "Accept &amp; make their day", "Haggle", {Choice = "Accept"})
        if not offer.Countered then self:button(welcome, "Ask for 12% more · 65% chance", "Haggle", {Choice = "Counter"}, true) end
        self:button(welcome, "Politely decline", "Haggle", {Choice = "Decline"}, true)
    else
        local hero = UI.hero(self.UI.Content, "Your little corner of the street", Config.Tiers[state.Tier].Name, "Display your favorite finds. Customers bring the conversation, you make the deal.")
        self:guideButton(hero, "Shop", "Take me to my shop")
    end
    local overview = self:card("A shop that feels like you")
    local displayed = 0; for _, item in ipairs(state.Inventory) do if item.Slot then displayed += 1 end end
    UI.label(overview, displayed .. "/" .. Config.Tiers[state.Tier].Slots .. " displays filled  •  " .. state.Reputation .. " reputation", 17)
    UI.progress(overview, displayed / Config.Tiers[state.Tier].Slots)
    local links = UI.row(overview)
    UI.rowButton(links, "Your displays", function() self.Open("Displays") end, 2, true)
    UI.rowButton(links, "Decorate", function() self.Open("Decor") end, 2, true)
    self:nav(overview, "Themes &amp; collections", "Themes")
    local upgrades = self:card("Room to grow")
    local nextTier = Config.Tiers[state.Tier + 1]
    if nextTier then
        UI.label(upgrades, nextTier.Name .. " • " .. nextTier.Slots .. " display spaces", 19)
        UI.label(upgrades, "Unlocks at level " .. nextTier.Level .. " • " .. money(nextTier.Cost), 15, UI.Colors.Muted)
        if state.Level &gt;= nextTier.Level and state.AvailableCash &gt;= nextTier.Cost then self:button(upgrades, "Upgrade your shop", "Upgrade", {Kind = "Shop"})
        else UI.disabled(upgrades, if state.Level &lt; nextTier.Level then "Keep creating to reach level " .. nextTier.Level else "Save up " .. money(nextTier.Cost)) end
    else UI.disabled(upgrades, "✦ Your shop has reached its grandest tier") end
    local tools = self:card("The right tools, a little more magic")
    UI.label(tools, "Tool level " .. state.Tool .. "/" .. #Config.ToolCosts .. " • steadier restoration and better results", 17)
    local cost = Config.ToolCosts[state.Tool + 1]
    if cost then self:button(tools, "Upgrade tools · " .. money(cost), "Upgrade", {Kind = "Tool"}) else UI.disabled(tools, "✓ Your workshop is fully equipped") end
end
function Pages:displaysPage()
    local displayed = {}; for _, item in ipairs(self.State.Inventory) do if item.Slot then displayed[item.Slot] = item end end
    for slot = 1, Config.Tiers[self.State.Tier].Slots do
        local frame = self:card("Display " .. slot)
        local item = displayed[slot]
        if item then
            UI.preview(frame, Catalog.ById[item.DefId], item, 150, false)
            UI.label(frame, Catalog.ById[item.DefId].Name .. " • " .. money(item.Value), 18)
            self:button(frame, "Return to bag", "Display", {Uid = item.Uid, Remove = true}, true)
        else self:nav(frame, "Choose a find for this display", "Display", {Slot = slot}) end
    end
end
function Pages:themesPage()
    UI.label(self:card(), "Your shop is your signature. Finds that match your theme earn a 10% display bonus.", 17)
    for _, theme in ipairs(Config.Themes) do
        local frame = self:card(theme.Name)
        local swatch = Instance.new("Frame"); swatch.Size = UDim2.new(1, 0, 0, 60); swatch.BackgroundColor3 = Color3.new(unpack(theme.Color)); swatch.Parent = frame; UI.corner(swatch, 10)
        UI.eyebrow(frame, if self.State.Theme == theme.Id then "✓ Your current signature" elseif self.State.Themes[theme.Id] then "In your collection" else "Make it yours • " .. money(theme.Cost))
        self:button(frame, if self.State.Themes[theme.Id] then "Use this theme" else "Unlock theme · " .. money(theme.Cost), "Upgrade", {Kind = "Theme", Theme = theme.Id}, self.State.Themes[theme.Id])
    end
    self:nav(self.UI.Content, "Visit the cosmetic boutique", "Boutique")
end
function Pages:decorPage()
    UI.label(self:card(), "Layer in a little personality. Pick a piece, then arrange the floor decorations to make the room yours.", 17)
    for _, decoration in ipairs(Config.Decorations) do
        local frame = self:card(decoration.Name)
        UI.eyebrow(frame, if self.State.PlacedDecor[decoration.Id] then "On display" elseif self.State.Decorations[decoration.Id] then "In storage" else money(decoration.Cost))
        local label = if self.State.PlacedDecor[decoration.Id] then "Put away" elseif self.State.Decorations[decoration.Id] then "Place decoration" else "Buy &amp; place · " .. money(decoration.Cost)
        self:button(frame, label, "Upgrade", {Kind = "Decor", Decor = decoration.Id}, self.State.Decorations[decoration.Id])
        if self.State.PlacedDecor[decoration.Id] and table.find({"Rug", "Plant", "Trophy"}, decoration.Id) then self:nav(frame, "Arrange position", "Arrange", {Decor = decoration.Id}) end
    end
end
function Pages:questsPage()
    local state = self.State
    UI.hero(self.UI.Content, "Little goals. Lovely rewards.", "A little progress, every day.", "Find something. Fix something. Make someone's day.")
    local login = state.Login or {Streak = 1, ClaimedDay = -2}
    local gifts = {50, 75, 100, 150, 200, 300, 500}
    local gift = self:card("Your 7-day welcome streak")
    UI.label(gift, "Day " .. login.Streak .. " of 7  •  today's gift " .. money(gifts[math.clamp(login.Streak, 1, 7)]), 18)
    UI.progress(gift, login.Streak / 7, UI.Colors.Rose)
    local today = math.floor(self:now() / 86400)
    if login.ClaimedDay == today then UI.disabled(gift, "✓ Today's gift collected — come back tomorrow")
    else self:button(gift, "Collect today's gift", "DailyGift", {}) end
    local definitions = {{"Find", "Find 3 new stories", "Found", 3, 65}, {"Restore", "Restore 3 forgotten finds", "Restored", 3, 100}, {"Sell", "Send 3 finds to new homes", "Sold", 3, 150}}
    for _, definition in ipairs(definitions) do
        local frame = self:card(definition[2]); local progress = math.min(definition[4], state.Daily[definition[3]] or 0)
        UI.label(frame, progress .. " / " .. definition[4] .. " • " .. money(definition[5]) .. " reward", 16, UI.Colors.Muted)
        UI.progress(frame, progress / definition[4])
        if state.Daily.Claimed[definition[1]] then UI.disabled(frame, "✓ Collected — beautifully done")
        elseif progress &gt;= definition[4] then self:button(frame, "Collect " .. money(definition[5]), "Quest", {Id = definition[1]})
        else UI.disabled(frame, "Keep going — " .. (definition[4] - progress) .. " to go") end
    end
    local weekly = self:card("The weekly workshop challenge")
    UI.label(weekly, "Restore " .. math.min(20, state.Weekly.Restored) .. "/20 • Sell " .. math.min(15, state.Weekly.Sold) .. "/15", 17)
    UI.progress(weekly, (math.min(20, state.Weekly.Restored) / 20 + math.min(15, state.Weekly.Sold) / 15) / 2, UI.Colors.Gold)
    if state.Weekly.Claimed then UI.disabled(weekly, "✓ Weekly Wonder title earned")
    elseif state.Weekly.Restored &gt;= 20 and state.Weekly.Sold &gt;= 15 then self:button(weekly, "Collect $1,200 + Weekly Wonder", "Quest", {Id = "Weekly"})
    else UI.label(weekly, "$1,200 and a title for a week of good work.", 16, UI.Colors.Muted) end
    self:nav(weekly, "What's happening this season?", "Events")
    self:timer(weekly, "Daily reset in ", (state.Day + 1) * 86400)
end
function Pages:collectionPage()
    local total = 0; for _ in pairs(self.State.Collection) do total += 1 end
    local hero = UI.hero(self.UI.Content, "The collector's journal", total .. " / 400 discoveries", "Every rarity has a story. Discover 10 new combinations to earn $100.")
    UI.progress(hero, total / 400, UI.Colors.Gold)
    local tabs = self:card()
    local categories = Catalog.Categories
    local index = table.find(categories, self.CollectionCategory) or 1
    local row = UI.row(tabs)
    UI.rowButton(row, "‹", function() self.CollectionCategory = categories[(index - 2) % #categories + 1]; self.Open("Collection") end, 3, true)
    UI.rowButton(row, self.CollectionCategory, function() end, 3, true)
    UI.rowButton(row, "›", function() self.CollectionCategory = categories[index % #categories + 1]; self.Open("Collection") end, 3, true)
    local grid = UI.grid(self.UI.Content, 258, 183)
    for _, definition in ipairs(Catalog.Items) do
        if definition.Category == self.CollectionCategory then
            local highest, found = 1, false
            local stamps = {}
            for rarity = 1, 5 do
                local discovered = self.State.Collection[definition.Id .. ":" .. rarity]
                if discovered then highest = rarity; found = true end
                table.insert(stamps, if discovered then Config.RarityIcons[rarity] else "–")
            end
            local previewItem = {DefId = definition.Id, Rarity = highest, Condition = 5, Style = definition.Style, Inspected = found, Value = 0}
            local tile = self:itemTile(grid, previewItem, table.concat(stamps, "   "), function()
                self.UI:notice(if found then definition.Name .. " · keep collecting to discover every rarity." else "Find this design to reveal its place in your collection.")
            end)
            if tile then
                local detail = tile:FindFirstChild("Label")
                if detail then detail.Text = if found then definition.Name else "Undiscovered design" end
            end
        end
    end
end

function Pages:auctionPage()
    local auction = self.State.Auction
    if not auction then
        local hero = UI.hero(self.UI.Content, "The gavel rests", "The next treasure is on its way", "Explore the street while the auctioneer prepares a special find.")
        self:timer(hero, "Next auction in ", self.State.NextAuction)
        self:guideButton(hero, "Auction", "Walk to the auction house")
        return
    end
    local frame = UI.hero(self.UI.Content, "Live at the auction house", "Going once…", "Bid with in-game cash. A late bid extends the clock so everyone gets a fair chance.")
    self:itemSummary(frame, auction.Item, 205)
    UI.label(frame, "Current bid  " .. money(auction.Bid), 28, UI.Colors.Panel).Font = Enum.Font.GothamBold
    self:timer(frame, "Gavel falls in ", auction.Ends)
    local minimum = auction.Bid + math.max(10, math.floor(auction.Bid * 0.1))
    if auction.Bidder == player.UserId then UI.eyebrow(frame, "✓ YOU'RE LEADING — " .. money(auction.Bid) .. " RESERVED", UI.Colors.Gold) end
    self:button(frame, "Bid " .. money(minimum), "Bid", {Amount = minimum})
    self:button(frame, "Bid " .. money(minimum + math.max(50, math.floor(minimum * 0.2))), "Bid", {Amount = minimum + math.max(50, math.floor(minimum * 0.2))}, true)
    self:guideButton(frame, "Auction", "Show me the auction house")
end

function Pages:listingEditor(context)
    local item = findItem(self.State, context.Uid)
    if not item or not inspectable(item) then UI.label(self:card(), "That find is no longer available to list.", 17); return end
    local frame = self:card("List a find for your town")
    self:itemSummary(frame, item, 180)
    UI.label(frame, "A 3% fee is charged when you create the listing. Listings expire after 30 minutes or when you leave this server.", 14, UI.Colors.Muted)
    local suggested = math.max(1, math.floor(item.Value * 1.15))
    local input = UI.input(frame, "Whole-dollar price", tostring(self.Drafts.ListingPrice or suggested), true)
    UI.button(frame, "List this find", function()
        self.Drafts.ListingPrice = tonumber(input.Text) or 0
        self.Send("MarketList", {Uid = item.Uid, Price = self.Drafts.ListingPrice})
    end)
end

function Pages:marketPage()
    local market = self.State.Market
    if not market then UI.label(self:card(), "The market is opening…", 18); return end
    local hero = UI.hero(self.UI.Content, "The makers' market", "Trade stories, find something you love", "Listings and trades happen with players in this server. Both profiles are saved through a recovery journal before anything changes hands.")
    self:guideButton(hero, "Market", "Walk to Market Square")
    self:nav(hero, "List one of my finds", "List")
    self:nav(hero, "Start a direct trade", "Trade")
    if #market.Listings == 0 then UI.label(self:card(), "No listings yet. Be the first shopkeeper to put a restored find on the market.", 17) end
    for _, listing in ipairs(market.Listings) do
        local frame = self:card(listing.SellerName .. "'s find")
        self:itemSummary(frame, listing.Item, 165)
        UI.label(frame, money(listing.Price) .. "  •  value estimate " .. money(listing.Item.Value), 19)
        self:timer(frame, "Listing closes in ", listing.Expires)
        if listing.SellerId == player.UserId then self:button(frame, "Cancel listing", "MarketCancel", {ListingId = listing.Id}, true)
        else self:button(frame, "Buy for " .. money(listing.Price), "MarketBuy", {ListingId = listing.Id}) end
    end
end

function Pages:listPage()
    self:inventory({}, "List")
end

function Pages:tradePage()
    local trade = self.State.Trade
    if not trade then
        local hero = UI.hero(self.UI.Content, "A fair exchange", "Choose a neighbor", "Both players must be at Market Square, level 3, and finished with the first-sale tutorial.")
        self:guideButton(hero, "Market", "Meet at Market Square")
        for _, shop in ipairs(self.State.Shops) do
            if shop.UserId ~= player.UserId then self:button(hero, "Invite " .. shop.Name, "TradeInvite", {UserId = shop.UserId}, true) end
        end
        return
    end
    local frame = UI.hero(self.UI.Content, "Direct trade", "You and " .. trade.PartnerName, "Every change clears both confirmations. Review the current revision before you confirm.")
    self:timer(frame, "Trade closes in ", trade.Ends)
    if trade.Status == "Invited" then
        if trade.InviterId ~= player.UserId then self:button(frame, "Accept invitation", "TradeRespond", {TradeId = trade.Id, Accept = true})
        else UI.disabled(frame, "Waiting for " .. trade.PartnerName .. "…") end
        self:button(frame, "Decline", "TradeCancel", {TradeId = trade.Id}, true); return
    end
    local function offerCard(title, offer)
        local card = self:card(title .. (if offer.Confirmed then "  ✓ CONFIRMED" else ""))
        UI.label(card, "Cash offered: " .. money(offer.Cash), 18)
        for _, item in ipairs(offer.Items) do self:itemSummary(card, item, 100) end
        if #offer.Items == 0 then UI.label(card, "No finds offered", 14, UI.Colors.Muted) end
        return card
    end
    local own = offerCard("You offer", trade.You); offerCard(trade.PartnerName .. " offers", trade.Them)
    local cash = UI.input(own, "Cash amount", tostring(trade.You.Cash), true)
    UI.button(own, "Update cash", function()
        self.Send("TradeOffer", {TradeId = trade.Id, Cash = tonumber(cash.Text) or 0})
    end, true)
    local offered = {}; for _, item in ipairs(trade.You.Items) do offered[item.Uid] = true end
    for _, item in ipairs(self.State.Inventory) do
        if item.Inspected and not item.Slot and (not item.Locked or offered[item.Uid]) then
            self:button(own, (if offered[item.Uid] then "Remove " else "Add ") .. Catalog.ById[item.DefId].Name,
                "TradeOffer", {TradeId = trade.Id, Uid = item.Uid, Add = not offered[item.Uid]}, true)
        end
    end
    if self:now() &gt;= trade.ConfirmAfter then
        self:button(frame, if trade.You.Confirmed then "✓ Waiting for partner" else "Confirm revision " .. trade.Revision,
            "TradeConfirm", {TradeId = trade.Id, Revision = trade.Revision})
    else self:timer(frame, "Review unlocks in ", trade.ConfirmAfter) end
    self:button(frame, "Cancel trade", "TradeCancel", {TradeId = trade.Id}, true)
end

function Pages:showcasePage()
    local showcase = self.State.Live and self.State.Live.Showcase
    if not showcase then UI.label(self:card(), "The showcase is loading…", 18); self:button(self.UI.Content, "Refresh", "LiveRefresh", {}); return end
    local hero = UI.hero(self.UI.Content, "Weekly designer showcase", showcase.Theme .. " week", "Compete with a small persistent neighborhood across servers. One vote per player; winners can collect cosmetic prizes after the week closes.")
    self:timer(hero, "Voting ends in ", showcase.Ends)
    if showcase.Entered then UI.disabled(hero, "✓ Your shop is entered") else self:button(hero, "Enter my displayed collection", "Showcase", {Choice = "Enter"}) end
    self:button(hero, "Collect past prizes", "Showcase", {Choice = "Claim"}, true)
    self:button(hero, "Refresh results", "Showcase", {Choice = "Refresh"}, true)
    if #showcase.Entries == 0 then UI.label(self:card(), "No shops entered in your neighborhood yet.", 17) end
    for place, entry in ipairs(showcase.Entries) do
        local frame = self:card("#" .. place .. "  " .. entry.Name .. "  •  " .. entry.Votes .. " votes")
        UI.eyebrow(frame, string.upper(entry.Theme .. " • " .. Config.Tiers[entry.Tier].Name))
        local previews = UI.grid(frame, 120, 110)
        for _, item in ipairs(entry.Preview or {}) do self:itemTile(previews, item, "View", function() end) end
        if entry.UserId ~= player.UserId and not showcase.VotedFor then self:button(frame, "Vote for this shop", "Showcase", {Choice = "Vote", UserId = entry.UserId}) end
    end
end

function Pages:eventsPage()
    local events = self.State.Live and self.State.Live.Events or {}
    if #events == 0 then UI.hero(self.UI.Content, "Thrift Street seasons", "A quiet week on the street", "New restoration celebrations are scheduled throughout the year."); return end
    for _, event in ipairs(events) do
        local frame = UI.hero(self.UI.Content, "Limited seasonal event", event.Name, event.Description)
        self:timer(frame, "Event ends in ", event.Ends)
        local complete = true
        for stat, goal in pairs(event.Goal) do
            local progress = math.min(goal, event.Progress[stat] or 0); complete = complete and progress &gt;= goal
            UI.label(frame, stat .. "  " .. progress .. "/" .. goal, 16); UI.progress(frame, progress / goal)
        end
        UI.eyebrow(frame, "REWARD • " .. event.RewardName)
        if event.Claimed then UI.disabled(frame, "✓ Reward collected") elseif complete then self:button(frame, "Collect event reward", "EventClaim", {Id = event.Id}) end
    end
end

function Pages:boutiquePage()
    local shop = self.State.Live and self.State.Live.Shop or {}
    UI.hero(self.UI.Content, "Cosmetic boutique", "Style with no shortcuts", "Only permanent visual cosmetics appear here. Core progression always stays available through play.")
    if #shop == 0 then UI.label(self:card(), "No Robux cosmetics are configured for this experience yet. In-game themes and decor remain available in your shop.", 17); return end
    for _, item in ipairs(shop) do
        local frame = self:card(item.Name); UI.label(frame, item.Description, 16, UI.Colors.Muted)
        if item.Owned then UI.disabled(frame, "✓ Owned") elseif item.Price then self:button(frame, "Get for R$" .. item.Price, "ShopPurchase", {Kind = item.Kind, Id = item.Id}) else UI.disabled(frame, "Currently unavailable") end
    end
end

function Pages:arrangePage(context)
    local Placement = require(Shared.DecorPlacement); local id = context.Decor; local footprint = Placement.Footprints[id]
    if not footprint then UI.label(self:card(), "This piece stays on its wall mount.", 17); return end
    local current = self.State.DecorLayout[id] or Placement.Defaults[id]
    local draft = self.Drafts[id] or {X = current.X, Z = current.Z, Rotation = current.Rotation}; self.Drafts[id] = draft
    local frame = self:card("Arrange " .. id)
    UI.label(frame, "Position: " .. draft.X .. ", " .. draft.Z .. "  •  rotation " .. draft.Rotation .. "°", 16)
    local controls = {{"←",-1,0},{"→",1,0},{"↑",0,1},{"↓",0,-1}}
    for _, control in ipairs(controls) do self:button(frame, control[1] .. " Move", "DecorPlace", {Decor=id,X=draft.X+control[2],Z=draft.Z+control[3],Rotation=draft.Rotation}, true) end
    self:button(frame, "Rotate 90°", "DecorPlace", {Decor=id,X=draft.X,Z=draft.Z,Rotation=(draft.Rotation+90)%360}, true)
    self:button(frame, "Reset position", "DecorPlace", {Decor=id,Reset=true}, true)
    UI.label(frame, "Use the controls, then reopen this page to continue arranging from the saved position.", 14, UI.Colors.Muted)
end

function Pages:visitPage(context)
    for _, shop in ipairs(self.State.Shops) do
        if not context.Owner or context.Owner == shop.UserId then
            local frame = self:card(shop.Name .. "'s " .. Config.Tiers[shop.Tier].Name)
            UI.label(frame, "★ " .. string.format("%.1f", shop.Rating) .. "  •  Shop " .. tostring(shop.Plot), 18)
            if shop.UserId ~= player.UserId then for stars=1,5 do self:button(frame,string.rep("★",stars),"Rate",{UserId=shop.UserId,Stars=stars},true) end end
        end
    end
end

function Pages:adminPage()
    if not self.State.IsAdmin then
        UI.label(self:card(), "Admin access is not enabled for this account.", 18); return
    end
    local draft = self.Drafts.Admin or {Target = player.Name, Query = "", Rarity = 5, Cash = "1000", XP = "500", Message = ""}
    self.Drafts.Admin = draft
    local hero = UI.hero(self.UI.Content, "Server administration", "Thrift Flip control room", "Every action is checked on the server and written to the server log. Target a player by username, display name, or user ID.", UI.Colors.Ink)
    UI.eyebrow(hero, "ONLINE PLAYERS")
    for _, shop in ipairs(self.State.Shops or {}) do
        local choice = UI.button(hero, shop.Name .. "  •  Shop tier " .. shop.Tier, function()
            draft.Target = shop.Name; self.Open("Admin")
        end, true)
        choice.Size = UDim2.new(1, 0, 0, 40); choice.TextSize = 14
    end

    local targetCard = self:card("Target player")
    local target = UI.input(targetCard, "Username, display name, or user ID", draft.Target)
    target.FocusLost:Connect(function() draft.Target = target.Text end)

    local itemCard = self:card("Grant a collectible")
    UI.label(itemCard, "Search by name, category, or ID. Leave blank for a random item.", 14, UI.Colors.Muted)
    local query = UI.input(itemCard, "Example: jukebox, chair, radios", draft.Query)
    query.FocusLost:Connect(function() draft.Query = query.Text end)
    local rarityButton = UI.button(itemCard, Config.RarityIcons[draft.Rarity] .. "  Rarity: " .. Config.Rarities[draft.Rarity] .. "  • tap to change", function()
        draft.Query = query.Text; draft.Target = target.Text; draft.Rarity = draft.Rarity % 5 + 1; self.Open("Admin")
    end, true)
    rarityButton.TextColor3 = Color3.fromHex(Config.RarityColors[draft.Rarity])
    UI.button(itemCard, "Grant item and show reveal", function()
        draft.Query = query.Text; draft.Target = target.Text
        self.Send("Admin", {Command = "GiveItem", Target = target.Text, Query = query.Text, Rarity = draft.Rarity})
    end, false)

    local economy = self:card("Economy and progression")
    local cash = UI.input(economy, "Cash amount", draft.Cash, true)
    cash.FocusLost:Connect(function() draft.Cash = cash.Text end)
    local cashRow = UI.row(economy)
    UI.rowButton(cashRow, "+ Add cash", function()
        draft.Target = target.Text; draft.Cash = cash.Text
        self.Send("Admin", {Command = "Cash", Target = target.Text, Amount = tonumber(cash.Text) or 0})
    end, 2, false)
    UI.rowButton(cashRow, "− Remove cash", function()
        draft.Target = target.Text; draft.Cash = cash.Text
        self.Send("Admin", {Command = "Cash", Target = target.Text, Amount = -(tonumber(cash.Text) or 0)})
    end, 2, true)
    local xp = UI.input(economy, "XP amount", draft.XP, true)
    xp.FocusLost:Connect(function() draft.XP = xp.Text end)
    UI.button(economy, "Add XP", function()
        draft.Target = target.Text; draft.XP = xp.Text
        self.Send("Admin", {Command = "XP", Target = target.Text, Amount = tonumber(xp.Text) or 0})
    end, true)

    local playerTools = self:card("Player tools")
    local tutorialRow = UI.row(playerTools)
    UI.rowButton(tutorialRow, "Complete tutorial", function() self.Send("Admin", {Command = "Tutorial", Target = target.Text, Value = 5}) end, 2, true)
    UI.rowButton(tutorialRow, "Reset tutorial", function() self.Send("Admin", {Command = "Tutorial", Target = target.Text, Value = 0}) end, 2, true)
    local utilityRow = UI.row(playerTools)
    UI.rowButton(utilityRow, "Bring to me", function() self.Send("Admin", {Command = "Bring", Target = target.Text}) end, 2, true)
    UI.rowButton(utilityRow, "Heal player", function() self.Send("Admin", {Command = "Heal", Target = target.Text}) end, 2, true)
    local kick = UI.button(playerTools, "Kick player from this server", function() self.Send("Admin", {Command = "Kick", Target = target.Text}) end, true)
    kick.BackgroundColor3 = UI.Colors.Rose; kick.TextColor3 = UI.Colors.White

    local broadcast = self:card("Server announcement")
    local message = UI.input(broadcast, "Announcement (maximum 120 characters)", draft.Message)
    message.FocusLost:Connect(function() draft.Message = string.sub(message.Text, 1, 120) end)
    UI.button(broadcast, "Broadcast announcement", function()
        draft.Message = string.sub(message.Text, 1, 120)
        self.Send("Admin", {Command = "Announce", Target = target.Text, Message = draft.Message})
    end, false)
end

function Pages:settingsPage()
    local frame = self:card("Comfort and accessibility")
    self:button(frame, "Music: " .. (if self.State.Settings.Music then "On" else "Off"), "Settings", {Name="Music",Enabled=not self.State.Settings.Music}, true)
    self:button(frame, "Effects: " .. (if self.State.Settings.Effects then "On" else "Off"), "Settings", {Name="Effects",Enabled=not self.State.Settings.Effects}, true)
    UI.label(frame, "Rarity always uses a symbol and name alongside color. All controls use large touch targets.", 15, UI.Colors.Muted)
    local titles = {}; for title in pairs(self.State.Titles) do table.insert(titles,title) end; table.sort(titles)
    UI.label(frame, "Titles: " .. (if #titles == 0 then "Your story is just beginning" else table.concat(titles, ", ")), 16)
end

function Pages:townPage()
    local hero = UI.hero(self.UI.Content, "Welcome to Thrift Street", "Every treasure deserves a second chance", "Today's favorite style is " .. self.State.Demand .. ", worth 20% more when it finds the right home.")
    for _, link in ipairs({{"Dumpster Alley","Source"},{"Wholesale Source","Estate"},{"Parcel Post","Delivery"},{"Auction House","Auction"},{"Market","Market"},{"Designer Showcase","Showcase"},{"Cosmetic Store","Boutique"},{"Visit neighbors","Visit"},{"Settings","Settings"}}) do self:nav(hero,link[1],link[2]) end
    if self.State.IsAdmin then self:nav(hero, "⚙ Admin control room", "Admin", nil, false) end
end

function Pages:render(page, context)
    context = context or {}; self.UI:clear(page == "Bag" and "Your finds" or page, "THRIFT STREET")
    local handlers = {
        Bag=function() self:inventory(context,"Bag") end, Item=function() self:itemPage(context) end,
        Source=function() self:sourcePage("Dumpster") end, Estate=function() self:sourcePage("Estate") end,
        Delivery=function() self:sourcePage("Delivery") end, Workbench=function() self:inventory(context,"Workbench") end,
        Restore=function() self:restorePage(context) end, Display=function() self:inventory(context,"Display") end,
        Slots=function() self:slotsPage(context) end, Shop=function() self:shopPage() end, Displays=function() self:displaysPage() end,
        Themes=function() self:themesPage() end, Decor=function() self:decorPage() end, Arrange=function() self:arrangePage(context) end,
        Quests=function() self:questsPage() end, Collection=function() self:collectionPage() end, Auction=function() self:auctionPage() end,
        Market=function() self:marketPage() end, List=function() self:listPage() end, ListingEditor=function() self:listingEditor(context) end,
        Trade=function() self:tradePage() end, Showcase=function() self:showcasePage() end, Events=function() self:eventsPage() end,
        Boutique=function() self:boutiquePage() end, Visit=function() self:visitPage(context) end, Settings=function() self:settingsPage() end,
        Admin=function() self:adminPage() end,
        Town=function() self:townPage() end,
    }
    (handlers[page] or handlers.Town)()
end

return Pages
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX31">
          <Properties>
            <string name="Name">UI</string>
            <ProtectedString name="Source">-- Shared visual language for the Thrift Flip client. All art here is vector UI or
-- an in-game model, so menus work without third-party image dependencies.
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UI = {}
UI.Colors = {
    Cream = Color3.fromRGB(255, 248, 232), Panel = Color3.fromRGB(255, 253, 246),
    Ink = Color3.fromRGB(22, 30, 48), Teal = Color3.fromRGB(20, 190, 164),
    Muted = Color3.fromRGB(100, 116, 139), Rose = Color3.fromRGB(246, 96, 114),
    Gold = Color3.fromRGB(255, 190, 55), Line = Color3.fromRGB(218, 226, 238),
    Light = Color3.fromRGB(239, 244, 235), White = Color3.fromRGB(255, 255, 255),
    Wood = Color3.fromRGB(146, 103, 72), Night = Color3.fromRGB(12, 18, 32),
}
local Models, SharedConfig
local function tween(object, properties, duration)
    local animation = TweenService:Create(object, TweenInfo.new(duration or 0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), properties)
    animation:Play(); return animation
end
function UI.corner(object, radius)
    local corner = Instance.new("UICorner"); corner.CornerRadius = UDim.new(0, radius or 12); corner.Parent = object
    return corner
end
function UI.stroke(object, color, thickness, transparency)
    local stroke = Instance.new("UIStroke"); stroke.Color = color or UI.Colors.Line; stroke.Thickness = thickness or 1
    stroke.Transparency = transparency or 0; stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border; stroke.Parent = object
    return stroke
end
function UI.gradient(object, first, second, rotation)
    local gradient = Instance.new("UIGradient"); gradient.Color = ColorSequence.new(first, second)
    gradient.Rotation = rotation or 0; gradient.Parent = object; return gradient
end
function UI.padding(object, horizontal, vertical)
    local p = Instance.new("UIPadding")
    p.PaddingLeft = UDim.new(0, horizontal or 12); p.PaddingRight = p.PaddingLeft
    p.PaddingTop = UDim.new(0, vertical or horizontal or 12); p.PaddingBottom = p.PaddingTop; p.Parent = object
    return p
end
function UI.label(parent, text, size, color)
    local label = Instance.new("TextLabel"); label.Name = "Label"; label.Text = text; label.TextSize = size or 17
    label.Font = Enum.Font.GothamMedium; label.TextColor3 = color or UI.Colors.Ink
    label.TextXAlignment = Enum.TextXAlignment.Left; label.TextYAlignment = Enum.TextYAlignment.Center
    label.BackgroundTransparency = 1; label.Size = UDim2.new(1, 0, 0, (size or 17) + 8)
    label.TextWrapped = true; label.AutomaticSize = Enum.AutomaticSize.Y; label.Parent = parent
    return label
end
function UI.eyebrow(parent, text, color)
    local label = UI.label(parent, string.upper(text), 12, color or UI.Colors.Muted)
    label.Font = Enum.Font.GothamBold; return label
end
function UI.button(parent, text, callback, secondary)
    local button = Instance.new("TextButton"); button.Name = "Button"; button.Text = text
    button.Font = Enum.Font.GothamBold; button.TextSize = 16; button.TextWrapped = true
    button.TextColor3 = if secondary then UI.Colors.Ink else UI.Colors.Panel
    button.BackgroundColor3 = if secondary then UI.Colors.Light else UI.Colors.Teal
    button.Size = UDim2.new(1, 0, 0, 50); button.AutoButtonColor = false; button.Parent = parent
    UI.corner(button, 14); UI.padding(button, 10, 3)
    UI.stroke(button, if secondary then UI.Colors.Line else UI.Colors.White, 1, if secondary then 0.15 else 0.72)
    if not secondary then UI.gradient(button, Color3.fromRGB(16, 202, 171), Color3.fromRGB(20, 154, 213), 15) end
    local scale = Instance.new("UIScale"); scale.Parent = button
    local baseColor = button.BackgroundColor3
    button.MouseEnter:Connect(function() tween(button, {BackgroundColor3 = baseColor:Lerp(UI.Colors.Gold, 0.12)}) end)
    button.MouseLeave:Connect(function() tween(button, {BackgroundColor3 = baseColor}) end)
    button.SelectionGained:Connect(function() tween(button, {BackgroundColor3 = baseColor:Lerp(UI.Colors.Gold, 0.2)}) end)
    button.SelectionLost:Connect(function() tween(button, {BackgroundColor3 = baseColor}) end)
    button.Activated:Connect(function(...)
        scale.Scale = 0.96; tween(scale, {Scale = 1}, 0.14)
        if UI.OnClick then UI.OnClick() end
        callback(...)
    end)
    return button
end
function UI.disabled(parent, text)
    local label = UI.label(parent, text, 15, UI.Colors.Muted)
    label.Size = UDim2.new(1, 0, 0, 44); label.TextXAlignment = Enum.TextXAlignment.Center
    label.BackgroundColor3 = UI.Colors.Light; label.BackgroundTransparency = 0.4; UI.corner(label, 10)
    return label
end
function UI.input(parent, placeholder, value, numeric)
    local field = Instance.new("TextBox"); field.Name = "Input"; field.Size = UDim2.new(1, 0, 0, 48)
    field.BackgroundColor3 = UI.Colors.White; field.TextColor3 = UI.Colors.Ink; field.PlaceholderColor3 = UI.Colors.Muted
    field.PlaceholderText = placeholder; field.Text = value or ""; field.ClearTextOnFocus = false
    field.Font = Enum.Font.GothamMedium; field.TextSize = 16; field.TextXAlignment = Enum.TextXAlignment.Left
    field.Parent = parent; UI.corner(field, 10); UI.stroke(field); UI.padding(field, 12, 4)
    if numeric then
        field:GetPropertyChangedSignal("Text"):Connect(function()
            local cleaned = string.gsub(field.Text, "[^0-9]", "")
            if cleaned ~= field.Text then field.Text = cleaned end
        end)
    end
    return field
end
function UI.list(parent, gap)
    local layout = Instance.new("UIListLayout"); layout.Padding = UDim.new(0, gap or 10)
    layout.SortOrder = Enum.SortOrder.LayoutOrder; layout.Parent = parent; return layout
end
function UI.row(parent, height, gap)
    local row = Instance.new("Frame"); row.Name = "Row"; row.Size = UDim2.new(1, 0, 0, height or 48)
    row.BackgroundTransparency = 1; row.Parent = parent
    local layout = UI.list(row, gap or 8); layout.FillDirection = Enum.FillDirection.Horizontal
    layout.VerticalAlignment = Enum.VerticalAlignment.Center
    return row
end
function UI.rowButton(row, text, callback, count, secondary)
    local button = UI.button(row, text, callback, secondary)
    button.Size = UDim2.new(1 / count, -8 * (count - 1) / count, 1, 0)
    return button
end
function UI.card(parent)
    local frame = Instance.new("Frame"); frame.Name = "Card"
    frame.Size = UDim2.new(1, -2, 0, 0); frame.AutomaticSize = Enum.AutomaticSize.Y
    frame.BackgroundColor3 = UI.Colors.Panel; frame.Parent = parent; UI.corner(frame, 16)
    UI.stroke(frame, Color3.fromRGB(205, 215, 201), 1, 0.2); UI.padding(frame, 18, 16); UI.list(frame, 10)
    return frame
end
function UI.hero(parent, kicker, title, body, color)
    local frame = UI.card(parent); frame.BackgroundColor3 = color or UI.Colors.Ink
    if not color then UI.gradient(frame, Color3.fromRGB(19, 31, 55), Color3.fromRGB(25, 95, 109), 20) end
    UI.eyebrow(frame, kicker, UI.Colors.Cream)
    local heading = UI.label(frame, title, 28, UI.Colors.Panel); heading.Font = Enum.Font.GothamBold
    if body and body ~= "" then UI.label(frame, body, 16, UI.Colors.Cream) end
    return frame
end
function UI.pill(parent, text, color)
    local label = UI.label(parent, text, 13, color or UI.Colors.Teal)
    label.Font = Enum.Font.GothamBold; label.AutomaticSize = Enum.AutomaticSize.X
    label.Size = UDim2.fromOffset(0, 28); label.TextWrapped = false; label.BackgroundTransparency = 0
    label.BackgroundColor3 = (color or UI.Colors.Teal):Lerp(UI.Colors.Panel, 0.87)
    UI.padding(label, 10, 2); UI.corner(label, 8); return label
end
function UI.progress(parent, fraction, color)
    local track = Instance.new("Frame"); track.Name = "Progress"; track.Size = UDim2.new(1, 0, 0, 8)
    track.BackgroundColor3 = UI.Colors.Line; track.BorderSizePixel = 0; track.Parent = parent; UI.corner(track, 6)
    local fill = Instance.new("Frame"); fill.Name = "Fill"; fill.Size = UDim2.fromScale(math.clamp(fraction, 0, 1), 1)
    fill.BackgroundColor3 = color or UI.Colors.Teal; fill.BorderSizePixel = 0; fill.Parent = track; UI.corner(fill, 6)
    return fill
end
function UI.grid(parent, cellHeight, minimumWidth)
    local frame = Instance.new("Frame"); frame.Name = "Grid"; frame.Size = UDim2.new(1, 0, 0, 0)
    frame.BackgroundTransparency = 1; frame.Parent = parent
    local layout = Instance.new("UIGridLayout"); layout.CellPadding = UDim2.fromOffset(10, 10)
    layout.SortOrder = Enum.SortOrder.LayoutOrder; layout.Parent = frame
    local updating = false
    local function resize()
        if updating then return end
        updating = true
        local width = frame.AbsoluteSize.X
        local columns = math.max(1, math.floor((width + 10) / (minimumWidth or 190)))
        local count = 0; for _, child in ipairs(frame:GetChildren()) do if child:IsA("GuiObject") then count += 1 end end
        layout.CellSize = UDim2.new(1 / columns, -10 * (columns - 1) / columns, 0, cellHeight)
        frame.Size = UDim2.new(1, 0, 0, math.max(0, math.ceil(count / columns) * (cellHeight + 10) - 10))
        updating = false
    end
    frame:GetPropertyChangedSignal("AbsoluteSize"):Connect(resize)
    frame.ChildAdded:Connect(resize); frame.ChildRemoved:Connect(resize); task.defer(resize)
    return frame
end
function UI.preview(parent, definition, item, height, hidden)
    local viewport = Instance.new("ViewportFrame"); viewport.Name = "ItemPreview"
    local rarityColor = if item and item.Inspected and item.Rarity and SharedConfig
        then Color3.fromHex(SharedConfig.RarityColors[item.Rarity]) else nil
    if item and item.Inspected and item.Rarity and not SharedConfig then
        SharedConfig = require(ReplicatedStorage.Shared.Config)
        rarityColor = Color3.fromHex(SharedConfig.RarityColors[item.Rarity])
    end
    viewport.Size = UDim2.new(1, 0, 0, height or 180); viewport.BackgroundColor3 = UI.Colors.Light
    viewport.Ambient = Color3.fromRGB(128, 143, 159); viewport.LightColor = Color3.fromRGB(255, 242, 216)
    viewport.LightDirection = Vector3.new(-1.4, -1.8, -1); viewport.Parent = parent; UI.corner(viewport, 12)
    if rarityColor then
        UI.gradient(viewport, Color3.fromRGB(250, 247, 237), rarityColor:Lerp(Color3.fromRGB(237, 244, 247), 0.72), 35)
        UI.stroke(viewport, rarityColor, if item.Rarity &gt;= 4 then 2 else 1, if item.Rarity &gt;= 4 then 0.12 else 0.42)
    else
        UI.gradient(viewport, Color3.fromRGB(247, 241, 228), Color3.fromRGB(203, 225, 224), 35)
    end
    local world = Instance.new("WorldModel"); world.Parent = viewport
    local camera = Instance.new("Camera"); camera.FieldOfView = 35; camera.Parent = viewport; viewport.CurrentCamera = camera
    if hidden then
        local box = Instance.new("Part"); box.Size = Vector3.new(2.5, 2, 2.2); box.Anchored = true
        box.Color = UI.Colors.Wood; box.Material = Enum.Material.Wood; box.Parent = world
        for offset = -1, 1, 2 do
            local tape = Instance.new("Part"); tape.Size = Vector3.new(0.25, 2.03, 2.23); tape.Position = Vector3.new(offset * 0.6, 0, 0)
            tape.Color = UI.Colors.Gold; tape.Anchored = true; tape.Parent = world
        end
        camera.CFrame = CFrame.lookAt(Vector3.new(5, 3.5, -6), Vector3.zero)
        local label = UI.label(viewport, "?", 46, UI.Colors.Cream); label.Size = UDim2.fromScale(1, 1)
        label.AutomaticSize = Enum.AutomaticSize.None; label.TextXAlignment = Enum.TextXAlignment.Center; label.Font = Enum.Font.GothamBlack
        return viewport
    end
    local ok, model = pcall(function()
        if not Models then
            Models = require(ReplicatedStorage.Shared:WaitForChild("ItemModels"))
            SharedConfig = require(ReplicatedStorage.Shared.Config)
        end
        return Models.create(world, definition, item, CFrame.new(), SharedConfig)
    end)
    if ok and model then
        local cf, size = model:GetBoundingBox()
        local diameter = math.max(size.X, size.Y, size.Z, 1)
        local shadow = Instance.new("Part"); shadow.Name = "ProductShadow"; shadow.Shape = Enum.PartType.Cylinder
        shadow.Size = Vector3.new(0.025, diameter * 1.15, diameter * 1.15)
        shadow.CFrame = CFrame.new(cf.Position.X, cf.Position.Y - size.Y / 2 - 0.04, cf.Position.Z) * CFrame.Angles(0, 0, math.pi / 2)
        shadow.Color = Color3.fromRGB(45, 58, 64); shadow.Material = Enum.Material.SmoothPlastic
        shadow.Transparency = 0.72; shadow.Anchored = true; shadow.CanCollide = false; shadow.CanQuery = false; shadow.Parent = world
        camera.FieldOfView = 30
        camera.CFrame = CFrame.lookAt(cf.Position + Vector3.new(diameter * 1.35, diameter * 0.78, -diameter * 2.05), cf.Position + Vector3.new(0, size.Y * 0.05, 0))
        -- Rotate only while the player drags the preview, never in a render loop.
        local rotating, lastX = false, 0
        viewport.Active = true
        viewport.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                rotating = true; lastX = input.Position.X
            end
        end)
        viewport.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then rotating = false end
        end)
        viewport.InputChanged:Connect(function(input)
            if rotating and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                local delta = input.Position.X - lastX; lastX = input.Position.X
                model:PivotTo(CFrame.new(cf.Position) * CFrame.Angles(0, delta * 0.012, 0) * CFrame.new(-cf.Position) * model:GetPivot())
            end
        end)
    else
        local label = UI.label(viewport, definition and definition.Name or "Your find", 20, UI.Colors.Teal)
        label.Size = UDim2.fromScale(1, 1); label.AutomaticSize = Enum.AutomaticSize.None; label.TextXAlignment = Enum.TextXAlignment.Center
        warn("Item preview failed: " .. tostring(model))
    end
    return viewport
end
