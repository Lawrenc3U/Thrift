      <Item class="ModuleScript" referent="RBX19">
        <Properties>
          <string name="Name">Profile</string>
          <ProtectedString name="Source">local Profile = {}
function Profile.new()
    return {
        Version = 2, Cash = 75, XP = 0, Tier = 1, Tool = 0,
        Inventory = {}, Collection = {}, Themes = {Cozy = true}, Theme = "Cozy",
        Stats = {Found = 0, Restored = 0, Sold = 0, Earned = 0},
        Tutorial = 0, LastDelivery = -1, Daily = {Day = -1, Claimed = {}},
        Login = {Day = -2, Streak = 0, ClaimedDay = -2},
        Weekly = {Week = -1, Restored = 0, Sold = 0, Claimed = false},
        Decorations = {}, PlacedDecor = {}, DecorLayout = {}, Reputation = 0, RatingTotal = 0, RatingCount = 0, Rated = {},
        Settings = {Music = true, Effects = true}, Titles = {},
        AppliedReceipts = {}, Exchange = {Pending = false},
    }
end
function Profile.reconcile(data)
    assert(type(data) == "table", "Profile data is not a table")
    local version = data.Version or 1
    assert(type(version) == "number" and version &gt;= 1 and version &lt;= 2, "Unsupported profile schema version")
    if data.Cash ~= nil then
        assert(type(data.Cash) == "number" and data.Cash == data.Cash and data.Cash &gt;= 0 and data.Cash &lt; math.huge, "Invalid saved cash")
    end
    if data.Inventory ~= nil then assert(type(data.Inventory) == "table", "Invalid saved inventory") end
    local defaults = Profile.new()
    local function merge(target, template)
        for key, value in pairs(template) do
            if target[key] == nil then
                target[key] = if type(value) == "table" then table.clone(value) else value
            elseif type(value) == "table" and type(target[key]) == "table" then
                merge(target[key], value)
            end
        end
    end
    merge(data, defaults)
    data.Version = 2
    return data
end
return Profile
</ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="RBX6">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="RBX7">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="RBX20">
        <Properties>
          <string name="Name">DataService</string>
          <ProtectedString name="Source">local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Profile = require(Shared.Profile)
local DataService = {}
DataService.__index = DataService
local function copy(value)
    if type(value) ~= "table" then return value end
    local result = {}
    for key, child in pairs(value) do result[key] = copy(child) end
    return result
end
function DataService.new()
    local self = setmetatable({}, DataService)
    self.Token = game.JobId .. ":" .. HttpService:GenerateGUID(false)
    self.Profiles = {}
    self.Busy = {}
    self.Closing = {}
    self.ExchangeLocks = {}
    self.MutationLocks = {}
    -- Explicit opt-in only. API failures must never silently create disposable profiles.
    self.Ephemeral = RunService:IsStudio() and (Config.StudioPracticeMode or workspace:GetAttribute("ThriftEphemeral") == true)
    if not self.Ephemeral then
        self.Store = DataStoreService:GetDataStore("ThriftFlip_Profiles_v1")
        self.Backup = DataStoreService:GetDataStore("ThriftFlip_Backups_v1")
    end
    return self
end
function DataService:retry(callback)
    local lastError
    for attempt = 1, 4 do
        local ok, result = pcall(callback)
        if ok then return true, result end
        lastError = result
        task.wait(math.min(8, 2 ^ (attempt - 1)))
    end
    warn("Thrift data operation failed: " .. tostring(lastError))
    return false, nil
end
function DataService:load(userId)
    if self.Ephemeral then
        self.Profiles[userId] = Profile.new()
        return self.Profiles[userId]
    end
    local blocked = false
    local ok, record = self:retry(function()
        blocked = false
        return self.Store:UpdateAsync("p_" .. userId, function(current)
            current = current or {Data = Profile.new()}
            local lock = current.Lock
            if lock and lock.Token ~= self.Token and lock.Expires &gt; os.time() then
                blocked = true
                return nil
            end
            current.Data = Profile.reconcile(current.Data)
            current.Lock = {Token = self.Token, Expires = os.time() + Config.SessionLease}
            return current
        end)
    end)
    if not ok or blocked or not record then return nil end
    self.Profiles[userId] = Profile.reconcile(record.Data)
    return self.Profiles[userId]
end
function DataService:save(userId, release)
    if not self.Profiles[userId] then return false end
    if self.Busy[userId] then return false end
    self.Busy[userId] = true
    local snapshot = copy(self.Profiles[userId])
    local savedAt = os.time()
    local lostLock = false
    local ok = true
    if not self.Ephemeral then
        ok = self:retry(function()
            lostLock = false
            return self.Store:UpdateAsync("p_" .. userId, function(current)
                if not current or not current.Lock or current.Lock.Token ~= self.Token then
                    lostLock = true
                    return nil
                end
                return {Data = snapshot, SavedAt = savedAt,
                    Lock = if release then nil else {Token = self.Token, Expires = os.time() + Config.SessionLease}}
            end)
        end)
        if ok and not lostLock then
            -- Separate recovery copy. Main UpdateAsync versions also remain available.
            task.spawn(function()
                self:retry(function()
                    self.Backup:UpdateAsync("p_" .. userId, function(old)
                        if old and old.SavedAt &gt;= savedAt then return nil end
                        return {Data = snapshot, SavedAt = savedAt}
                    end)
                end)
            end)
        end
    end
    self.Busy[userId] = nil
    return ok and not lostLock
end
function DataService:release(userId)
    if self.Closing[userId] then
        while self.Closing[userId] do task.wait(0.1) end
        return true
    end
    self.Closing[userId] = true
    while self.Busy[userId] or self.ExchangeLocks[userId] or self.MutationLocks[userId] do task.wait(0.1) end
    local ok = self:save(userId, true)
    self.Profiles[userId] = nil
    self.Closing[userId] = nil
    return ok
end
return DataService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX21">
        <Properties>
          <string name="Name">ExchangeService</string>
          <ProtectedString name="Source">-- Same-server player listings and confirmed trades. A durable two-phase journal
-- makes both profiles recoverable if the process stops between participant saves.
-- No offline/global marketplace: a seller must be in this town to list or sell.
local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Economy = require(Shared.Economy)
local ExchangeRules = require(Shared.ExchangeRules)
local ExchangeService = {}
ExchangeService.__index = ExchangeService
local copy = ExchangeRules.copy
local MIN_LEVEL = 3
local MAX_LISTINGS = 6
local MAX_TRADE_ITEMS = 4
local PRICE_CAP = 1000000
local CASH_CAP = 1000000
local FEE_RATE = 0.03
local TRADE_REVIEW = 3
local TRADE_COOLDOWN = 15
local function memoryStore()
    local records = {}
    return {UpdateAsync = function(_, key, transform)
        local result = transform(copy(records[key]))
        if result ~= nil then records[key] = copy(result) end
        return copy(result)
    end}
end
function ExchangeService.new(data, service, options)
    options = options or {}
    data.ExchangeLocks = data.ExchangeLocks or {}
    data.MutationLocks = data.MutationLocks or {}
    return setmetatable({Data = data, Service = service,
        Store = options.Store or (if data.Ephemeral then memoryStore() else DataStoreService:GetDataStore("ThriftFlip_ExchangeJournal_v1")),
        Clock = options.Clock or os.time,
        Guid = options.Guid or function() return HttpService:GenerateGUID(false) end,
        Listings = {}, Trades = {}, PlayerTrades = {}, Cooldowns = {},
        Capacity = Config.InventoryLimit, LastTick = 0}, ExchangeService)
end
function ExchangeService:_notice(player, message)
    if player and player.Parent then self.Service:notify(player, message) end
end
function ExchangeService:_broadcast()
    self.Service:broadcast()
end
function ExchangeService:_journal(id, transform)
    return self.Data:retry(function()
        return self.Store:UpdateAsync("x_" .. id, transform)
    end)
end
function ExchangeService:_save(userId)
    local deadline = os.clock() + 20
    while self.Data.Busy[userId] and os.clock() &lt; deadline do task.wait(0.05) end
    if self.Data.Busy[userId] then return false end
    return self.Data:save(userId, false)
end
function ExchangeService:_fault(userIds, id)
    -- Disallow gameplay before yielding locks to PlayerRemoving. Persisting the
    -- pending marker/receipt again during release is safe even after a timeout.
    for _, userId in ipairs(userIds) do
        self.Service.Ready[userId] = nil
        if self.Data.ExchangeLocks[userId] == id then self.Data.ExchangeLocks[userId] = nil end
    end
    for _, userId in ipairs(userIds) do
        local player = Players:GetPlayerByUserId(userId)
        if player then player:Kick("Your exchange is safely queued for recovery. Please rejoin shortly; do not repeat the purchase.") end
    end
end
function ExchangeService:_finishSide(userId, transaction)
    local profile = self.Data.Profiles[userId]
    local side = ExchangeRules.side(transaction, userId)
    if not profile or not side then return false end
    local marker = ExchangeRules.ensure(profile)
    if transaction.Status == "ABORTED" then
        if marker.Pending == transaction.Id then marker.Pending = nil end
        return self:_save(userId)
    end
    if transaction.Status ~= "COMMITTED" and transaction.Status ~= "COMPLETE" then return false end
    if not transaction.Acks[tostring(userId)] then
        local applied = ExchangeRules.apply(profile, transaction, side, self.Capacity)
        if not applied or not self:_save(userId) then return false end
        local ok, updated = self:_journal(transaction.Id, function(record)
            if not record or (record.Status ~= "COMMITTED" and record.Status ~= "COMPLETE") then return nil end
            record.Acks[tostring(userId)] = true
            if ExchangeRules.allAcknowledged(record) then record.Status = "COMPLETE"; record.CompletedAt = self.Clock() end
            return record
        end)
        if not ok or not updated or not updated.Acks[tostring(userId)] then return false end
    end
    -- Receipt remains as LastApplied until a later exchange. The durable journal
    -- acknowledgement means an old callback can never apply this side again.
    marker.Pending = nil
    return self:_save(userId)
end
function ExchangeService:recover(userId)
    local profile = self.Data.Profiles[userId]
    if not profile then return false end
    local marker = ExchangeRules.ensure(profile)
    local id = marker.Pending
    if not id then return true end
    if self.Data.MutationLocks[userId] or self.Data.ExchangeLocks[userId] then return false end
    self.Data.ExchangeLocks[userId] = id
    -- Called only after DataService acquired this profile's session lock and
    -- before the player is Ready. An old process can no longer save this side.
    local ok, transaction = self:_journal(id, function(record)
        if not record or not ExchangeRules.side(record, userId) then return nil end
        if record.Status == "PREPARING" then record.Status = "ABORTED"; record.AbortedAt = self.Clock() end
        return record
    end)
    local completed = ok and transaction and self:_finishSide(userId, transaction)
    self.Data.ExchangeLocks[userId] = nil
    return completed == true
end
function ExchangeService:_transaction(kind, sides)
    local id = self.Guid()
    local users = {}
    -- Acquiring these in-memory locks contains no yields; actions, autosaves and
    -- commerce all honor the same profile ownership/locking contracts.
    for _, side in ipairs(sides) do
        local profile = self.Data.Profiles[side.UserId]
        if not profile or self.Data.Closing[side.UserId] or self.Data.MutationLocks[side.UserId]
            or self.Data.ExchangeLocks[side.UserId] or ExchangeRules.ensure(profile).Pending then return false end
        table.insert(users, side.UserId)
    end
    for _, userId in ipairs(users) do self.Data.ExchangeLocks[userId] = id end
    local proposal = {Id = id, Kind = kind, Status = "PREPARING", CreatedAt = self.Clock(), Owner = self.Data.Token,
        Sides = copy(sides), Prepared = {}, Acks = {}}
    local created, transaction = self:_journal(id, function(old) return old or proposal end)
    if not created or not transaction or transaction.Owner ~= self.Data.Token then
        for _, userId in ipairs(users) do self.Data.ExchangeLocks[userId] = nil end
        return false
    end
    local prepared = true
    for _, userId in ipairs(users) do
        local profile = self.Data.Profiles[userId]
        if not profile or self.Data.Closing[userId] or self.Data.MutationLocks[userId] then prepared = false; break end
        ExchangeRules.ensure(profile).Pending = id
        if not self:_save(userId) then prepared = false; break end
        local ok, record = self:_journal(id, function(current)
            if not current or current.Status ~= "PREPARING" or current.Owner ~= self.Data.Token then return nil end
            current.Prepared[tostring(userId)] = true
            return current
        end)
        if not ok or not record then prepared = false; break end
    end
    local committed, decided = self:_journal(id, function(current)
        if not current then return nil end
        if current.Status ~= "PREPARING" then return current end
        if current.Owner ~= self.Data.Token then return nil end
        local allPrepared = prepared
        for _, side in ipairs(current.Sides) do if not current.Prepared[tostring(side.UserId)] then allPrepared = false end end
        current.Status = if allPrepared then "COMMITTED" else "ABORTED"
        if allPrepared then current.CommittedAt = self.Clock() else current.AbortedAt = self.Clock() end
        return current
    end)
    if not committed or not decided then self:_fault(users, id); return false end
    for _, userId in ipairs(users) do
        if not self:_finishSide(userId, decided) then self:_fault(users, id); return false end
    end
    for _, userId in ipairs(users) do self.Data.ExchangeLocks[userId] = nil end
    return decided.Status == "COMMITTED" or decided.Status == "COMPLETE"
end
function ExchangeService:reservedCash(userId)
    local id = self.PlayerTrades[userId]
    local trade = id and self.Trades[id]
    return if trade then trade.Offers[tostring(userId)].Cash else 0
end
function ExchangeService:itemReserved(userId, uid)
    for _, listing in pairs(self.Listings) do if listing.SellerId == userId and listing.Item.Uid == uid then return true end end
    local id = self.PlayerTrades[userId]
    local trade = id and self.Trades[id]
    if trade then
        for _, itemId in ipairs(trade.Offers[tostring(userId)].Items) do if itemId == uid then return true end end
    end
    return false
end
function ExchangeService:_eligible(player)
    local profile = self.Service:profile(player)
    if not profile then return nil end
    if Economy.level(profile.XP) &lt; MIN_LEVEL or profile.Tutorial &lt; 5 then
        self:_notice(player, "Finish your first sale and reach level 3 to use the player market and trading."); return nil
    end
    if not self.Service.World:near(player, "Market") then self:_notice(player, "Meet at Market Square to exchange finds."); return nil end
    return profile
end
function ExchangeService:_availableItem(userId, uid, profile)
    local item = ExchangeRules.find(profile, uid)
    if not item or not item.Inspected or item.Slot or self:itemReserved(userId, uid) then return nil end
    if self.Service:isHeld(userId, uid) then return nil end
    local session = self.Service.Sessions[userId]
    if session and session.Uid == uid then return nil end
    return item
end
function ExchangeService:list(player, payload)
    local profile = self:_eligible(player)
    if not profile or type(payload.Uid) ~= "string" then return end
    local count = 0; for _, listing in pairs(self.Listings) do if listing.SellerId == player.UserId then count += 1 end end
    if count &gt;= MAX_LISTINGS then return self:_notice(player, "You can list up to six finds at a time.") end
    local item = self:_availableItem(player.UserId, payload.Uid, profile)
    if not item then return self:_notice(player, "Choose an inspected item from your bag that is not reserved.") end
    local cap = math.min(PRICE_CAP, math.max(100, self.Service:value(profile, item) * 10))
    if not Economy.validAmount(payload.Price, 1, cap) then return self:_notice(player, "Choose a whole-dollar price between $1 and $" .. cap .. ".") end
    local fee = math.max(1, math.ceil(payload.Price * FEE_RATE))
    if self.Service:spendable(player, profile) &lt; fee then return self:_notice(player, "The listing fee is $" .. fee .. ".") end
    profile.Cash -= fee
    local id = self.Guid()
    self.Listings[id] = {Id = id, SellerId = player.UserId, SellerName = player.DisplayName,
        Item = copy(item), Price = payload.Price, Fee = fee, Expires = self.Clock() + 1800}
    self:_notice(player, "Listed for this town. The 3% listing fee is not refundable."); self:_broadcast()
end
function ExchangeService:cancelListing(player, payload)
    local listing = self.Listings[payload.ListingId]
    if not listing or listing.SellerId ~= player.UserId or listing.Busy then return end
    self.Listings[payload.ListingId] = nil; self:_broadcast()
end
function ExchangeService:buy(player, payload)
    local buyer = self:_eligible(player)
    if not buyer then return end
    local listing = self.Listings[payload.ListingId]
    if not listing or listing.Busy or listing.Expires &lt;= self.Clock() or listing.SellerId == player.UserId then return end
    local sellerPlayer = Players:GetPlayerByUserId(listing.SellerId)
    local seller = sellerPlayer and self.Service:profile(sellerPlayer)
    if not seller then return self:_notice(player, "That seller is no longer available.") end
    local item = ExchangeRules.find(seller, listing.Item.Uid)
    if not item or item.Slot then self.Listings[listing.Id] = nil; return self:_broadcast() end
    if self.Service:spendable(player, buyer) &lt; listing.Price then return self:_notice(player, "Not enough available cash.") end
    if #buyer.Inventory &gt;= self.Capacity then return self:_notice(player, "Make a little room in your bag first.") end
    listing.Busy = true
    local success = self:_transaction("Market", {
        {UserId = player.UserId, CashDelta = -listing.Price, Outgoing = {}, Incoming = {copy(item)}},
        {UserId = sellerPlayer.UserId, CashDelta = listing.Price, Outgoing = {item.Uid}, Incoming = {}},
    })
    if success then
        self.Listings[listing.Id] = nil
        self:_notice(player, "A wonderful find! Your purchase is in your bag.")
        self:_notice(sellerPlayer, "Your market listing sold for $" .. listing.Price .. "!")
    else listing.Busy = nil end
    self:_broadcast()
end
function ExchangeService:_tradeFor(player, id)
    if type(id) ~= "string" or self.PlayerTrades[player.UserId] ~= id then return nil end
    return self.Trades[id]
end
function ExchangeService:_resetConfirmations(trade)
    trade.Revision += 1; trade.ConfirmAfter = self.Clock() + TRADE_REVIEW
    for _, offer in pairs(trade.Offers) do offer.Confirmed = false end
end
function ExchangeService:invite(player, payload)
    local profile = self:_eligible(player)
    if not profile or not Economy.validAmount(payload.UserId, 1, 9007199254740991) or payload.UserId == player.UserId then return end
    if self.PlayerTrades[player.UserId] or self.PlayerTrades[payload.UserId] then return self:_notice(player, "One of you is already considering a trade.") end
    if self.Clock() &lt; (self.Cooldowns[player.UserId] or 0) or self.Clock() &lt; (self.Cooldowns[payload.UserId] or 0) then return self:_notice(player, "Give your last trade a moment before starting another.") end
    local other = Players:GetPlayerByUserId(payload.UserId)
    local otherProfile = other and self.Service:profile(other)
    if not otherProfile or Economy.level(otherProfile.XP) &lt; MIN_LEVEL or otherProfile.Tutorial &lt; 5
        or not self.Service.World:near(other, "Market") then return self:_notice(player, "Both players must meet at Market Square and reach level 3.") end
    local id = self.Guid()
    local trade = {Id = id, InviterId = player.UserId, A = player.UserId, B = other.UserId,
        Names = {[tostring(player.UserId)] = player.DisplayName, [tostring(other.UserId)] = other.DisplayName},
        Status = "Invited", Ends = self.Clock() + 45, Revision = 1, ConfirmAfter = self.Clock() + TRADE_REVIEW,
        Offers = {[tostring(player.UserId)] = {Cash = 0, Items = {}, Confirmed = false},
            [tostring(other.UserId)] = {Cash = 0, Items = {}, Confirmed = false}}}
    self.Trades[id] = trade; self.PlayerTrades[player.UserId] = id; self.PlayerTrades[other.UserId] = id
    self:_notice(other, player.DisplayName .. " invited you to trade. Open Market Square."); self:_broadcast()
end
function ExchangeService:respond(player, payload)
    local trade = self:_tradeFor(player, payload.TradeId)
    if not trade or trade.Status ~= "Invited" or trade.InviterId == player.UserId or trade.Ends &lt;= self.Clock() then return end
    if payload.Accept ~= true then return self:cancelTrade(player, payload) end
    if not self:_eligible(player) then return end
    trade.Status = "Open"; trade.Ends = self.Clock() + 180; self:_resetConfirmations(trade); self:_broadcast()
end
function ExchangeService:offer(player, payload)
    local trade = self:_tradeFor(player, payload.TradeId)
    local profile = self:_eligible(player)
    if not trade or not profile or trade.Status ~= "Open" or trade.Ends &lt;= self.Clock() then return end
    local offer = trade.Offers[tostring(player.UserId)]
    if payload.Cash ~= nil then
        if not Economy.validAmount(payload.Cash, 0, CASH_CAP) or payload.Cash &gt; self.Service:spendable(player, profile) + offer.Cash then
            return self:_notice(player, "Choose an amount within your available cash.")
        end
        offer.Cash = payload.Cash
    elseif type(payload.Uid) == "string" and type(payload.Add) == "boolean" then
        local index = table.find(offer.Items, payload.Uid)
        if payload.Add then
            if index then return end
            if #offer.Items &gt;= MAX_TRADE_ITEMS then return self:_notice(player, "Each player can offer up to four items.") end
            if not self:_availableItem(player.UserId, payload.Uid, profile) then return self:_notice(player, "That item cannot be offered right now.") end
            table.insert(offer.Items, payload.Uid)
        elseif index then table.remove(offer.Items, index) else return end
    else return end
    self:_resetConfirmations(trade); self:_broadcast()
end
function ExchangeService:_removeTrade(trade)
    self.Trades[trade.Id] = nil
    self.PlayerTrades[trade.A] = nil; self.PlayerTrades[trade.B] = nil
    self.Cooldowns[trade.A] = self.Clock() + TRADE_COOLDOWN
    self.Cooldowns[trade.B] = self.Clock() + TRADE_COOLDOWN
end
function ExchangeService:cancelTrade(player, payload)
    local trade = self:_tradeFor(player, payload.TradeId)
    if not trade or trade.Status == "Processing" then return end
    self:_removeTrade(trade); self:_broadcast()
end
function ExchangeService:confirm(player, payload)
    local trade = self:_tradeFor(player, payload.TradeId)
    if not trade or trade.Status ~= "Open" or trade.Ends &lt;= self.Clock() or not self:_eligible(player) then return end
    if not Economy.validAmount(payload.Revision, 1, 1000000) or payload.Revision ~= trade.Revision then
        return self:_notice(player, "The offer changed. Review both sides before confirming again.")
    end
    if self.Clock() &lt; trade.ConfirmAfter then return self:_notice(player, "Review both sides for three seconds after the last change.") end
    local own = trade.Offers[tostring(player.UserId)]
    own.Confirmed = true
    local aOffer, bOffer = trade.Offers[tostring(trade.A)], trade.Offers[tostring(trade.B)]
    if not aOffer.Confirmed or not bOffer.Confirmed then return self:_broadcast() end
    local aPlayer, bPlayer = Players:GetPlayerByUserId(trade.A), Players:GetPlayerByUserId(trade.B)
    local a = aPlayer and self.Service:profile(aPlayer); local b = bPlayer and self.Service:profile(bPlayer)
    if not a or not b or not self.Service.World:near(aPlayer, "Market") or not self.Service.World:near(bPlayer, "Market") then
        self:_removeTrade(trade); return self:_broadcast()
    end
    if #aOffer.Items + #bOffer.Items == 0 and aOffer.Cash + bOffer.Cash == 0 then
        self:_resetConfirmations(trade); self:_notice(player, "Add a find or some cash before confirming."); return self:_broadcast()
    end
    if a.Cash &lt; aOffer.Cash or b.Cash &lt; bOffer.Cash then self:_resetConfirmations(trade); return self:_broadcast() end
    -- AvailableCash excludes this offer and any auction reservation; adding the
    -- offer back validates the money without consuming someone else's hold.
    if self.Service:spendable(aPlayer, a) &lt; 0 or self.Service:spendable(bPlayer, b) &lt; 0 then self:_resetConfirmations(trade); return self:_broadcast() end
    if #a.Inventory - #aOffer.Items + #bOffer.Items &gt; self.Capacity or #b.Inventory - #bOffer.Items + #aOffer.Items &gt; self.Capacity then
        self:_notice(player, "One bag has no room for the proposed exchange."); self:_resetConfirmations(trade); return self:_broadcast()
    end
    local aItems, bItems = {}, {}
    for _, uid in ipairs(aOffer.Items) do
        local item = ExchangeRules.find(a, uid); if not item or item.Slot then self:_removeTrade(trade); return self:_broadcast() end
        table.insert(aItems, copy(item))
    end
    for _, uid in ipairs(bOffer.Items) do
        local item = ExchangeRules.find(b, uid); if not item or item.Slot then self:_removeTrade(trade); return self:_broadcast() end
        table.insert(bItems, copy(item))
    end
    trade.Status = "Processing"; self:_broadcast()
    local success = self:_transaction("Trade", {
        {UserId = trade.A, CashDelta = bOffer.Cash - aOffer.Cash, Outgoing = copy(aOffer.Items), Incoming = bItems},
        {UserId = trade.B, CashDelta = aOffer.Cash - bOffer.Cash, Outgoing = copy(bOffer.Items), Incoming = aItems},
    })
    self:_removeTrade(trade)
    if success then self:_notice(aPlayer, "Trade complete. Enjoy your new finds!"); self:_notice(bPlayer, "Trade complete. Enjoy your new finds!") end
    self:_broadcast()
end
function ExchangeService:snapshot(player)
    local listings = {}
    for _, listing in pairs(self.Listings) do
        if not listing.Busy and listing.Expires &gt; self.Clock() then
            local view = copy(listing)
            local seller = self.Data.Profiles[listing.SellerId]
            if seller then view.Item.Value = self.Service:value(seller, view.Item) end
            table.insert(listings, view)
        end
    end
    table.sort(listings, function(a, b) return a.Expires &lt; b.Expires end)
    local view
    local id = self.PlayerTrades[player.UserId]; local trade = id and self.Trades[id]
    if trade then
        local otherId = if trade.A == player.UserId then trade.B else trade.A
        local function offered(userId)
            local original = trade.Offers[tostring(userId)]; local out = {Cash = original.Cash, Confirmed = original.Confirmed, Items = {}}
            local profile = self.Data.Profiles[userId]
            if profile then for _, uid in ipairs(original.Items) do
                local item = ExchangeRules.find(profile, uid)
                if item then local record = copy(item); record.Value = self.Service:value(profile, item); table.insert(out.Items, record) end
            end end
            return out
        end
        view = {Id = trade.Id, PartnerId = otherId, PartnerName = trade.Names[tostring(otherId)],
            InviterId = trade.InviterId, Status = trade.Status, Ends = trade.Ends, Revision = trade.Revision,
            ConfirmAfter = trade.ConfirmAfter, You = offered(player.UserId), Them = offered(otherId)}
    end
    return {Listings = listings, ListingFeeRate = FEE_RATE, PriceCap = PRICE_CAP, MinLevel = MIN_LEVEL,
        MaxListings = MAX_LISTINGS, MaxTradeItems = MAX_TRADE_ITEMS, SameServer = true}, view
end
function ExchangeService:tick()
    local now = self.Clock()
    if now == self.LastTick then return end
    self.LastTick = now
    local changed = false
    for id, listing in pairs(self.Listings) do
        if not listing.Busy and listing.Expires &lt;= now then self.Listings[id] = nil; changed = true end
    end
    for _, trade in pairs(self.Trades) do
        if trade.Status ~= "Processing" and trade.Ends &lt;= now then self:_removeTrade(trade); changed = true end
    end
    if changed then self:_broadcast() end
end
function ExchangeService:leave(userId)
    for id, listing in pairs(self.Listings) do
        if listing.SellerId == userId and not listing.Busy then self.Listings[id] = nil end
    end
    local id = self.PlayerTrades[userId]; local trade = id and self.Trades[id]
    if trade and trade.Status ~= "Processing" then self:_removeTrade(trade) end
end
function ExchangeService:request(player, action, payload)
    local handlers = {
        MarketList = self.list, MarketCancel = self.cancelListing, MarketBuy = self.buy,
        TradeInvite = self.invite, TradeRespond = self.respond, TradeOffer = self.offer,
        TradeConfirm = self.confirm, TradeCancel = self.cancelTrade,
    }
    local handler = handlers[action]
    if not handler then return false end
    handler(self, player, payload)
    return true
end
return ExchangeService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX22">
        <Properties>
          <string name="Name">GameService</string>
          <ProtectedString name="Source">local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Catalog = require(Shared.Catalog)
local Economy = require(Shared.Economy)
local DecorPlacement = require(Shared.DecorPlacement)
local GameService = {}
GameService.__index = GameService
local customers = {
    {Name = "Mabel · Collector", Style = "Antique", Budget = 20000},
    {Name = "Jules · Designer", Style = "Retro", Budget = 10000},
    {Name = "Pip · Pocket money", Style = "Cute", Budget = 180},
    {Name = "Robin · Decorator", Style = "Cozy", Budget = 5000},
    {Name = "Alex · Inventor", Style = "Futuristic", Budget = 6000},
    {Name = "Sam · Bargain hunter", Style = "Retro", Budget = 1000},
    {Name = "Lee · Neighbor", Style = "Cozy", Budget = 600},
    {Name = "Bea · Curator", Style = "Antique", Budget = 40000},
}
local function shallowPublicItem(item)
    if item.Inspected then return table.clone(item) end
    return {Uid = item.Uid, DefId = item.DefId, Inspected = false, Condition = item.Condition}
end
function GameService.new(data, world, event)
    return setmetatable({Data = data, World = world, Event = event,
        Random = Random.new(), Sessions = {}, Offers = {}, Cooldowns = {}, Buckets = {}, TeleportAt = {},
        Held = {},
        Auction = nil, NextAuction = os.time() + 45, NextCustomer = {}, Ready = {},
        Closing = false, JoinedAt = {}, Showcase = {Week = Economy.week(os.time()), Entries = {}, Votes = {}}}, GameService)
end
function GameService:profile(player)
    if not self.Ready[player.UserId] or self.Data.Closing[player.UserId]
        or (self.Data.ExchangeLocks and self.Data.ExchangeLocks[player.UserId])
        or (self.Data.MutationLocks and self.Data.MutationLocks[player.UserId]) then return nil end
    return self.Data.Profiles[player.UserId]
end
function GameService:isAdmin(player)
    if not player then return false end
    if RunService:IsStudio() then return true end
    if tostring(game.CreatorType) == "Enum.CreatorType.User" and player.UserId == game.CreatorId then return true end
    for _, userId in ipairs(Config.AdminUserIds or {}) do if player.UserId == userId then return true end end
    local username = string.lower(player.Name or "")
    for _, allowed in ipairs(Config.AdminUsernames or {}) do
        if username == string.lower(allowed) then return true end
    end
    return false
end
function GameService:adminTarget(requester, value)
    if value == nil or value == "" then return requester end
    local wanted = string.lower(tostring(value))
    for _, candidate in ipairs(Players:GetPlayers()) do
        if tostring(candidate.UserId) == wanted or string.lower(candidate.Name) == wanted
            or string.lower(candidate.DisplayName) == wanted then return candidate end
    end
    return nil
end
function GameService:notify(player, message)
    self.Event:FireClient(player, "Notice", message)
end
function GameService:spendable(player, profile)
    local held = if self.Auction and self.Auction.Bidder == player.UserId then self.Auction.Bid else 0
    if self.Exchange then held += self.Exchange:reservedCash(player.UserId) end
    return profile.Cash - held
end
function GameService:find(profile, uid)
    if type(uid) ~= "string" or #uid &gt; 60 then return nil end
    for index, item in ipairs(profile.Inventory) do if item.Uid == uid then return item, index end end
    return nil
end
function GameService:isHeld(userId, uid)
    return self.Held[userId] == uid
end
function GameService:demandStyle()
    return Config.Styles[Economy.daily(os.time()) % #Config.Styles + 1]
end
function GameService:value(profile, item)
    local definition = Catalog.ById[item.DefId]
    local demand = if (item.Style or definition.Style) == self:demandStyle() then 1.2 else 1
    local bonus = if (item.Style or definition.Style) == profile.Theme then 1.1 else 1
    return Economy.value(definition, item, Config.RarityMultipliers, Config.ConditionMultipliers, demand, bonus)
end
function GameService:resetQuests(profile)
    local day, week = Economy.daily(os.time()), Economy.week(os.time())
    if profile.Daily.Day ~= day then
        profile.Daily = {Day = day, Claimed = {}, Found = 0, Restored = 0, Sold = 0}
    end
    if profile.Weekly.Week ~= week then
        profile.Weekly = {Week = week, Restored = 0, Sold = 0, Claimed = false}
    end
end
function GameService:prepareLogin(profile, day)
    day = day or Economy.daily(os.time())
    profile.Login = profile.Login or {Day = -2, Streak = 0, ClaimedDay = -2}
    if profile.Login.Day ~= day then
        profile.Login.Streak = if profile.Login.Day == day - 1 then math.min(7, profile.Login.Streak + 1) else 1
        profile.Login.Day = day
    end
end
function GameService:stat(profile, name, amount)
    self:resetQuests(profile)
    if self.Live then self.Live:recordStat(profile, name, amount) end
    profile.Stats[name] = (profile.Stats[name] or 0) + amount
    profile.Daily[name] = (profile.Daily[name] or 0) + amount
    profile.Weekly[name] = (profile.Weekly[name] or 0) + amount
    if profile.Stats.Sold &gt;= 10 then profile.Titles.Shopkeeper = true end
    if profile.Stats.Restored &gt;= 100 then profile.Titles.Restorer = true end
    if profile.Stats.Earned &gt;= 50000 then profile.Titles.Mogul = true end
end
function GameService:analytics(player, name, value)
    -- Custom events require a published experience. Failure must not break gameplay.
    pcall(function() game:GetService("AnalyticsService"):LogCustomEvent(player, name, value or 1) end)
end
function GameService:snapshot(player)
    local profile = self:profile(player)
    if not profile then return end
    self:resetQuests(profile)
    local inventory = {}
    for _, item in ipairs(profile.Inventory) do
        local view = shallowPublicItem(item)
        if item.Inspected then view.Value = self:value(profile, item) end
        if self:isHeld(player.UserId, item.Uid) then view.Held = true end
        if self.Exchange and self.Exchange:itemReserved(player.UserId, item.Uid) then view.Locked = true end
        table.insert(inventory, view)
    end
    local shops = {}
    for _, other in ipairs(Players:GetPlayers()) do
        local otherProfile = self:profile(other)
        if otherProfile then
            local plot = self.World.Owners[other.UserId]
            table.insert(shops, {UserId = other.UserId, Name = other.DisplayName, Tier = otherProfile.Tier,
                Rating = if otherProfile.RatingCount &gt; 0 then otherProfile.RatingTotal / otherProfile.RatingCount else 0,
                Plot = plot and plot.Index})
        end
    end
    local auction
    if self.Auction then
        auction = {Ends = self.Auction.Ends, Bid = self.Auction.Bid, Bidder = self.Auction.Bidder,
            Item = self.Auction.PublicItem}
    end
    local market, trade
    if self.Exchange then market, trade = self.Exchange:snapshot(player) end
    self.Event:FireClient(player, "State", {
        Cash = profile.Cash, AvailableCash = self:spendable(player, profile), XP = profile.XP,
        Level = Economy.level(profile.XP), Tier = profile.Tier, Tool = profile.Tool,
        Inventory = inventory, Tutorial = profile.Tutorial, Reputation = profile.Reputation,
        DecorLayout = profile.DecorLayout, Decorations = profile.Decorations, PlacedDecor = profile.PlacedDecor, Collection = profile.Collection, Themes = profile.Themes, Theme = profile.Theme,
        Daily = profile.Daily, Weekly = profile.Weekly, Login = profile.Login, Stats = profile.Stats,
        LastDelivery = profile.LastDelivery, Day = Economy.daily(os.time()),
        Settings = profile.Settings, Titles = profile.Titles, Shops = shops,
        Demand = self:demandStyle(), Auction = auction, NextAuction = self.NextAuction,
        Offer = self.Offers[player.UserId], Ephemeral = self.Data.Ephemeral,
        Held = self.Held[player.UserId],
        IsAdmin = self:isAdmin(player),
        Market = market, Trade = trade, Live = self.Live and self.Live:snapshot(player),
        Showcase = self.Showcase, ServerTime = os.time(),
    })
end
function GameService:broadcast()
    for _, player in ipairs(Players:GetPlayers()) do self:snapshot(player) end
end
function GameService:refresh(player)
    local profile = self:profile(player)
    if profile then self.World:render(player, profile, Catalog, Config); self:snapshot(player) end
end
function GameService:generate(source, level, tutorial)
    local eligible = {}
    for _, definition in ipairs(Catalog.Items) do
        if definition.UnlockLevel &lt;= level then table.insert(eligible, definition) end
    end
    local definition = eligible[self.Random:NextInteger(1, #eligible)]
    -- The guaranteed first Rare demonstrates the collection fantasy immediately;
    -- subsequent finds use the configured economy odds.
    local rarity = if tutorial then 3 else Economy.pick(Config.Sources[source].Weights, self.Random:NextNumber())
    -- Free weekend event affects estate finds only; no Robux or odds manipulation.
    if source == "Estate" and (os.date("!*t").wday == 1 or os.date("!*t").wday == 7) then
        rarity = math.min(5, rarity + (if self.Random:NextNumber() &lt; 0.08 then 1 else 0))
    end
    return {Uid = HttpService:GenerateGUID(false), DefId = definition.Id, Rarity = rarity,
        Condition = if tutorial then 2 else self.Random:NextInteger(1, 3),
        Variance = self.Random:NextNumber(0.92, 1.08), Inspected = false, Style = definition.Style}
end
function GameService:studioLegendary(player, query)
    if not RunService:IsStudio() then return false, "Studio-only command" end
    local profile = self:profile(player)
    if not profile then return false, "Profile is not ready" end
    if #profile.Inventory &gt;= Config.InventoryLimit then return false, "Inventory is full" end
    query = string.lower(type(query) == "string" and query or "")
    local choices = {}
    for _, definition in ipairs(Catalog.Items) do
        if query == "" or string.find(string.lower(definition.Name), query, 1, true)
            or string.find(string.lower(definition.Category), query, 1, true)
            or string.find(string.lower(definition.Id), query, 1, true) then
            table.insert(choices, definition)
        end
    end
    if #choices == 0 then return false, "No item matches '" .. query .. "'" end
    local definition = choices[self.Random:NextInteger(1, #choices)]
    local item = {Uid = HttpService:GenerateGUID(false), DefId = definition.Id, Rarity = 5,
        Condition = 5, Variance = 1.08, Inspected = true, Style = definition.Style}
    table.insert(profile.Inventory, item); profile.Collection[definition.Id .. ":5"] = true
    self:refresh(player)
    local reveal = shallowPublicItem(item); reveal.Value = self:value(profile, item)
    self.Event:FireClient(player, "Reveal", {Item = reveal})
    self:notify(player, "Studio test item added: Legendary " .. definition.Name)
    return true, definition.Name
end
function GameService:source(player, payload)
    local profile = self:profile(player)
    local source = payload.Source
    if type(source) ~= "string" or not Config.Sources[source] then return end
    local location = if source == "Dumpster" then "Source" else source
    if not self.World:near(player, location) then return self:notify(player, "Walk to the sourcing spot first.") end
    local tuning = Config.Sources[source]
    if Economy.level(profile.XP) &lt; tuning.Level then return self:notify(player, "Unlocks at level " .. tuning.Level .. ".") end
    if #profile.Inventory &gt;= Config.InventoryLimit then return self:notify(player, "Inventory full. Sell an item first.") end
    if self:spendable(player, profile) &lt; tuning.Cost then return self:notify(player, "Not enough available cash.") end
    local cooldowns = self.Cooldowns[player.UserId] or {}; self.Cooldowns[player.UserId] = cooldowns
    local remaining = (cooldowns[source] or 0) - os.clock()
    if remaining &gt; 0 then return self:notify(player, "Come back in " .. math.ceil(remaining) .. "s.") end
    if source == "Delivery" then
        if profile.LastDelivery == Economy.daily(os.time()) then return self:notify(player, "Your next delivery arrives tomorrow (UTC).") end
        profile.LastDelivery = Economy.daily(os.time())
    end
    cooldowns[source] = os.clock() + tuning.Cooldown
    profile.Cash -= tuning.Cost
    table.insert(profile.Inventory, self:generate(source, Economy.level(profile.XP), profile.Tutorial == 0))
    profile.XP += 4; self:stat(profile, "Found", 1)
    if profile.Tutorial == 0 then profile.Tutorial = 1; self:analytics(player, "TutorialFind") end
    if profile.Stats.Found == 2 then self:analytics(player, "SecondFind") end
    self:notify(player, "A mystery find! Open your bag to inspect it."); self:snapshot(player)
end
function GameService:inspect(player, payload)
    local profile = self:profile(player)
    local item = self:find(profile, payload.Uid)
    if item and self.Exchange and self.Exchange:itemReserved(player.UserId, item.Uid) then return self:notify(player, "Remove this item from its listing or trade first.") end
    if not item or item.Inspected then return end
    item.Inspected = true
    local key = item.DefId .. ":" .. item.Rarity
    if not profile.Collection[key] then
        profile.Collection[key] = true; profile.XP += 8
        local count = 0; for _ in pairs(profile.Collection) do count += 1 end
        if count % 10 == 0 then profile.Cash += 100; self:notify(player, "Collection milestone! +$100") end
    end
    if profile.Tutorial == 1 then profile.Tutorial = 2; self:analytics(player, "TutorialInspect") end
    self:analytics(player, "ItemInspected")
    self:snapshot(player)
    local reveal = shallowPublicItem(item); reveal.Value = self:value(profile, item)
    self.Event:FireClient(player, "Reveal", {Item = reveal})
end
function GameService:hold(player, payload)
    local profile = self:profile(player)
    local item = self:find(profile, payload.Uid)
    if not item or not item.Inspected then return self:notify(player, "Inspect this find before holding it.") end
    if self:isHeld(player.UserId, item.Uid) then
        self.Held[player.UserId] = nil; self.World:clearHeld(player)
        self:notify(player, "Returned to your bag."); return self:snapshot(player)
    end
    if item.Slot then return self:notify(player, "Return this find from its display first.") end
    if self.Exchange and self.Exchange:itemReserved(player.UserId, item.Uid) then
        return self:notify(player, "Remove this item from its listing or trade first.")
    end
    local session = self.Sessions[player.UserId]
    if session and session.Uid == item.Uid then return self:notify(player, "Finish restoring this item first.") end
    local definition = Catalog.ById[item.DefId]
    if not definition or not self.World:holdItem(player, definition, item, Config) then
        return self:notify(player, "Your avatar is not ready to hold that yet.")
    end
    self.Held[player.UserId] = item.Uid; self:analytics(player, "ItemHeld")
    self:notify(player, "Holding " .. definition.Name .. " — show off your find!"); self:snapshot(player)
end
function GameService:beginRestore(player, payload)
    local profile = self:profile(player)
    if not self.World:near(player, "Workbench") then return self:notify(player, "Visit your workbench to restore.") end
    if self.Sessions[player.UserId] then return self:notify(player, "Finish your current restoration first.") end
    local item = self:find(profile, payload.Uid)
    if item and self.Exchange and self.Exchange:itemReserved(player.UserId, item.Uid) then return self:notify(player, "Remove this item from its listing or trade first.") end
    if item and self:isHeld(player.UserId, item.Uid) then return self:notify(player, "Put this item back in your bag before restoring it.") end
    if not item or not item.Inspected or item.Slot or item.Condition &gt;= 5 then return self:notify(player, "Choose an inspected item below Mint; take it off display first.") end
    local kind = payload.Kind or Catalog.ById[item.DefId].Minigame
    if not table.find({"Scrub", "Polish", "Rewire", "Repaint", "Assemble"}, kind) then return end
    local order = {}; for i = 1, 16 do order[i] = i end
    for i = #order, 2, -1 do local j = self.Random:NextInteger(1, i); order[i], order[j] = order[j], order[i] end
    local targets = if kind == "Polish" then {1, 2, 3, 4, 8, 7, 6, 5, 9, 10, 11, 12, 16, 15, 14, 13} else order
    local session = {Token = HttpService:GenerateGUID(false), Uid = item.Uid, Kind = kind,
        Started = os.clock(), Ends = os.clock() + 20, Progress = 0, Mistakes = 0, LastInput = 0,
        Targets = targets, Seen = {}, Palette = 1, RequiredPalette = self.Random:NextInteger(1, 5)}
    self.Sessions[player.UserId] = session
    self:analytics(player, "RestoreStarted")
    self.Event:FireClient(player, "Minigame", {Token = session.Token, Kind = kind, Targets = targets,
        RequiredPalette = session.RequiredPalette, Duration = 20, Minimum = 8, Tool = profile.Tool, Item = shallowPublicItem(item), DefId = item.DefId})
end
function GameService:restoreInput(player, payload)
    local session = self.Sessions[player.UserId]
    if not session or session.Token ~= payload.Token or os.clock() &gt; session.Ends then return end
    if not self.World:near(player, "Workbench") then return end
    if os.clock() - session.LastInput &lt; 0.06 then return end
    session.LastInput = os.clock()
    if payload.Palette and session.Kind == "Repaint" and Economy.validAmount(payload.Palette, 1, 5) then
        session.Palette = payload.Palette; return
    end
    local cell = payload.Cell
    if not Economy.validAmount(cell, 1, 16) or session.Progress &gt;= 16 then return end
    local valid = true
    local other
    local gain = 1
    if session.Kind == "Rewire" then
        if session.Seen[cell] then return end
        if not session.WireStart then
            session.WireStart = cell
            self.Event:FireClient(player, "MinigameProgress", {Progress = session.Progress, Mistakes = session.Mistakes, Cell = cell, Selected = true})
            return
        end
        other = session.WireStart
        if cell == other then return end
        session.WireStart = nil
        local a, b = table.find(session.Targets, cell), table.find(session.Targets, other)
        valid = math.ceil(a / 2) == math.ceil(b / 2)
        gain = 2
    elseif session.Kind == "Assemble" then
        valid = not session.Seen[cell] and payload.Piece == table.find(session.Targets, cell)
    elseif session.Kind == "Scrub" then valid = not session.Seen[cell]
    elseif session.Kind == "Repaint" then valid = not session.Seen[cell] and session.Palette == session.RequiredPalette
    else valid = cell == session.Targets[session.Progress + 1] end
    if valid then
        session.Progress += gain; session.Seen[cell] = true
        if other then session.Seen[other] = true end
    else session.Mistakes += 1 end
    self.Event:FireClient(player, "MinigameProgress", {Progress = session.Progress, Mistakes = session.Mistakes, Cell = cell, Other = other, Valid = valid})
end
function GameService:finishRestore(player, payload)
    local session = self.Sessions[player.UserId]
    if not session or session.Token ~= payload.Token then return end
    if os.clock() - session.Started &lt; 8 then return end
    local profile = self:profile(player)
    local item = self:find(profile, session.Uid)
    self.Sessions[player.UserId] = nil
    if not item then return end
    if payload.Cancel or not self.World:near(player, "Workbench") then
        self.Event:FireClient(player, "MinigameDone", {Cancelled = true}); return
    end
    local score = math.clamp(session.Progress / 16 - session.Mistakes * 0.025 + profile.Tool * 0.025, 0, 1)
    item.Condition = Economy.restore(item.Condition, score, profile.Tool)
    if session.Kind == "Repaint" then item.Style = Config.Styles[session.RequiredPalette] end
    profile.XP += 15; self:stat(profile, "Restored", 1)
    if profile.Tutorial == 2 then profile.Tutorial = 3; self:analytics(player, "TutorialRestore") end
    local quality = if score &gt;= 0.8 then "Perfect" elseif score &gt;= 0.45 then "Good" else "Okay"
    self.Event:FireClient(player, "MinigameDone", {Quality = quality, Condition = Config.Conditions[item.Condition]})
    self:snapshot(player)
end
function GameService:display(player, payload)
    local profile = self:profile(player)
    if not self.World:near(player, "Display") then return self:notify(player, "Visit your shop to place items.") end
    local item = self:find(profile, payload.Uid)
    if item and self.Exchange and self.Exchange:itemReserved(player.UserId, item.Uid) then return self:notify(player, "Remove this item from its listing or trade first.") end
    if item and self:isHeld(player.UserId, item.Uid) then return self:notify(player, "Put this item back in your bag before displaying it.") end
    if not item or not item.Inspected then return end
    local session = self.Sessions[player.UserId]
    if session and session.Uid == item.Uid then return self:notify(player, "Finish restoring this item first.") end
    if payload.Remove then
        if self.Offers[player.UserId] and self.Offers[player.UserId].Uid == item.Uid then self.Offers[player.UserId] = nil end
        item.Slot = nil; return self:refresh(player)
    end
    if not Economy.validAmount(payload.Slot, 1, Config.Tiers[profile.Tier].Slots) then return end
    for _, other in ipairs(profile.Inventory) do
        if other.Slot == payload.Slot then return self:notify(player, "That display is occupied.") end
    end
    item.Slot = payload.Slot
    if profile.Tutorial == 3 then profile.Tutorial = 4; self.NextCustomer[player.UserId] = os.time() + 3; self:analytics(player, "TutorialDisplay") end
    self:refresh(player)
end
function GameService:makeOffer(player)
    local profile = self:profile(player)
    if not profile or self.Offers[player.UserId] then return end
    local displayed = {}; for _, item in ipairs(profile.Inventory) do if item.Slot then table.insert(displayed, item) end end
    if #displayed == 0 then return end
    local customer = customers[self.Random:NextInteger(1, #customers)]
    local item = displayed[self.Random:NextInteger(1, #displayed)]
    local value = self:value(profile, item)
    local preferred = item.Style == customer.Style
    local amount = math.floor(value * (if preferred then 1.15 else self.Random:NextNumber(0.85, 1.05)))
    if profile.Tutorial == 4 then customer = {Name = "Mabel · Welcome gift", Budget = 100000}; amount = math.max(150, amount) end
    if amount &gt; customer.Budget then return end
    self.Offers[player.UserId] = {Uid = item.Uid, Amount = amount, Customer = customer.Name,
        Ends = os.time() + 20, Countered = false, Preferred = preferred}
    self.World:customer(player.UserId, customer.Name); self:snapshot(player)
end
function GameService:haggle(player, payload)
    local profile = self:profile(player)
    local offer = self.Offers[player.UserId]
    if not offer or os.time() &gt; offer.Ends then return end
    if not self.World:near(player, "Shop") then return self:notify(player, "Meet your customer in your shop.") end
    local item, index = self:find(profile, offer.Uid)
    if not item or not item.Slot then self.Offers[player.UserId] = nil; return end
    if payload.Choice == "Decline" then self.Offers[player.UserId] = nil
    elseif payload.Choice == "Counter" and not offer.Countered then
        offer.Countered = true
        if self.Random:NextNumber() &lt; 0.65 then
            offer.Amount = math.floor(offer.Amount * 1.12); self:notify(player, "They accepted your counter! Accept to sell.")
        else self.Offers[player.UserId] = nil; self:notify(player, "They passed this time. Another customer will come.") end
    elseif payload.Choice == "Accept" then
        self.Offers[player.UserId] = nil; table.remove(profile.Inventory, index)
        profile.Cash += offer.Amount; profile.XP += 20; profile.Reputation += 1
        self:stat(profile, "Sold", 1); self:stat(profile, "Earned", offer.Amount)
        if profile.Tutorial == 4 then profile.Tutorial = 5; self:analytics(player, "TutorialFirstSale") end
        self:notify(player, "Sold! +$" .. offer.Amount); self:analytics(player, "ItemSold")
    else return end
    self:refresh(player)
end
function GameService:upgrade(player, payload)
    local profile = self:profile(player)
    if not self.World:near(player, "Shop") then return self:notify(player, "Upgrade at your shop counter.") end
    if payload.Kind == "Shop" then
        local nextTier = Config.Tiers[profile.Tier + 1]
        if not nextTier then return self:notify(player, "Your shop is fully upgraded!") end
        if Economy.level(profile.XP) &lt; nextTier.Level then return self:notify(player, "Requires level " .. nextTier.Level .. ".") end
        if self:spendable(player, profile) &lt; nextTier.Cost then return self:notify(player, "Not enough cash.") end
        profile.Cash -= nextTier.Cost; profile.Tier += 1; self:analytics(player, "ShopUpgrade")
    elseif payload.Kind == "Tool" then
        local cost = Config.ToolCosts[profile.Tool + 1]
        if not cost then return self:notify(player, "Tools fully upgraded!") end
        if self:spendable(player, profile) &lt; cost then return self:notify(player, "Not enough cash.") end
        profile.Cash -= cost; profile.Tool += 1
    elseif payload.Kind == "Decor" then
        local decoration
        for _, entry in ipairs(Config.Decorations) do if entry.Id == payload.Decor then decoration = entry end end
        if not decoration then return end
        if not profile.Decorations[decoration.Id] then
            if self:spendable(player, profile) &lt; decoration.Cost then return self:notify(player, "Not enough cash.") end
            profile.Cash -= decoration.Cost; profile.Decorations[decoration.Id] = true
        end
        profile.PlacedDecor[decoration.Id] = not profile.PlacedDecor[decoration.Id]
    elseif payload.Kind == "Theme" then
        local theme
        for _, candidate in ipairs(Config.Themes) do if candidate.Id == payload.Theme then theme = candidate end end
        if not theme then return end
        if not profile.Themes[theme.Id] then
            if self:spendable(player, profile) &lt; theme.Cost then return self:notify(player, "Not enough cash.") end
            profile.Cash -= theme.Cost; profile.Themes[theme.Id] = true
        end
        profile.Theme = theme.Id
    end
    self:refresh(player)
end
function GameService:decorPlace(player, payload)
    local profile = self:profile(player)
    if not self.World:near(player, "Shop") then return self:notify(player, "Arrange decorations inside your shop.") end
    if type(payload.Decor) ~= "string" or not profile.Decorations[payload.Decor] or not profile.PlacedDecor[payload.Decor] then return end
    if payload.Reset then
        profile.DecorLayout[payload.Decor] = nil; self:refresh(player); return
    end
    local ok, result = DecorPlacement.validate(payload.Decor, {X = payload.X, Z = payload.Z, Rotation = payload.Rotation}, profile.DecorLayout, profile.PlacedDecor, Config.Tiers[profile.Tier].Slots)
    if not ok then return self:notify(player, result) end
    profile.DecorLayout[payload.Decor] = result
    self:refresh(player)
end
function GameService:quest(player, payload)
    local profile = self:profile(player); self:resetQuests(profile)
    local daily = {Find = {"Found", 3, 65}, Restore = {"Restored", 3, 100}, Sell = {"Sold", 3, 150}}
    local quest = daily[payload.Id]
    if quest then
        if profile.Daily.Claimed[payload.Id] then return end
        if (profile.Daily[quest[1]] or 0) &lt; quest[2] then return self:notify(player, "Quest not finished yet.") end
        profile.Daily.Claimed[payload.Id] = true; profile.Cash += quest[3]; profile.XP += 20
        self:notify(player, "Daily quest complete! +$" .. quest[3])
    elseif payload.Id == "Weekly" then
        if profile.Weekly.Claimed then return end
        if profile.Weekly.Restored &lt; 20 or profile.Weekly.Sold &lt; 15 then return self:notify(player, "Restore 20 and sell 15 this week.") end
        profile.Weekly.Claimed = true; profile.Cash += 1200; profile.XP += 100
        profile.Titles.WeeklyWonder = true; self:notify(player, "Weekly quest complete! +$1200")
    end
    self:snapshot(player)
end
function GameService:dailyGift(player)
    local profile = self:profile(player)
    local day = Economy.daily(os.time()); self:prepareLogin(profile, day)
    if profile.Login.ClaimedDay == day then return self:notify(player, "Today's welcome gift is already collected.") end
    local rewards = {50, 75, 100, 150, 200, 300, 500}
    local reward = rewards[math.clamp(profile.Login.Streak, 1, #rewards)]
    profile.Login.ClaimedDay = day; profile.Cash += reward; profile.XP += 10
    self:analytics(player, "DailyGiftDay" .. tostring(profile.Login.Streak))
    self:notify(player, "Day " .. profile.Login.Streak .. " welcome gift: +$" .. reward)
    self:refresh(player)
end
function GameService:bid(player, payload)
    local profile = self:profile(player)
    local auction = self.Auction
    if not auction or os.time() &gt;= auction.Ends then return end
    if not self.World:near(player, "Auction") then return self:notify(player, "Visit the auction house to bid.") end
    if #profile.Inventory &gt;= Config.InventoryLimit then return self:notify(player, "Make room in your inventory first.") end
    local minimum = auction.Bid + math.max(10, math.floor(auction.Bid * 0.1))
    if not Economy.validAmount(payload.Amount, minimum, 10000000) or payload.Amount &gt; profile.Cash - (if self.Exchange then self.Exchange:reservedCash(player.UserId) else 0) then return self:notify(player, "Your bid must beat $" .. (minimum - 1) .. " and fit your cash balance.") end
    auction.Bid = payload.Amount; auction.Bidder = player.UserId
    -- Cash is reserved, never removed before a win. Save cannot persist an orphan escrow.
    auction.Ends = math.max(auction.Ends, math.min(auction.Started + 90, os.time() + 8))
    self:broadcast()
end
function GameService:rating(player, payload)
    local profile = self:profile(player)
    if not Economy.validAmount(payload.UserId, 1, 9007199254740991) or payload.UserId == player.UserId then return end
    if not Economy.validAmount(payload.Stars, 1, 5) then return end
    local target = Players:GetPlayerByUserId(payload.UserId)
    local targetProfile = target and self:profile(target)
    local plot = self.World.Owners[payload.UserId]
    local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not targetProfile or not plot or not root or (root.Position - plot.CF.Position).Magnitude &gt; 30 then return self:notify(player, "Visit that shop before rating it.") end
    local key = tostring(payload.UserId)
    if profile.Rated[key] == Economy.daily(os.time()) then return self:notify(player, "You rated this shop today.") end
    profile.Rated[key] = Economy.daily(os.time()); targetProfile.RatingTotal += payload.Stars; targetProfile.RatingCount += 1
    -- Remove old votes to bound saved data.
    for id, day in pairs(profile.Rated) do if day &lt; Economy.daily(os.time()) - 2 then profile.Rated[id] = nil end end
    self:notify(player, "Thanks for visiting!"); self:refresh(target); self:snapshot(player)
end
function GameService:showcase(player, payload)
    local profile = self:profile(player)
    if payload.Choice == "Enter" then
        local existing = self.Showcase.Entries[tostring(player.UserId)]
        self.Showcase.Entries[tostring(player.UserId)] = {Name = player.DisplayName, Votes = if existing then existing.Votes else 0, Theme = profile.Theme}
        self:notify(player, "Shop entered in this server's weekly showcase.")
    elseif payload.Choice == "Vote" then
        if type(payload.UserId) ~= "number" or payload.UserId == player.UserId then return end
        local key = tostring(player.UserId)
        local entry = self.Showcase.Entries[tostring(payload.UserId)]
        if not entry or self.Showcase.Votes[key] then return end
        self.Showcase.Votes[key] = true; entry.Votes += 1
    end
    self:broadcast()
end
function GameService:settings(player, payload)
    local profile = self:profile(player)
    if (payload.Name == "Music" or payload.Name == "Effects") and type(payload.Enabled) == "boolean" then
        profile.Settings[payload.Name] = payload.Enabled; self:snapshot(player)
    end
end
function GameService:admin(player, payload)
    if not self:isAdmin(player) then return self:notify(player, "Admin access denied.") end
    local command = payload.Command
    if type(command) ~= "string" then return end
    if command == "Announce" then
        local message = payload.Message
        if type(message) ~= "string" or #message &lt; 1 or #message &gt; 120 then return self:notify(player, "Announcements must be 1–120 characters.") end
        for _, recipient in ipairs(Players:GetPlayers()) do self.Event:FireClient(recipient, "Announcement", player.DisplayName .. ": " .. message) end
        warn("[THRIFT ADMIN] " .. player.Name .. " broadcast an announcement"); return
    end
    local target = self:adminTarget(player, payload.Target)
    if not target then return self:notify(player, "That player is not in this server.") end
    local profile = self:profile(target)
    if not profile then return self:notify(player, "That player's profile is not ready.") end

    if command == "GiveItem" then
        if #profile.Inventory &gt;= Config.InventoryLimit then return self:notify(player, "That player's bag is full.") end
        local rarity = payload.Rarity
        if not Economy.validAmount(rarity, 1, 5) then return self:notify(player, "Choose a rarity from 1 to 5.") end
        local query = string.lower(type(payload.Query) == "string" and payload.Query or "")
        local choices = {}
        for _, definition in ipairs(Catalog.Items) do
            if query == "" or string.find(string.lower(definition.Name), query, 1, true)
                or string.find(string.lower(definition.Category), query, 1, true)
                or string.find(string.lower(definition.Id), query, 1, true) then table.insert(choices, definition) end
        end
        if #choices == 0 then return self:notify(player, "No item matches '" .. query .. "'.") end
        local definition = choices[self.Random:NextInteger(1, #choices)]
        local item = {Uid = HttpService:GenerateGUID(false), DefId = definition.Id, Rarity = rarity,
            Condition = 5, Variance = 1, Inspected = true, Style = definition.Style}
        table.insert(profile.Inventory, item); profile.Collection[definition.Id .. ":" .. rarity] = true
        self:refresh(target)
        local reveal = shallowPublicItem(item); reveal.Value = self:value(profile, item)
        self.Event:FireClient(target, "Reveal", {Item = reveal})
        self:notify(player, "Gave " .. target.DisplayName .. " a " .. Config.Rarities[rarity] .. " " .. definition.Name .. ".")
    elseif command == "Cash" then
        local amount = payload.Amount
        if not Economy.validAmount(amount, -100000, 100000) or amount == 0 then return self:notify(player, "Cash change must be a whole number up to 100,000.") end
        profile.Cash = math.clamp(profile.Cash + amount, 0, 1000000000); self:refresh(target)
        self:notify(player, (if amount &gt; 0 then "Added $" .. amount .. " to " else "Removed $" .. math.abs(amount) .. " from ") .. target.DisplayName .. ".")
    elseif command == "XP" then
        local amount = payload.Amount
        if not Economy.validAmount(amount, 1, 100000) then return self:notify(player, "XP must be a whole number up to 100,000.") end
        profile.XP = math.clamp(profile.XP + amount, 0, 100000000); self:refresh(target)
        self:notify(player, "Added " .. amount .. " XP to " .. target.DisplayName .. ".")
    elseif command == "Tutorial" then
        if payload.Value ~= 0 and payload.Value ~= 5 then return end
        profile.Tutorial = payload.Value; self:refresh(target)
        self:notify(player, (if payload.Value == 0 then "Reset " else "Completed ") .. target.DisplayName .. "'s tutorial.")
    elseif command == "Bring" then
        local sourceRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        local targetHumanoid = target.Character and target.Character:FindFirstChildOfClass("Humanoid")
        if not sourceRoot or not targetHumanoid or targetHumanoid.Health &lt;= 0 then return self:notify(player, "One avatar is not ready.") end
        target.Character:PivotTo(sourceRoot.CFrame * CFrame.new(3, 0, 0)); self:notify(player, "Brought " .. target.DisplayName .. ".")
    elseif command == "Heal" then
        local humanoid = target.Character and target.Character:FindFirstChildOfClass("Humanoid")
        if not humanoid then return self:notify(player, "That avatar is not ready.") end
        humanoid.Health = humanoid.MaxHealth; self:notify(player, "Healed " .. target.DisplayName .. ".")
    elseif command == "Kick" then
        if target ~= player and self:isAdmin(target) then return self:notify(player, "Administrators cannot kick each other.") end
        warn("[THRIFT ADMIN] " .. player.Name .. " kicked " .. target.Name)
        target:Kick("Removed by a Thrift Flip administrator."); return
    else return end
    warn("[THRIFT ADMIN] " .. player.Name .. " used " .. command .. " on " .. target.Name)
end
function GameService:teleport(player, payload)
    if type(payload.Destination) ~= "string" or #payload.Destination &gt; 20 then return end
    local now = os.clock()
    if now - (self.TeleportAt[player.UserId] or 0) &lt; 1.5 then return end
    if self.Sessions[player.UserId] then return self:notify(player, "Finish or cancel your restoration first.") end
    local destination = self.World:teleportCFrame(player, payload.Destination)
    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not destination or not humanoid or humanoid.Health &lt;= 0 then return self:notify(player, "That destination is not available yet.") end
    self.TeleportAt[player.UserId] = now
    character:PivotTo(destination)
    self:notify(player, "Arrived at " .. payload.Destination .. ".")
end
local handlers = {
    Source = GameService.source, Inspect = GameService.inspect, BeginRestore = GameService.beginRestore,
    Hold = GameService.hold,
    RestoreInput = GameService.restoreInput, FinishRestore = GameService.finishRestore,
    Display = GameService.display, Haggle = GameService.haggle, Upgrade = GameService.upgrade,
    Quest = GameService.quest, Bid = GameService.bid, Rate = GameService.rating, DecorPlace = GameService.decorPlace,
    Showcase = GameService.showcase, Settings = GameService.settings, Teleport = GameService.teleport,
    Admin = GameService.admin,
    DailyGift = GameService.dailyGift,
}
function GameService:request(player, action, payload)
    if self.Closing or not self:profile(player) then return end
    if type(action) ~= "string" or #action &gt; 32 or type(payload) ~= "table" then return end
    local bucket = self.Buckets[player.UserId] or {Tokens = 35, At = os.clock()}
    self.Buckets[player.UserId] = bucket
    local now = os.clock(); bucket.Tokens = math.min(35, bucket.Tokens + (now - bucket.At) * 18); bucket.At = now
    if bucket.Tokens &lt; 1 then return end
    bucket.Tokens -= 1
    -- Reject oversized/nested input before dispatch; all payloads are scalar.
    local count = 0
    for key, value in pairs(payload) do
        count += 1
        if count &gt; 8 or type(key) ~= "string" or #key &gt; 32 then return end
        if type(value) ~= "string" and type(value) ~= "number" and type(value) ~= "boolean" then return end
        if type(value) == "string" and #value &gt; 100 then return end
        if type(value) == "number" and (value ~= value or math.abs(value) == math.huge) then return end
    end
    if action == "Sync" then return self:snapshot(player) end
    if action == "CancelRestore" then
        local session = self.Sessions[player.UserId]
        if session then self.Sessions[player.UserId] = nil; self.Event:FireClient(player, "MinigameDone", {Cancelled = true}) end
        return
    end
    if self.Exchange then
        local ok, handled = pcall(self.Exchange.request, self.Exchange, player, action, payload)
        if not ok then warn("Exchange action failed: " .. tostring(handled)); self:notify(player, "That exchange could not finish. Please try again."); return end
        if handled then return end
    end
    if self.Live and self.Live:handle(player, action, payload) then return end
    local handler = handlers[action]
    if handler then
        local ok, err = pcall(handler, self, player, payload)
        if not ok then warn("Action " .. action .. " failed: " .. tostring(err)); self:notify(player, "That action could not finish. Please try again.") end
    end
end
function GameService:join(player)
    local profile = self.Data:load(player.UserId)
    if not profile then player:Kick("Your save is unavailable or still open in another server. Please rejoin shortly; no data was overwritten."); return end
    if self.Exchange and not self.Exchange:recover(player.UserId) then
        self.Data:release(player.UserId)
        if player.Parent then player:Kick("A previous exchange needs recovery. Please rejoin shortly; your save is protected.") end
        return
    end
    if not player.Parent then self.Data:release(player.UserId); return end
    if self.Closing then self.Data:release(player.UserId); player:Kick("Server closing. Please rejoin."); return end
    if not self.World:assign(player) then self.Data:release(player.UserId); player:Kick("This town is full. Please join another server."); return end
    self.Ready[player.UserId] = true; self.JoinedAt[player.UserId] = os.clock(); self:resetQuests(profile); self:prepareLogin(profile)
    self.NextCustomer[player.UserId] = os.time() + 10
    player.CharacterAdded:Connect(function()
        task.wait(0.8)
        local uid = self.Held[player.UserId]
        local current = self:profile(player)
        local item = current and uid and self:find(current, uid)
        local definition = item and Catalog.ById[item.DefId]
        if definition and not self.World:holdItem(player, definition, item, Config) then self.Held[player.UserId] = nil end
    end)
    local leaderstats = Instance.new("Folder"); leaderstats.Name = "leaderstats"; leaderstats.Parent = player
    local cash = Instance.new("IntValue"); cash.Name = "Cash"; cash.Value = profile.Cash; cash.Parent = leaderstats
    local level = Instance.new("IntValue"); level.Name = "Level"; level.Value = Economy.level(profile.XP); level.Parent = leaderstats
    self:refresh(player); self:analytics(player, "SessionStart")
    if self.Live then task.spawn(function() self.Live:join(player) end) end
    self:notify(player, if profile.Tutorial &lt; 5 then "Welcome! Find a mystery item in Dumpster Alley." else "Welcome back to Thrift Street!")
end
function GameService:leave(player)
    local joined = self.JoinedAt[player.UserId]
    if joined then self:analytics(player, "SessionSeconds", math.floor(os.clock() - joined)) end
    self.JoinedAt[player.UserId] = nil
    if self.Exchange then self.Exchange:leave(player.UserId) end
    if self.Live then self.Live:leave(player) end
    self.Ready[player.UserId] = nil
    if self.Auction and self.Auction.Bidder == player.UserId then self.Auction.Bidder = nil; self.Auction.Bid = 0 end
    self.Sessions[player.UserId] = nil; self.Offers[player.UserId] = nil
    self.Held[player.UserId] = nil; self.World:clearHeld(player)
    self.Cooldowns[player.UserId] = nil; self.Buckets[player.UserId] = nil; self.NextCustomer[player.UserId] = nil
    self.World:release(player.UserId)
    self.Data:release(player.UserId)
end
function GameService:tick()
    local now = os.time()
    if self.Exchange then self.Exchange:tick() end
    if self.Live then self.Live:tick() end
    if not self.Live and self.Showcase.Week ~= Economy.week(now) then
        local winner, votes = nil, 0
        for id, entry in pairs(self.Showcase.Entries) do if entry.Votes &gt; votes then winner = tonumber(id); votes = entry.Votes end end
        local winnerProfile = winner and self.Data.Profiles[winner]
        if winnerProfile then winnerProfile.Titles.ShowcaseWinner = true end
        self.Showcase = {Week = Economy.week(now), Entries = {}, Votes = {}}
    end
    if not self.Auction and now &gt;= self.NextAuction then
        local item = self:generate("Estate", 100, false); item.Rarity = math.max(3, item.Rarity); item.Inspected = true
        self.Auction = {Item = item, PublicItem = shallowPublicItem(item), Bid = 0, Bidder = nil,
            Started = now, Ends = now + Config.AuctionDuration}
        self:broadcast()
    elseif self.Auction and now &gt;= self.Auction.Ends then
        local auction = self.Auction
        local winner = auction.Bidder and Players:GetPlayerByUserId(auction.Bidder)
        local profile = winner and self:profile(winner)
        if winner and self.Ready[winner.UserId] and not profile and (self.Data.ExchangeLocks[winner.UserId] or self.Data.MutationLocks[winner.UserId]) then
            auction.Ends = now + 1; return
        end
        if profile and #profile.Inventory &lt; Config.InventoryLimit and profile.Cash &gt;= auction.Bid then
            profile.Cash -= auction.Bid; table.insert(profile.Inventory, auction.Item)
            profile.Collection[auction.Item.DefId .. ":" .. auction.Item.Rarity] = true
            self:notify(winner, "Going, going, yours! Your auction find is in your bag.")
        end
        self.Auction = nil; self.NextAuction = now + Config.AuctionInterval; self:broadcast()
    end
    for _, player in ipairs(Players:GetPlayers()) do
        local profile = self:profile(player)
        if profile then
            local offer = self.Offers[player.UserId]
            if offer and now &gt;= offer.Ends then self.Offers[player.UserId] = nil; self:snapshot(player) end
            if now &gt;= (self.NextCustomer[player.UserId] or 0) then
                self.NextCustomer[player.UserId] = now + math.max(8, Config.CustomerSeconds - math.floor(profile.Reputation / 30))
                self:makeOffer(player)
            end
            local session = self.Sessions[player.UserId]
            if session and os.clock() &gt; session.Ends then self:finishRestore(player, {Token = session.Token}) end
            local stats = player:FindFirstChild("leaderstats")
            if stats then stats.Cash.Value = profile.Cash; stats.Level.Value = Economy.level(profile.XP) end
        end
    end
end
return GameService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX23">
        <Properties>
          <string name="Name">LiveService</string>
          <ProtectedString name="Source">-- Live operations are isolated from core economy mutations. All awards are
-- permanent cosmetic set-membership grants, so uncertain saves are safely retryable.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local LiveConfig = require(Shared.LiveConfig)
local Config = require(Shared.Config)
local LiveService = {}
LiveService.__index = LiveService
local WEEK = 7 * 86400
local MONDAY_OFFSET = 3 * 86400
local function copy(value)
    if type(value) ~= "table" then return value end
    local result = {}; for key, child in pairs(value) do result[key] = copy(child) end
    return result
end
local function validId(value)
    return type(value) == "number" and value == value and value &gt; 0 and value &lt; 9007199254740991 and value % 1 == 0
end
local function ensure(profile)
    profile.Live = profile.Live or {Events = {}, ShowcaseClaims = {}}
    profile.Live.Events = profile.Live.Events or {}
    profile.Live.ShowcaseClaims = profile.Live.ShowcaseClaims or {}
    profile.AppliedReceipts = profile.AppliedReceipts or {}
    profile.Themes = profile.Themes or {}; profile.Decorations = profile.Decorations or {}; profile.Titles = profile.Titles or {}
    return profile.Live
end
function LiveService.week(now)
    return math.floor((now + MONDAY_OFFSET) / WEEK)
end
function LiveService.weekEnd(week)
    return (week + 1) * WEEK - MONDAY_OFFSET
end
function LiveService.neighborhood(userId)
    return userId % LiveConfig.Showcase.Neighborhoods + 1
end
function LiveService.theme(week)
    local themes = LiveConfig.Showcase.Themes
    return themes[week % #themes + 1]
end
function LiveService.activeEvents(now)
    local active = {}
    for _, event in ipairs(LiveConfig.Events) do
        if now &gt;= event.Starts and now &lt; event.Ends then table.insert(active, event) end
    end
    return active
end
function LiveService.rank(record)
    local entries = {}
    for _, entry in pairs(record.Entries or {}) do
        if (entry.Votes or 0) &gt;= LiveConfig.Showcase.MinimumVotes then table.insert(entries, copy(entry)) end
    end
    table.sort(entries, function(a, b)
        if a.Votes ~= b.Votes then return a.Votes &gt; b.Votes end
        return a.UserId &lt; b.UserId
    end)
    local winners = {}
    for place = 1, math.min(#entries, LiveConfig.Showcase.WinnerCount) do
        local entry = entries[place]
        table.insert(winners, {UserId = entry.UserId, Name = entry.Name, Votes = entry.Votes, Place = place})
    end
    return winners
end
function LiveService.applyReward(profile, reward)
    ensure(profile)
    if reward.Theme then profile.Themes[reward.Theme] = true end
    if reward.Decoration then profile.Decorations[reward.Decoration] = true end
    if reward.Title then profile.Titles[reward.Title] = true end
end
function LiveService.ownsReward(profile, reward)
    if reward.Theme and not profile.Themes[reward.Theme] then return false end
    if reward.Decoration and not profile.Decorations[reward.Decoration] then return false end
    if reward.Title and not profile.Titles[reward.Title] then return false end
    return reward.Theme ~= nil or reward.Decoration ~= nil or reward.Title ~= nil
end
local function memoryStore()
    local records = {}
    return {
        GetAsync = function(_, key) return copy(records[key]) end,
        UpdateAsync = function(_, key, transform)
            local result = transform(copy(records[key]))
            if result ~= nil then records[key] = copy(result) end
            return copy(result)
        end,
    }
end
function LiveService.new(data, gameService, options)
    options = options or {}
    local self = setmetatable({}, LiveService)
    self.Data = data; self.Game = gameService
    self.Marketplace = options.Marketplace or game:GetService("MarketplaceService")
    self.Players = options.Players or game:GetService("Players")
    self.Now = options.Now or os.time
    self.Store = options.Store or (if data.Ephemeral then memoryStore() else game:GetService("DataStoreService"):GetDataStore("ThriftFlip_Showcase_v1"))
    self.Cache = {}; self.RequestAt = {}; self.Busy = {}; self.Products = {}; self.Passes = {}; self.ProductInfo = {}
    self.Data.MutationLocks = self.Data.MutationLocks or {}
    self.LastTick = 0
    for _, entry in ipairs(LiveConfig.Products) do if validId(entry.Id) then self.Products[entry.Id] = entry end end
    for _, entry in ipairs(LiveConfig.Passes) do if validId(entry.Id) then self.Passes[entry.Id] = entry end end
    -- Keep the original configuration path supported when migrating existing games.
    for id, theme in pairs(Config.CosmeticPasses or {}) do
        if validId(id) and not self.Passes[id] then self.Passes[id] = {Id = id, Name = theme .. " theme", Description = "Permanent cosmetic shop theme", Reward = {Theme = theme}} end
    end
    return self
end
function LiveService:rawProfile(userId)
    if self.Data.Closing[userId] then return nil end
    return self.Data.Profiles[userId]
end
function LiveService:notice(player, message)
    if player and player.Parent then self.Game:notify(player, message) end
end
function LiveService:key(week, neighborhood)
    return "week_" .. week .. "_n_" .. neighborhood
end
function LiveService:retry(callback)
    if self.Data.retry then return self.Data:retry(callback) end
    return pcall(callback)
end
function LiveService:emptyRecord(week, neighborhood)
    return {Week = week, Neighborhood = neighborhood, Entries = {}, Votes = {}, VoterCount = 0, EntryCount = 0, Closed = false}
end
function LiveService:read(week, neighborhood, force)
    local key = self:key(week, neighborhood)
    local cached = self.Cache[key]
    if not force and cached and self.Now() - cached.At &lt; LiveConfig.Showcase.CacheSeconds then return cached.Record end
    local ok, record = self:retry(function() return self.Store:GetAsync(key) end)
    if not ok then return cached and cached.Record or nil end
    record = record or self:emptyRecord(week, neighborhood)
    self.Cache[key] = {At = self.Now(), Record = record}
    return record
end
function LiveService:refresh(player)
    local profile = self:rawProfile(player.UserId)
    if not profile then return end
    local week = LiveService.week(self.Now())
    local neighborhood = LiveService.neighborhood(player.UserId)
    self:read(week, neighborhood, true)
    if self:rawProfile(player.UserId) == profile and player.Parent then self.Game:snapshot(player) end
end
function LiveService:grant(player, mutate)
    local userId = player.UserId
    local profile = self:rawProfile(userId)
    if not profile or self.Data.Busy[userId] or self.Data.MutationLocks[userId]
        or (self.Data.ExchangeLocks and self.Data.ExchangeLocks[userId]) then return false end
    local token = {}
    self.Data.MutationLocks[userId] = token
    local ok, result = pcall(function()
        ensure(profile)
        mutate(profile)
        return self.Data:save(userId, false)
    end)
    if self.Data.MutationLocks[userId] == token then self.Data.MutationLocks[userId] = nil end
    if not ok then warn("Live cosmetic award failed: " .. tostring(result)); return false end
    return result == true
end
function LiveService:recordStat(profile, name, amount)
    if (name ~= "Found" and name ~= "Restored" and name ~= "Sold") or type(amount) ~= "number" or amount &lt;= 0 then return end
    local live = ensure(profile)
    for _, event in ipairs(LiveService.activeEvents(self.Now())) do
        local progress = live.Events[event.Id] or {Found = 0, Restored = 0, Sold = 0, Claimed = false}
        live.Events[event.Id] = progress
        progress[name] = math.min(100000, (progress[name] or 0) + amount)
    end
end
function LiveService:eventClaim(player, payload)
    if type(payload.Id) ~= "string" or #payload.Id &gt; 50 then return end
    local profile = self:rawProfile(player.UserId)
    if not profile then return end
    local event
    for _, entry in ipairs(LiveService.activeEvents(self.Now())) do if entry.Id == payload.Id then event = entry; break end end
    if not event then return self:notice(player, "That seasonal event is not active.") end
    local progress = ensure(profile).Events[event.Id]
    if not progress then return self:notice(player, "Make a little progress in the event first.") end
    if progress.Claimed then return self:notice(player, "You already collected this event reward.") end
    for stat, goal in pairs(event.Goal) do
        if (progress[stat] or 0) &lt; goal then return self:notice(player, "Complete the event goals to collect this reward.") end
    end
    local saved = self:grant(player, function(current)
        LiveService.applyReward(current, event.Reward)
        current.Live.Events[event.Id].Claimed = true
    end)
    self:notice(player, if saved then "Event complete! " .. event.RewardName else "Your reward is pending a successful save. Please try again shortly.")
    if self:rawProfile(player.UserId) == profile then self.Game:refresh(player) end
end
function LiveService:enter(player)
    local profile = self:rawProfile(player.UserId)
    if not profile then return end
    if profile.Tutorial &lt; 5 then return self:notice(player, "Complete your first sale before entering the showcase.") end
    local now = self.Now(); local week = LiveService.week(now)
    local neighborhood = LiveService.neighborhood(player.UserId)
    local preview = {}
    for _, item in ipairs(profile.Inventory) do
        if item.Slot and item.Inspected then
            table.insert(preview, {DefId = item.DefId, Rarity = item.Rarity, Condition = item.Condition, Style = item.Style})
            if #preview &gt;= 3 then break end
        end
    end
    if #preview == 0 then return self:notice(player, "Place at least one item on display before entering.") end
    local name = string.sub(player.DisplayName, 1, 64)
    local entry = {UserId = player.UserId, Name = name, Theme = profile.Theme, Tier = profile.Tier, Preview = preview, Votes = 0}
    local accepted, reason = false, "The showcase is temporarily unavailable."
    local key = self:key(week, neighborhood)
    local ok, record = self:retry(function()
        accepted = false
        return self.Store:UpdateAsync(key, function(current)
            current = current or self:emptyRecord(week, neighborhood)
            if current.Closed or self.Now() &gt;= LiveService.weekEnd(week) then reason = "This week's showcase has closed."; return nil end
            local userKey = tostring(player.UserId)
            local existing = current.Entries[userKey]
            if not existing and current.EntryCount &gt;= LiveConfig.Showcase.MaxEntries then reason = "Your neighborhood's showcase is full this week."; return nil end
            entry.Votes = if existing then existing.Votes else 0
            current.Entries[userKey] = copy(entry)
            if not existing then current.EntryCount += 1 end
            accepted = true
            return current
        end)
    end)
    if ok and accepted and record then
        self.Cache[key] = {At = now, Record = record}
        self:notice(player, "Your shop is entered! Your display travels with the entry across servers.")
    else self:notice(player, reason) end
    if self:rawProfile(player.UserId) == profile then self.Game:snapshot(player) end
end
function LiveService:vote(player, payload)
    if not validId(payload.UserId) or payload.UserId == player.UserId then return end
    local profile = self:rawProfile(player.UserId)
    if not profile or profile.Tutorial &lt; 5 then return self:notice(player, "Complete your first sale before voting.") end
    local now = self.Now(); local week = LiveService.week(now)
    local neighborhood = LiveService.neighborhood(player.UserId)
    if LiveService.neighborhood(payload.UserId) ~= neighborhood then return end
    local accepted, reason = false, "The showcase is temporarily unavailable."
    local key = self:key(week, neighborhood)
    local ok, record = self:retry(function()
        accepted = false
        return self.Store:UpdateAsync(key, function(current)
            if not current or current.Closed or self.Now() &gt;= LiveService.weekEnd(week) then reason = "Voting is closed."; return nil end
            local voterKey, targetKey = tostring(player.UserId), tostring(payload.UserId)
            if current.Votes[voterKey] then reason = "You have already voted this week."; return nil end
            if not current.Entries[targetKey] then reason = "That shop is not entered."; return nil end
            if current.VoterCount &gt;= LiveConfig.Showcase.MaxVoters then reason = "This week's voting has reached its limit."; return nil end
            current.Votes[voterKey] = payload.UserId; current.VoterCount += 1
            current.Entries[targetKey].Votes += 1; accepted = true
            return current
        end)
    end)
    if ok and accepted and record then self.Cache[key] = {At = now, Record = record}; self:notice(player, "Vote counted. Thank you for supporting another creator!")
    else self:notice(player, reason) end
    if self:rawProfile(player.UserId) == profile then self.Game:snapshot(player) end
end
function LiveService:finalize(week, neighborhood)
    if self.Now() &lt; LiveService.weekEnd(week) then return nil end
    local key = self:key(week, neighborhood)
    local ok, record = self:retry(function()
        return self.Store:UpdateAsync(key, function(current)
            if not current then return nil end
            if not current.Closed then
                current.Closed = true; current.Winners = LiveService.rank(current)
                current.FinalizedAt = self.Now()
                -- Finalized voting receipts are no longer needed to resolve a result.
                current.Votes = {}; current.VoterCount = 0
            end
            return current
        end)
    end)
    if ok and record then self.Cache[key] = {At = self.Now(), Record = record}; return record end
    return nil
end
function LiveService:claimShowcase(player, quiet)
    local profile = self:rawProfile(player.UserId)
    if not profile then return end
    local currentWeek = LiveService.week(self.Now())
    local neighborhood = LiveService.neighborhood(player.UserId)
    local awards = {}
    for offset = 1, LiveConfig.Showcase.HistoryWeeks do
        local week = currentWeek - offset
        local claimKey = tostring(week)
        if not ensure(profile).ShowcaseClaims[claimKey] then
            local record = self:finalize(week, neighborhood)
            if self:rawProfile(player.UserId) ~= profile then return end
            if record then
                for _, winner in ipairs(record.Winners or {}) do
                    if winner.UserId == player.UserId then table.insert(awards, {Week = week, Place = winner.Place}) end
                end
            end
        end
    end
    if #awards == 0 then
        if not quiet then self:notice(player, "No unclaimed showcase prizes from the last four weeks. Keep creating!") end
        return
    end
    local saved = self:grant(player, function(current)
        for _, award in ipairs(awards) do
            LiveService.applyReward(current, LiveConfig.Showcase.Rewards[award.Place])
            current.Live.ShowcaseClaims[tostring(award.Week)] = true
        end
        for week in pairs(current.Live.ShowcaseClaims) do
            if tonumber(week) &lt; currentWeek - LiveConfig.Showcase.HistoryWeeks - 1 then current.Live.ShowcaseClaims[week] = nil end
        end
    end)
    self:notice(player, if saved then "Your showcase prize is here! Check your cosmetic titles and decorations." else "Your showcase award is pending a successful save. Please retry shortly.")
    if self:rawProfile(player.UserId) == profile then self.Game:refresh(player) end
end
function LiveService:purchase(player, payload)
    if self.Data.Ephemeral then return self:notice(player, "Purchases are unavailable in Studio practice mode.") end
    if not validId(payload.Id) then return end
    local entry = if payload.Kind == "Pass" then self.Passes[payload.Id] elseif payload.Kind == "Product" then self.Products[payload.Id] else nil
    if not entry then return end
    local profile = self:rawProfile(player.UserId)
    if not profile then return end
    ensure(profile)
    if LiveService.ownsReward(profile, entry.Reward) then return self:notice(player, "You already own this cosmetic.") end
    local ok = pcall(function()
        if payload.Kind == "Pass" then self.Marketplace:PromptGamePassPurchase(player, payload.Id)
        else self.Marketplace:PromptProductPurchase(player, payload.Id) end
    end)
    if not ok then self:notice(player, "The Roblox purchase prompt is unavailable. Please try later.") end
end
function LiveService:reconcilePasses(player)
    if self.Data.Ephemeral then return end
    local profile = self:rawProfile(player.UserId)
    if not profile then return end
    local awards = {}
    for passId, entry in pairs(self.Passes) do
        local ok, owns = pcall(function() return self.Marketplace:UserOwnsGamePassAsync(player.UserId, passId) end)
        if self:rawProfile(player.UserId) ~= profile then return end
        if ok and owns and not LiveService.ownsReward(profile, entry.Reward) then table.insert(awards, entry.Reward) end
    end
    if #awards &gt; 0 then
        local saved = self:grant(player, function(current)
            for _, reward in ipairs(awards) do LiveService.applyReward(current, reward) end
        end)
        if saved and self:rawProfile(player.UserId) == profile then self.Game:refresh(player) end
    end
end
function LiveService:passPurchased(player, passId, purchased)
    if purchased and self.Passes[passId] then self:reconcilePasses(player) end
end
function LiveService:processReceipt(receipt)
    local retryDecision = Enum.ProductPurchaseDecision.NotProcessedYet
    local grantedDecision = Enum.ProductPurchaseDecision.PurchaseGranted
    if self.Data.Ephemeral or type(receipt) ~= "table" then return retryDecision end
    local entry = self.Products[receipt.ProductId]
    if not entry or type(receipt.PurchaseId) ~= "string" or #receipt.PurchaseId &gt; 200 then return retryDecision end
    local player = self.Players:GetPlayerByUserId(receipt.PlayerId)
    local profile = player and self:rawProfile(player.UserId)
    if not profile then return retryDecision end
    local purchaseId = receipt.PurchaseId
    local saved = self:grant(player, function(current)
        if not current.AppliedReceipts[purchaseId] then
            LiveService.applyReward(current, entry.Reward)
            current.AppliedReceipts[purchaseId] = self.Now()
            -- Every grant is permanent set-membership. Even a much older receipt
            -- safely replays after bounded history retention; no currency is issued.
            local history = {}
            for id, at in pairs(current.AppliedReceipts) do table.insert(history, {Id = id, At = if type(at) == "number" then at else 0}) end
            if #history &gt; LiveConfig.ReceiptHistoryLimit then
                table.sort(history, function(a, b) return a.At &lt; b.At end)
                for i = 1, #history - LiveConfig.ReceiptHistoryLimit do current.AppliedReceipts[history[i].Id] = nil end
            end
        end
    end)
    if not saved then return retryDecision end
    if self:rawProfile(player.UserId) == profile then self.Game:refresh(player); self:notice(player, "Your cosmetic is ready. Thank you for supporting Thrift Flip!") end
    return grantedDecision
end
function LiveService:loadProductInfo()
    for kind, entries in pairs({Pass = self.Passes, Product = self.Products}) do
        for id in pairs(entries) do
            local ok, info = pcall(function()
                return self.Marketplace:GetProductInfo(id, if kind == "Pass" then Enum.InfoType.GamePass else Enum.InfoType.Product)
            end)
            if ok and type(info) == "table" then self.ProductInfo[kind .. ":" .. id] = {Price = info.PriceInRobux, ForSale = info.IsForSale} end
        end
    end
end
function LiveService:snapshot(player)
    local profile = self:rawProfile(player.UserId)
    if not profile then return nil end
    local now = self.Now(); local week = LiveService.week(now)
    local neighborhood = LiveService.neighborhood(player.UserId)
    local key = self:key(week, neighborhood)
    local cached = self.Cache[key]
    local record = if cached then cached.Record else self:emptyRecord(week, neighborhood)
    local entries = {}
    for _, entry in pairs(record.Entries) do table.insert(entries, copy(entry)) end
    table.sort(entries, function(a, b)
        if a.Votes ~= b.Votes then return a.Votes &gt; b.Votes end
        return a.UserId &lt; b.UserId
    end)
    local previous = self.Cache[self:key(week - 1, neighborhood)]
    local live = ensure(profile)
    local events = {}
    for _, event in ipairs(LiveService.activeEvents(now)) do
        local progress = live.Events[event.Id] or {}
        table.insert(events, {Id = event.Id, Name = event.Name, Description = event.Description,
            Ends = event.Ends, Goal = copy(event.Goal), Progress = copy(progress), RewardName = event.RewardName,
            Claimed = progress.Claimed == true, Accent = event.Accent})
    end
    local shop = {}
    for kind, definitions in pairs({Pass = self.Passes, Product = self.Products}) do
        for id, definition in pairs(definitions) do
            local info = self.ProductInfo[kind .. ":" .. id]
            if not info or info.ForSale ~= false then
                table.insert(shop, {Kind = kind, Id = id, Name = definition.Name, Description = definition.Description,
                    Owned = LiveService.ownsReward(profile, definition.Reward), Price = info and info.Price})
            end
        end
    end
    table.sort(shop, function(a, b) if a.Kind ~= b.Kind then return a.Kind &lt; b.Kind end; return a.Id &lt; b.Id end)
    return {
        Showcase = {Week = week, Neighborhood = neighborhood, Theme = LiveService.theme(week), Ends = LiveService.weekEnd(week),
            Entries = entries, VotedFor = record.Votes[tostring(player.UserId)], Entered = record.Entries[tostring(player.UserId)] ~= nil,
            Status = if cached then "Ready" else "Loading", Mode = if self.Data.Ephemeral then "Practice" else "Persistent",
            LastWinners = previous and previous.Record.Winners or {}, MaxEntries = LiveConfig.Showcase.MaxEntries},
        Events = events, Shop = shop,
    }
end
function LiveService:handle(player, action, payload)
    if action ~= "Showcase" and action ~= "EventClaim" and action ~= "ShopPurchase" and action ~= "LiveRefresh" then return false end
    local now = self.Now()
    if self.Busy[player.UserId] or now &lt; (self.RequestAt[player.UserId] or 0) then return true end
    self.Busy[player.UserId] = true; self.RequestAt[player.UserId] = now + 1
    local ok, problem = pcall(function()
        if action == "Showcase" then
            if payload.Choice == "Enter" then self:enter(player)
            elseif payload.Choice == "Vote" then self:vote(player, payload)
            elseif payload.Choice == "Claim" then self:claimShowcase(player, false)
            elseif payload.Choice == "Refresh" then self:refresh(player) end
        elseif action == "EventClaim" then self:eventClaim(player, payload)
        elseif action == "ShopPurchase" then self:purchase(player, payload)
        else self:refresh(player) end
    end)
    self.Busy[player.UserId] = nil
    if not ok then warn("Live operation failed: " .. tostring(problem)); self:notice(player, "This service is temporarily unavailable. Your items are safe.") end
    return true
end
function LiveService:join(player)
    local profile = self:rawProfile(player.UserId)
    if not profile then return end
    ensure(profile)
    self:refresh(player)
    if self:rawProfile(player.UserId) ~= profile then return end
    self:reconcilePasses(player)
    if self:rawProfile(player.UserId) ~= profile then return end
    self:claimShowcase(player, true)
end
function LiveService:leave(player)
    self.Busy[player.UserId] = nil; self.RequestAt[player.UserId] = nil
end
function LiveService:tick()
    local now = self.Now()
    if now - self.LastTick &lt; LiveConfig.Showcase.CacheSeconds then return end
    self.LastTick = now
    local groups = {}
    for _, player in ipairs(self.Players:GetPlayers()) do
        if self:rawProfile(player.UserId) then
            local group = LiveService.neighborhood(player.UserId)
            groups[group] = groups[group] or {}; table.insert(groups[group], player)
        end
    end
    for group, players in pairs(groups) do
        task.spawn(function()
            local week = LiveService.week(self.Now())
            self:read(week, group, true)
            for _, player in ipairs(players) do
                if self:rawProfile(player.UserId) and player.Parent then self.Game:snapshot(player) end
            end
        end)
    end
    local week = LiveService.week(now)
    for key, cached in pairs(self.Cache) do
        if cached.Record.Week &lt; week - LiveConfig.Showcase.HistoryWeeks then self.Cache[key] = nil end
    end
end
return LiveService
</ProtectedString>
        </Properties>
