      <Item class="ModuleScript" referent="RBX11">
        <Properties>
          <string name="Name">AssetConfig</string>
          <ProtectedString name="Source">-- Upload assets/audio/*.wav through your experience's Asset Manager, then paste
-- the resulting numeric IDs here. All shipped files are original project assets.
-- Zero deliberately means unconfigured. Do not substitute arbitrary catalog IDs.
return {
    Audio = {
        click = 0, reveal = 0, restore = 0, sale = 0, reward = 0,
        place = 0, auction = 0, error = 0, scrub = 0, polish = 0,
        shop = 0, town = 0, auction_music = 0,
    },
    Images = {Icon = 0, Thumbnail = 0, Logo = 0},
    MusicVolume = 0.22,
    EffectsVolume = 0.45,
}
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX12">
        <Properties>
          <string name="Name">Catalog</string>
          <ProtectedString name="Source">local Catalog = {}
local categories = {
    {"Lamps", "Scrub", 22, {"Tulip", "Banker", "Mushroom", "Arc", "Lantern", "Desk", "Lava", "Tiffany", "Studio", "Moon"}},
    {"Radios", "Rewire", 28, {"Pocket", "Bakelite", "Boombox", "Cathedral", "Transistor", "Space", "Kitchen", "Travel", "Jukebox", "Crystal"}},
    {"Clocks", "Assemble", 25, {"Cuckoo", "Mantel", "Alarm", "Sunburst", "Pendulum", "Flip", "Station", "Carriage", "Orbital", "Kitten"}},
    {"Chairs", "Repaint", 32, {"Rocking", "Windsor", "Tulip", "School", "Lounge", "Bistro", "Velvet", "Rattan", "Rocket", "Doll"}},
    {"Toys", "Assemble", 18, {"Robot", "Train", "Teddy", "Rocket", "Carousel", "Dollhouse", "Racecar", "Duck", "Airplane", "Dinosaur"}},
    {"Mirrors", "Polish", 24, {"Oval", "Sun", "Vanity", "Arch", "Pocket", "Gilded", "Cloud", "Star", "Shell", "Heart"}},
    {"Cameras", "Rewire", 30, {"Box", "Instant", "Twin Lens", "Pocket", "Bellows", "Rangefinder", "Studio", "Movie", "Underwater", "Toy"}},
    {"Vases", "Polish", 20, {"Bud", "Ginger", "Amphora", "Bubble", "Fluted", "Swan", "Geometric", "Rose", "Celadon", "Moon"}},
}
Catalog.Items = {}
Catalog.ById = {}
Catalog.Categories = {}
for categoryIndex, group in ipairs(categories) do
    table.insert(Catalog.Categories, group[1])
    for index, name in ipairs(group[4]) do
        local item = {
            Id = string.lower(group[1]) .. "_" .. index,
            Name = name .. " " .. string.sub(group[1], 1, #group[1] - 1),
            Category = group[1], Minigame = group[2],
            BaseValue = group[3] + index * 4,
            Style = ({"Retro", "Cozy", "Futuristic", "Antique", "Cute"})[(index + categoryIndex - 2) % 5 + 1],
            UnlockLevel = math.max(1, categoryIndex - 2),
            Variant = index,
        }
        table.insert(Catalog.Items, item)
        Catalog.ById[item.Id] = item
    end
end
return Catalog
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX13">
        <Properties>
          <string name="Name">Config</string>
          <ProtectedString name="Source">-- Central tuning. No paid power or randomized Robux purchases.
local Config = {
    Version = 2,
    StudioPracticeMode = true, -- Studio only; never disables live-server persistence.
    StartingCash = 75,
    InventoryLimit = 100,
    -- The town has eight claimable storefronts. Keep the server cap aligned so
    -- every player always receives a shop.
    MaxPlayers = 8,
    -- UserIds are preferred for permanent live admins. Usernames are matched
    -- against Roblox-authenticated Player.Name values and are case-insensitive.
    AdminUserIds = {},
    AdminUsernames = {"TheKaiju015"},
    AutosaveSeconds = 60,
    SessionLease = 180,
    Sources = {
        Dumpster = {Cost = 0, Level = 1, Cooldown = 15, Weights = {70, 24, 5, 0.9, 0.1}},
        Estate = {Cost = 90, Level = 3, Cooldown = 8, Weights = {30, 42, 22, 5, 1}},
        Delivery = {Cost = 0, Level = 1, Cooldown = 0, Weights = {35, 40, 20, 4, 1}},
    },
    Rarities = {"Common", "Uncommon", "Rare", "Epic", "Legendary"},
    RarityIcons = {"○", "◇", "△", "✦", "★"},
    RarityColors = {"#AEB7B5", "#70C58D", "#6CABF3", "#C29AE8", "#EDC66D"},
    RarityEffectNames = {"Found", "Fresh", "Shimmer", "Enchanted", "Golden Legend"},
    RarityMultipliers = {1, 1.8, 3.5, 7, 15},
    Conditions = {"Wrecked", "Poor", "Fair", "Good", "Mint"},
    ConditionMultipliers = {0.25, 0.5, 0.85, 1.3, 2},
    Styles = {"Retro", "Cozy", "Futuristic", "Antique", "Cute"},
    Tiers = {
        {Name = "Corner Stall", Cost = 0, Slots = 4, Level = 1},
        {Name = "Small Shop", Cost = 600, Slots = 8, Level = 4},
        {Name = "Boutique", Cost = 4000, Slots = 12, Level = 9},
        {Name = "Department Store", Cost = 18000, Slots = 16, Level = 16},
    },
    ToolCosts = {150, 650, 2500},
    CustomerSeconds = 18,
    AuctionInterval = 240,
    AuctionDuration = 45,
    -- Same-server listings and trades use a durable recovery journal.
    EnablePlayerMarket = true,
    EnableTrading = true,
    Decorations = {
        {Id = "Rug", Name = "Woven welcome rug", Cost = 120},
        {Id = "Plant", Name = "Happy houseplants", Cost = 180},
        {Id = "Poster", Name = "Second chances poster", Cost = 90},
        {Id = "Neon", Name = "Good finds neon sign", Cost = 400},
        {Id = "Curtains", Name = "Rose linen curtains", Cost = 240},
        {Id = "Trophy", Name = "Golden treasure sculpture", Cost = 1200},
    },
    CosmeticPasses = {}, -- [Roblox game-pass id] = cosmetic theme key; no placeholder IDs
    Themes = {
        {Id = "Cozy", Name = "Cozy Corner", Cost = 0, Color = {0.56, 0.75, 0.68}},
        {Id = "Retro", Name = "Retro Revival", Cost = 350, Color = {0.83, 0.57, 0.47}},
        {Id = "Futuristic", Name = "Neon Tomorrow", Cost = 600, Color = {0.43, 0.56, 0.76}},
        {Id = "Antique", Name = "Antique Attic", Cost = 900, Color = {0.69, 0.56, 0.36}},
        {Id = "Cute", Name = "Rose Cottage", Cost = 450, Color = {0.85, 0.61, 0.70}},
    },
}
return Config
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX14">
        <Properties>
          <string name="Name">DecorPlacement</string>
          <ProtectedString name="Source">-- Pure placement geometry used by the server and optional client previews.
local Placement = {}
Placement.Bounds = {MinX = -12, MaxX = 12, MinZ = -12, MaxZ = 9}
Placement.Footprints = {Rug = {X = 14, Z = 11, Flat = true}, Plant = {X = 2.4, Z = 2.4}, Trophy = {X = 2.6, Z = 2.6}}
Placement.Defaults = {Rug = {X = 0, Z = -1, Rotation = 0}, Plant = {X = -10, Z = -9, Rotation = 0}, Trophy = {X = 0, Z = 7, Rotation = 0}}
local function finite(value) return type(value) == "number" and value == value and math.abs(value) &lt; math.huge end
local function extent(footprint, rotation)
    if rotation == 90 or rotation == 270 then return footprint.Z / 2, footprint.X / 2 end
    return footprint.X / 2, footprint.Z / 2
end
local function overlap(a, ax, az, b, bx, bz)
    return math.abs(a.X - b.X) &lt; ax + bx - 0.05 and math.abs(a.Z - b.Z) &lt; az + bz - 0.05
end
function Placement.validate(id, proposed, layout, placed, slots)
    local footprint = Placement.Footprints[id]
    if not footprint then return false, "This decoration stays on its wall mount." end
    if type(proposed) ~= "table" or not finite(proposed.X) or not finite(proposed.Z) or not finite(proposed.Rotation) then return false, "Choose a position inside your shop." end
    if not table.find({0, 90, 180, 270}, proposed.Rotation) then return false, "Rotate in quarter turns." end
    local hx, hz = extent(footprint, proposed.Rotation)
    local bounds = Placement.Bounds
    if proposed.X - hx &lt; bounds.MinX or proposed.X + hx &gt; bounds.MaxX or proposed.Z - hz &lt; bounds.MinZ or proposed.Z + hz &gt; bounds.MaxZ then return false, "Keep the whole decoration inside the floor plan." end
    if not footprint.Flat then
        for slot = 1, math.min(slots, 8) do
            local index = (slot - 1) % 4
            local x = (if index % 2 == 0 then -1 else 1) * (if slot &lt;= 4 then 5 else 10.7)
            local z = if index &lt; 2 then (if slot &lt;= 4 then 0.5 else -0.5) else 6
            local hxDisplay = if slot &lt;= 4 then 2.2 else 1.15
            if overlap(proposed, hx, hz, {X = x, Z = z}, hxDisplay, 1.8) then return false, "Leave room around the display furniture." end
        end
        -- Service counter; workbench is behind the editable area.
        if overlap(proposed, hx, hz, {X = 8, Z = -9}, 3.25, 1.75) then return false, "Keep the counter clear." end
        for other, otherFootprint in pairs(Placement.Footprints) do
            if other ~= id and not otherFootprint.Flat and placed[other] then
                local position = layout[other] or Placement.Defaults[other]
                local ox, oz = extent(otherFootprint, position.Rotation)
                if overlap(proposed, hx, hz, position, ox, oz) then return false, "That overlaps another decoration." end
            end
        end
    end
    return true, {X = math.round(proposed.X * 2) / 2, Z = math.round(proposed.Z * 2) / 2, Rotation = proposed.Rotation}
end
return Placement
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX15">
        <Properties>
          <string name="Name">Economy</string>
          <ProtectedString name="Source">local Economy = {}
function Economy.level(xp)
    return math.floor(math.sqrt(math.max(0, xp) / 30)) + 1
end
function Economy.value(definition, item, rarityMultipliers, conditionMultipliers, demand, bonus)
    return math.max(1, math.floor(definition.BaseValue * rarityMultipliers[item.Rarity]
        * conditionMultipliers[item.Condition] * item.Variance * (demand or 1) * (bonus or 1)))
end
function Economy.pick(weights, randomUnit)
    local total = 0
    for _, weight in ipairs(weights) do total += weight end
    local point = math.clamp(randomUnit, 0, 0.999999999) * total
    for index, weight in ipairs(weights) do
        point -= weight
        if point &lt; 0 then return index end
    end
    return #weights
end
function Economy.daily(now) return math.floor(now / 86400) end
function Economy.week(now) return math.floor((now + 3 * 86400) / (7 * 86400)) end
function Economy.restore(condition, score, tool)
    local gain = if score &gt;= 0.8 then 2 else 1
    if tool &gt;= 3 and score &gt;= 0.6 then gain += 1 end
    return math.min(5, condition + gain)
end
function Economy.validAmount(value, minimum, maximum)
    return type(value) == "number" and value == value and value % 1 == 0
        and value &gt;= minimum and value &lt;= maximum
end
return Economy
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX16">
        <Properties>
          <string name="Name">ExchangeRules</string>
          <ProtectedString name="Source">-- Pure transfer invariants, shared with the headless fault-injection suite.
local ExchangeRules = {}
local function copy(value)
    if type(value) ~= "table" then return value end
    local out = {}; for key, child in pairs(value) do out[key] = copy(child) end
    return out
end
ExchangeRules.copy = copy
function ExchangeRules.ensure(profile)
    profile.Exchange = profile.Exchange or {Pending = nil, LastApplied = nil}
    return profile.Exchange
end
function ExchangeRules.find(profile, uid)
    for index, item in ipairs(profile.Inventory) do if item.Uid == uid then return item, index end end
    return nil
end
function ExchangeRules.apply(profile, transaction, side, capacity)
    local exchange = ExchangeRules.ensure(profile)
    if exchange.LastApplied == transaction.Id then return true, false end
    if exchange.Pending ~= transaction.Id then return false, "Missing durable preparation marker" end
    if profile.Cash + side.CashDelta &lt; 0 then return false, "Insufficient cash during recovery" end
    local outgoing = {}
    for _, uid in ipairs(side.Outgoing) do
        if outgoing[uid] or not ExchangeRules.find(profile, uid) then return false, "Outgoing item missing or duplicated" end
        outgoing[uid] = true
    end
    if #profile.Inventory - #side.Outgoing + #side.Incoming &gt; capacity then return false, "Recovery inventory capacity exceeded" end
    local incoming = {}
    for _, item in ipairs(side.Incoming) do
        if incoming[item.Uid] or (ExchangeRules.find(profile, item.Uid) and not outgoing[item.Uid]) then
            return false, "Incoming item already exists without a receipt"
        end
        incoming[item.Uid] = true
    end
    -- All assertions precede mutation. Caller holds the session's mutation lock.
    for index = #profile.Inventory, 1, -1 do
        if outgoing[profile.Inventory[index].Uid] then table.remove(profile.Inventory, index) end
    end
    for _, original in ipairs(side.Incoming) do
        local item = copy(original); item.Slot = nil
        table.insert(profile.Inventory, item)
        if item.Inspected then profile.Collection[item.DefId .. ":" .. item.Rarity] = true end
    end
    profile.Cash += side.CashDelta
    exchange.LastApplied = transaction.Id
    return true, true
end
function ExchangeRules.side(transaction, userId)
    for _, side in ipairs(transaction.Sides) do if side.UserId == userId then return side end end
    return nil
end
function ExchangeRules.allAcknowledged(transaction)
    for _, side in ipairs(transaction.Sides) do
        if not transaction.Acks[tostring(side.UserId)] then return false end
    end
    return true
end
return ExchangeRules
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX17">
        <Properties>
          <string name="Name">ItemModels</string>
          <ProtectedString name="Source">-- Original Thrift Flip model library. No catalog meshes or externally owned assets.
-- describe() is pure data so the same authored assets can be exported or previewed.
-- Model origin: bottom-center; presentation/front: -Z. All parts are anchored.
local ItemModels = {}
local pi = math.pi
local palette = {
    Cream = {0.96, 0.89, 0.73}, Ivory = {0.98, 0.96, 0.87},
    Teal = {0.28, 0.58, 0.54}, Mint = {0.58, 0.77, 0.65},
    Coral = {0.84, 0.43, 0.34}, Rose = {0.80, 0.51, 0.57},
    Mustard = {0.89, 0.67, 0.27}, Gold = {0.74, 0.55, 0.25},
    Brass = {0.60, 0.43, 0.23}, Copper = {0.68, 0.36, 0.24},
    Walnut = {0.29, 0.17, 0.11}, Wood = {0.57, 0.36, 0.20},
    Dark = {0.13, 0.18, 0.19}, Black = {0.075, 0.10, 0.11},
    Silver = {0.64, 0.70, 0.69}, Blue = {0.28, 0.48, 0.65},
    Lilac = {0.61, 0.49, 0.73}, Glass = {0.62, 0.82, 0.83},
    Dirt = {0.39, 0.34, 0.24}, White = {0.96, 0.96, 0.92},
}
local styleColors = {Retro = "Coral", Cozy = "Mint", Futuristic = "Blue", Antique = "Wood", Cute = "Rose"}
local function clone3(value) return {value[1], value[2], value[3]} end
local function blend(a, b, t)
    return {a[1] + (b[1] - a[1]) * t, a[2] + (b[2] - a[2]) * t, a[3] + (b[3] - a[3]) * t}
end
local function builder(definition, item)
    local parts = {}
    local theme = palette[styleColors[item.Style or definition.Style] or "Teal"]
    local condition = math.clamp(item.Condition or 5, 1, 5)
    local wear = (5 - condition) * 0.075
    local function p(name, size, pos, color, shape, rotation, material, transparency)
        local original = if type(color) == "table" then color else palette[color or "Cream"]
        local entry = {Name = name, Class = "Part", Size = clone3(size), Position = clone3(pos),
            Color = blend(original, palette.Dirt, wear), Shape = shape or "Block",
            Rotation = rotation or {0, 0, 0}, Material = material or "SmoothPlastic",
            Transparency = transparency or 0, Reflectance = 0}
        table.insert(parts, entry)
        return entry
    end
    local function box(name, size, pos, color, rot, mat)
        return p(name, size, pos, color, "Block", rot, mat)
    end
    local function ball(name, size, pos, color, mat)
        return p(name, size, pos, color, "Ball", nil, mat)
    end
    local function cyl(name, diameter, height, pos, color, mat)
        return p(name, {height, diameter, diameter}, pos, color, "Cylinder", {0, 0, pi / 2}, mat)
    end
    local function disc(name, diameter, depth, pos, color, mat)
        return p(name, {depth, diameter, diameter}, pos, color, "Cylinder", {0, pi / 2, 0}, mat)
    end
    local function wedge(name, size, pos, color, rot)
        local part = box(name, size, pos, color, rot); part.Class = "WedgePart"; part.Shape = nil; return part
    end
    local function rod(name, a, b, thickness, color, mat)
        local dx, dy, dz = b[1] - a[1], b[2] - a[2], b[3] - a[3]
        local len = math.sqrt(dx * dx + dy * dy + dz * dz)
        return box(name, {thickness, len, thickness}, {(a[1] + b[1]) / 2, (a[2] + b[2]) / 2, (a[3] + b[3]) / 2}, color,
            {math.atan2(dz, dy), 0, -math.atan2(dx, math.sqrt(dy * dy + dz * dz))}, mat)
    end
    local function face(name, width, height, depth, pos, color)
        box(name, {width, height, depth}, pos, color)
        for side = -1, 1, 2 do
            ball(name .. "Corner", {height, height, depth}, {pos[1] + side * width / 2, pos[2], pos[3]}, color)
        end
    end
    local function knobs(y, z, count, spacing, color)
        for i = 1, count do disc("Knob", 0.19, 0.11, {(i - (count + 1) / 2) * spacing, y, z}, color or "Gold", "Metal") end
    end
    local function feet(width, depth, y, height, color)
        for x = -1, 1, 2 do for z = -1, 1, 2 do
            box("Foot", {0.18, height, 0.18}, {x * width / 2, y, z * depth / 2}, color or "Walnut")
        end end
    end
    return parts, {p = p, box = box, ball = ball, cyl = cyl, disc = disc, wedge = wedge, rod = rod,
        face = face, knobs = knobs, feet = feet, Theme = theme, Variant = definition.Variant or 1, Condition = condition}
end
local function lamps(g)
    local v, tint = g.Variant, g.Theme
    if v == 1 then -- Tulip: curved stalk and five cupped glass petals.
        g.cyl("Pedestal", 1.35, 0.18, {0, 0.09, 0}, "Brass", "Metal")
        g.rod("Stem", {0, 0.18, 0}, {0.18, 2.15, 0}, 0.14, "Gold", "Metal")
        g.ball("WarmBulb", {0.58, 0.72, 0.58}, {0.18, 2.17, 0}, "Cream", "Neon")
        for i = 1, 5 do
            local a = i * 2 * pi / 5
            local petal = g.ball("TulipPetal", {0.55, 1.05, 0.38}, {0.18 + math.cos(a) * 0.38, 2.3, math.sin(a) * 0.38}, tint)
            petal.Rotation = {0, -a, 0.2}; petal.Transparency = 0.12
        end
        g.ball("Leaf", {0.7, 0.16, 0.3}, {-0.22, 1.3, 0}, "Mint").Rotation = {0, 0, -0.5}
    elseif v == 2 then -- Brass banker desk lamp.
        g.cyl("WeightedFoot", 1.55, 0.2, {0, 0.1, 0}, "Brass", "Metal")
        g.cyl("FootInset", 1.1, 0.08, {0, 0.24, 0}, "Gold", "Metal")
        g.rod("CurvedNeck", {0, 0.25, 0.2}, {0, 1.95, 0.2}, 0.18, "Brass", "Metal")
        g.rod("ShadeSupport", {-0.65, 1.9, 0.2}, {0.65, 1.9, 0.2}, 0.14, "Brass", "Metal")
        g.ball("EmeraldShade", {2.1, 0.75, 1.05}, {0, 2.05, -0.14}, "Teal")
        g.box("CreamDiffuser", {1.72, 0.12, 0.82}, {0, 1.79, -0.14}, "Cream", nil, "Neon")
        g.rod("PullChain", {0.72, 1.8, -0.25}, {0.72, 1.16, -0.25}, 0.035, "Gold", "Metal")
        g.ball("ChainBead", {0.13, 0.13, 0.13}, {0.72, 1.1, -0.25}, "Gold", "Metal")
    elseif v == 3 then
        g.cyl("SoftFoot", 1.1, 0.15, {0, 0.075, 0}, "Ivory")
        g.ball("MushroomStem", {0.68, 1.75, 0.68}, {0, 0.95, 0}, "Ivory")
        g.ball("MushroomCap", {2.35, 1.02, 2.35}, {0, 1.9, 0}, tint)
        g.cyl("CapRim", 2.1, 0.09, {0, 1.59, 0}, "Cream")
        for i = 1, 5 do
            local a = i * 2 * pi / 5
            g.ball("GlazedSpot", {0.28, 0.05, 0.28}, {math.cos(a) * 0.6, 2.37, math.sin(a) * 0.6}, "Ivory")
        end
    elseif v == 4 then
        g.cyl("StoneBase", 1.5, 0.25, {-0.4, 0.125, 0}, "Dark", "Marble")
        g.rod("ArcStem", {-0.4, 0.2, 0}, {-0.4, 2.7, 0}, 0.12, "Silver", "Metal")
        g.rod("ArcShoulder", {-0.4, 2.7, 0}, {0.6, 3.25, 0}, 0.12, "Silver", "Metal")
        g.rod("ArcTip", {0.6, 3.25, 0}, {1.1, 2.8, 0}, 0.12, "Silver", "Metal")
        g.ball("SteelShade", {1.15, 0.65, 1.15}, {1.08, 2.65, 0}, tint)
        g.cyl("WarmUnderside", 0.85, 0.08, {1.08, 2.41, 0}, "Cream", "Neon")
    elseif v == 5 then
        g.cyl("LanternBase", 1.35, 0.25, {0, 0.125, 0}, "Dark", "Metal")
        g.cyl("GlassChamber", 0.95, 1.55, {0, 1, 0}, "Cream", "Glass").Transparency = 0.35
        g.cyl("Candle", 0.25, 0.65, {0, 0.65, 0}, "Ivory")
        g.ball("Flame", {0.16, 0.35, 0.16}, {0, 1.1, 0}, "Mustard", "Neon")
        for x = -1, 1, 2 do for z = -1, 1, 2 do
            g.box("LanternFrame", {0.09, 1.7, 0.09}, {x * 0.45, 1.1, z * 0.45}, "Dark", nil, "Metal")
        end end
        g.cyl("LanternRoof", 1.5, 0.18, {0, 1.95, 0}, "Dark", "Metal")
        g.ball("RoofCap", {0.85, 0.48, 0.85}, {0, 2.13, 0}, "Dark")
        g.rod("HandleL", {-0.4, 2.2, 0}, {-0.4, 2.65, 0}, 0.1, "Brass")
        g.rod("HandleR", {0.4, 2.2, 0}, {0.4, 2.65, 0}, 0.1, "Brass")
        g.rod("CarryHandle", {-0.4, 2.65, 0}, {0.4, 2.65, 0}, 0.1, "Brass")
    elseif v == 6 then
        g.cyl("DeskBase", 1.4, 0.17, {0, 0.085, 0}, tint)
