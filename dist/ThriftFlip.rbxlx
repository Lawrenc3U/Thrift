        g.box("Mullion", {0.06, 2.6, 0.07}, {0, 1.6, -0.23}, "Dark")
    elseif v == 5 then
        g.disc("PocketCompact", 1.55, 0.2, {0, 1.35, 0}, "Rose")
        mirrorInset(g, 0, 1.35, -0.14, 1.3, 1.3, "Oval")
